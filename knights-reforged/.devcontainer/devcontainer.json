{
  "name": "Kingdom Come — private development realm",
  "dockerComposeFile": "compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/test",
  "remoteUser": "node",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Kingdom Come — keep PRIVATE",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "cd knights-reforged && node deployment/setup-development.mjs"
}
