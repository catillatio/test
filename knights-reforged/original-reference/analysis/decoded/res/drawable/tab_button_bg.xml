<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <shape android:shape="0">
      <corners android:radius="5dp" />
      <solid android:color="#e17f7f7f" />
      <gradient android:startColor="#e1404040" android:endColor="#e17f7f7f" android:angle="90.0" />
    </shape>
  </item>
  <item android:state_pressed="true">
    <shape android:shape="0">
      <corners android:radius="5dp" />
      <gradient android:startColor="#e1647f00" android:endColor="#e164b400" android:angle="90.0" />
    </shape>
  </item>
  <item>
    <shape android:shape="0">
      <corners android:radius="5dp" />
      <solid android:color="#00000000" />
    </shape>
  </item>
</selector>
