# Allowlist the production build context. Research APKs, backups, .env files,
# screenshots, development helpers and local dependencies never reach a build.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**
!views/
!views/**
!public/
!public/**
!rulesets/
!rulesets/**
!migrations/
!migrations/**
!deployment/
!deployment/start.mjs
!deployment/migrate.mjs
!deployment/environment.mjs
!deployment/status.mjs

!deployment/grant-gray.mjs
!deployment/check-upgrade.mjs
!deployment/moderate.mjs

!deployment/audit-bots.mjs
!deployment/release/
!deployment/release/*.mjs
!deployment/release/Dockerfile

# Explicit non-destructive metadata helpers only; cleanup/bootstrap/keys excluded.
!deployment/release/retention/
!deployment/release/retention/observation.mjs
!deployment/release/retention/observations.sql
!deployment/release/retention/register-verified.mjs
