NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://knights:knights_local@127.0.0.1:54329/knights
# Enable only after creating the disposable test database:
# TEST_DATABASE_URL=postgres://knights:knights_local@127.0.0.1:54329/knights_test

# Optional passive alpha rivals. Never active in production.
ENABLE_DEV_BOTS=0
# Separately opt into immediate development-rival army recruitment.
ENABLE_DEV_BOT_RECRUITMENT=0
# Separately opt into player-funded bounties on these rivals in development.
ENABLE_DEV_BOT_BOUNTIES=0
# Provision/upgrade explicitly with ALLOW_DEV_PROVISIONING=1 npm run dev:bots.
