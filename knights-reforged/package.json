{
  "name": "knights-reforged-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "check:static": "node scripts/check-project.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-demo": "tsx scripts/seed.ts --reset-demo",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "test:land:offline": "node --experimental-transform-types --import ./scripts/register-typescript.mjs tests/land-rules.test.ts",
    "test:land:client": "node tests/land-client.test.mjs",
    "test:postgres": "TEST_ENGINE=postgres tsx --test --test-concurrency=1 tests/integration.test.ts tests/alpha-integration.test.ts tests/migration.test.ts tests/profile-economy.test.ts tests/fantasy-integration.test.ts tests/phase35-migration.test.ts tests/level50-playthrough.test.ts",
    "test:browser": "tsx scripts/browser-test.ts",
    "test:browser:fantasy": "tsx scripts/browser-fantasy-test.ts",
    "test:restart": "tsx scripts/test-restart.ts",
    "test:codespaces": "tsx scripts/test-codespaces.ts",
    "balance:report": "tsx scripts/balance-report.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/view": "^11.1.1",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "playwright-core": "^1.56.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
