<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#151310">
  <meta name="description" content="Raise an army, take on quests, and challenge other warriors in Kingdom Come.">
  <title><%= title %> · Kingdom Come</title>
  <link rel="icon" type="image/png" href="/assets/art/kingdoms-live/icon.png">
  <link rel="stylesheet" href="/assets/styles.css">
  <link rel="stylesheet" href="/assets/kingdoms-live.css">
  <link rel="stylesheet" href="/assets/alpha.css">
  <link rel="stylesheet" href="/assets/refinements.css?v=<%= alpha.id %>">
  <link rel="stylesheet" href="/assets/strategy.css?v=strategy-0.2">
  <link rel="stylesheet" href="/assets/community.css?v=community-0.1">
  <!-- Use the established layout context and a UI revision, not page-specific rules locals. -->
  <link rel="stylesheet" href="/assets/phase41.css?v=<%= alpha.id %>-phase41-render1">
  <link rel="stylesheet" href="/assets/phase42.css?v=phase42-1">
<link rel="stylesheet" href="/assets/phase43.css?v=phase43-1">
</head>
<body class="kingdoms-ui <%= state ? 'signed-in' : 'signed-out' %> screen-<%= ['report','bounties','bounty-confirm','bounty-new'].includes(screen) ? 'battle' : screen %>">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="app-shell">
    <div class="page-backdrop" aria-hidden="true"></div>
    <div class="page-column">
      <%- include('partials/realm-header') %>
      <main id="main-content" class="main-content" tabindex="-1">
        <% if (state) { %>
          <header class="character-header">
            <%- include('partials/resources') %>
            <div class="page-heading"><h1><%= title %></h1><a class="warrior-label" href="/game/profile"><%= state.name %> ›</a></div>
          </header>
          <%- include('partials/secondary-nav') %>
        <% } %>
        <% if (notice && !(screen==='quests'&&actionResult?.kind==='quest')) { %><div class="notice notice-success" role="status"><span aria-hidden="true">✦</span> <%= notice %></div><% } %>
        <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
        <%- include(screen) %>
        <p class="connection-status" data-connection-status role="status"></p>
        <footer class="page-footer"><span>Kingdom Come · Multiplayer alpha</span><a href="/rules">Alpha rules</a></footer>
      </main>
    </div>
    <% if (state) { %><%- include('partials/primary-nav') %><% } %>
  </div>
  <% if (state) { %><script type="module" src="/assets/community.js?v=<%= alpha.id %>-phase41-render1"></script><script type="module" src="/assets/realm.js?v=<%= alpha.id %>-phase41-render1"></script><% } %>
<% if(state) { %><script type="module" src="/assets/shopping.js?v=phase43-1"></script><% } %>
</body>
</html>
