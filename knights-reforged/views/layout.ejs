<% const soundConfig=typeof sound==='undefined'?{enabled:false,volume:55}:sound;const soundResult=typeof soundEvent==='undefined'?null:soundEvent; %><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#151310">
  <meta name="description" content="Raise an army, take on quests, and challenge other warriors in Kingdom Come.">
  <title><%= title %> · Kingdom Come</title>
  <link rel="icon" type="image/svg+xml" href="/assets/art/remaster-ui/crest.svg?v=phase48-mockup2">
  <link rel="stylesheet" href="/assets/styles.css">
  <link rel="stylesheet" href="/assets/kingdoms-live.css?v=phase48-mockup2">
  <link rel="stylesheet" href="/assets/alpha.css?v=phase48-mockup2">
  <link rel="stylesheet" href="/assets/refinements.css?v=<%= alpha.id %>">
  <link rel="stylesheet" href="/assets/strategy.css?v=strategy-0.2">
  <link rel="stylesheet" href="/assets/community.css?v=community-0.1">
  <!-- Use the established layout context and a UI revision, not page-specific rules locals. -->
  <link rel="stylesheet" href="/assets/phase41.css?v=<%= alpha.id %>-phase41-render1-phase48-mockup2">
  <link rel="stylesheet" href="/assets/phase42.css?v=phase42-1">
<link rel="stylesheet" href="/assets/phase43.css?v=phase43-1">
<link rel="stylesheet" href="/assets/phase44.css?v=phase44-1">
  <link rel="stylesheet" href="/assets/phase45.css?v=phase45-1">
  <link rel="stylesheet" href="/assets/phase46.css?v=phase46-1">
  <link rel="stylesheet" href="/assets/phase47.css?v=phase47-1">
  <link rel="stylesheet" href="/assets/remaster.css?v=phase48-mockup2">
  <% if(screen==='land') { %><link rel="stylesheet" href="/assets/land-review.css?v=phase48-land3"><% } %>
</head>
<body data-sound-enabled="<%= soundConfig.enabled?'1':'0' %>" data-sound-volume="<%= soundConfig.volume %>" data-sound-event="<%= JSON.stringify(soundResult) %>" class="kingdoms-ui <%= state ? 'signed-in' : 'signed-out' %> screen-<%= ['report','bounties','bounty-confirm','bounty-new','champions'].includes(screen) ? 'battle' : screen %>">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="app-shell">
    <div class="page-backdrop" aria-hidden="true"></div>
    <div class="page-column">
      <%- include('partials/realm-header') %>
      <main id="main-content" class="main-content" tabindex="-1">
        <% if (state) { %>
          <header class="character-header">
            <%- include('partials/resources') %>
            <div class="page-heading<%= ['home','quests','battle','armory','army','purchase','profile','settings','report','tutorial'].includes(screen)?' visually-hidden-heading':'' %>"><h1><%= title %></h1></div>
          </header>
          <%- include('partials/tutorial') %>
          <% if(screen!=='tutorial'&&(actionResult?.data?.tutorialCompleted||battle?.playerExperience?.[state.id]?.tutorialCompleted)) { %><aside class="tutorial-success-note" role="status"><strong>TUTORIAL COMPLETE!</strong> You're ready to build your kingdom. <a class="text-link" href="/game/tutorial">Continue Playing ›</a></aside><% } %>
        <% } %>
        <% if (notice && !(screen==='quests'&&actionResult?.kind==='quest')) { %><div class="notice notice-success" role="status"><span aria-hidden="true">✦</span> <%= notice %></div><% } %>
        <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
        <%- include(screen) %>
        <p class="action-feedback" data-action-feedback role="status" aria-live="polite"></p>
        <p class="connection-status" data-connection-status role="status" aria-live="polite"></p>
        <footer class="page-footer"><span>Kingdom Come · Multiplayer alpha</span><a href="/rules">Alpha rules</a></footer>
      </main>
    </div>
    <% if (state) { %><%- include('partials/primary-nav') %><% } %>
  </div>
  <% if (state) { %><script type="module" src="/assets/community.js?v=<%= alpha.id %>-phase45-1"></script><script type="module" src="/assets/realm.js?v=<%= alpha.id %>-phase47-1"></script><% } %>
<% if(state) { %><script type="module" src="/assets/shopping.js?v=phase47-1"></script><% } %>
<% if(state) { %><script type="module" src="/assets/experience.js?v=phase45-1"></script><% } %>
<% if(state) { %><script type="module" src="/assets/status.js?v=phase45-1"></script><% } %>
<script type="module" src="/assets/sound.js?v=phase47-1"></script>
<% if(state) { %><script type="module" src="/assets/market.js?v=phase48-mockup2"></script><% } %>
</body>
</html>
