<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#151b1e">
  <meta name="description" content="Raise an army, take on quests, and challenge other warriors in Knights Reforged.">
  <title><%= title %> · Knights Reforged</title>
  <link rel="icon" type="image/png" href="/assets/art/crest.png">
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body class="<%= state ? 'signed-in' : 'signed-out' %>">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="<%= state ? '/game/home' : '/login' %>" aria-label="Knights Reforged home">
        <img src="/assets/art/crest.png" width="48" height="48" alt="">
        <span>KNIGHTS<strong>REFORGED</strong></span>
      </a>
      <% if (state) { %>
        <p class="nav-heading">YOUR KINGDOM</p>
        <nav class="primary-nav" aria-label="Primary navigation">
          <% for (const item of nav) { const current = item.id === screen || (screen === 'report' && item.id === 'battle'); %>
            <a href="/game/<%= item.id %>" class="nav-link<%= current ? ' is-current' : '' %>"<% if (current) { %> aria-current="page"<% } %>>
              <img src="/assets/art/tab-<%= item.icon %>.png" width="36" height="36" alt="">
              <span><%= item.label %></span>
            </a>
          <% } %>
        </nav>
        <div class="sidebar-bottom">
          <div class="realm-mark"><span class="realm-dot" aria-hidden="true"></span>The First Realm</div>
          <p>Your banner. Your story.</p>
          <a href="/rules">Realm rules <span aria-hidden="true">↗</span></a>
        </div>
      <% } else { %>
        <div class="sidebar-story">
          <span class="ornament" aria-hidden="true">✦</span>
          <h2>A kingdom<br>worth returning to.</h2>
          <p>Take the old road. Gather your company. Let a new legend begin.</p>
        </div>
        <div class="sidebar-bottom"><a href="/rules">Read the realm rules</a></div>
      <% } %>
    </aside>
    <div class="page-column">
      <header class="topbar">
        <a class="mobile-brand" href="<%= state ? '/game/home' : '/login' %>">
          <img src="/assets/art/crest.png" width="30" height="30" alt=""> <span>Knights Reforged</span>
        </a>
        <span class="topbar-realm">THE FIRST REALM <span class="small-tag">0.1</span></span>
        <div class="account-menu">
          <% if (state) { %>
            <span class="account-name"><%= accountName %></span>
            <form method="post" action="/logout">
              <input type="hidden" name="csrf" value="<%= csrf %>">
              <button class="button-quiet" type="submit">Sign out</button>
            </form>
          <% } else { %>
            <a class="text-link" href="/rules">Realm rules</a>
          <% } %>
        </div>
      </header>
      <main id="main-content" class="main-content" tabindex="-1">
        <% if (state) { %>
          <div class="page-heading"><div><p class="eyebrow">KNIGHTS REFORGED</p><h1><%= title %></h1></div><span class="warrior-label"><%= state.name %></span></div>
          <%- include('partials/resources') %>
        <% } %>
        <% if (notice) { %><div class="notice notice-success" role="status"><span aria-hidden="true">✦</span> <%= notice %></div><% } %>
        <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
        <%- include(screen) %>
        <footer class="page-footer"><span>Knights Reforged · The First Realm</span><a href="/rules">Provisional realm rules</a></footer>
      </main>
    </div>
  </div>
</body>
</html>
