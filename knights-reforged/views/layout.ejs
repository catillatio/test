<% const soundConfig=typeof sound==='undefined'?{enabled:false,volume:55}:sound;const soundResult=typeof soundEvent==='undefined'?null:soundEvent; %><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#151310">
  <meta name="description" content="Raise an army, take on quests, and challenge other warriors in Kingdoms Restored.">
  <title><%= title %> · Kingdoms Restored</title>
  <link rel="icon" type="image/svg+xml" href="/assets/art/remaster-ui/crest.svg?v=phase48-mockup2">
  <% const themedRealm=typeof uiTheme==='undefined'||uiTheme; if(themedRealm) { %>
  <link rel="stylesheet" href="/assets/realm-iron-brass.css?v=dark-medieval-complete-1">
  <% } else { %>
  <link rel="stylesheet" href="/assets/styles.css?palette=charcoal-2">
  <link rel="stylesheet" href="/assets/kingdoms-live.css?v=phase48-mockup2&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/alpha.css?v=phase48-mockup2&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/refinements.css?v=<%= alpha.id %>&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/strategy.css?v=strategy-0.2&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/community.css?v=community-0.1&palette=charcoal-2">
  <!-- Use the established layout context and a UI revision, not page-specific rules locals. -->
  <link rel="stylesheet" href="/assets/phase41.css?v=<%= alpha.id %>-phase41-render1-phase48-mockup2&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/phase42.css?v=phase42-1">
<link rel="stylesheet" href="/assets/phase43.css?v=phase43-1&palette=charcoal-2">
<link rel="stylesheet" href="/assets/phase44.css?v=phase44-1&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/phase45.css?v=phase45-1&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/phase46.css?v=phase46-1&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/phase47.css?v=phase47-1&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/remaster.css?v=phase48-mockup2&palette=charcoal-2">
  <link rel="stylesheet" href="/assets/realm-theme.css?v=phase6-competition1&palette=charcoal-2">
  <% if(screen==='land') { %><link rel="stylesheet" href="/assets/land-review.css?v=phase48-land-finish1&palette=charcoal-2"><% } %>
  <link rel="stylesheet" href="/assets/phase49.css?v=phase51b-final-art1">
  <% if(screen==='report') { %><link rel="stylesheet" href="/assets/phase491.css?v=phase491-report1&palette=charcoal-2"><% } %>
  <link rel="stylesheet" href="/assets/phase51c.css?v=phase51c-1&palette=charcoal-2">
  <% if(screen==='profile') { %><link rel="stylesheet" href="/assets/profile-classic.css?v=complete-rebuild-1"><% } %>
  <link rel="stylesheet" href="/assets/equipment-images.css?v=equipment-images-1">
  <% if(screen==='bounties'||screen==='battle') { %><link rel="stylesheet" href="/assets/bounty-list.css?v=bounty-list-3&palette=charcoal-2"><% } %>
  <% if(screen==="land") { %><link rel="stylesheet" href="/assets/land-premium-preview.css?v=land-direction-1&palette=charcoal-2"><% } %>
  <link rel="stylesheet" href="/assets/ui-components.css?v=approved-classic-1">
  <% } %>
</head>
<body data-sound-enabled="<%= soundConfig.enabled?'1':'0' %>" data-sound-volume="<%= soundConfig.volume %>" data-sound-event="<%= JSON.stringify(soundResult) %>" class="kingdoms-ui realm-remaster <%= themedRealm?'iron-brass':'' %> <%= state ? 'signed-in' : 'signed-out' %> screen-<%= ['report','bounties','bounty-confirm','bounty-new','champions'].includes(screen) ? 'battle' : screen %>">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="app-shell">
    <div class="page-backdrop" aria-hidden="true"></div>
    <div class="page-column">
      <% if (!state) { %><%- include('partials/realm-header') %><% } %>
      <main id="main-content" class="main-content" tabindex="-1">
        <% if (state) { %>
          <header class="character-header">
            <%- include('partials/resources') %>
            <div class="page-heading<%= ['home','quests','armory','army','purchase','profile','settings','report','tutorial','vault'].includes(screen)?' visually-hidden-heading':'' %>"><h1><%= screen==='battle'?'Attack Rivals':title %></h1></div>
          </header>
          <%- include('partials/tutorial') %>
          <% if(screen!=='tutorial'&&(actionResult?.data?.tutorialCompleted||battle?.playerExperience?.[state.id]?.tutorialCompleted)) { %><aside class="tutorial-success-note" role="status"><strong>TUTORIAL COMPLETE!</strong> You're ready to build your kingdom. <a class="text-link" href="/game/tutorial">Continue Playing ›</a></aside><% } %>
        <% } %>
        <% if (notice && !(typeof purchaseFeedback!=='undefined'&&purchaseFeedback) && !(screen==='quests'&&actionResult?.kind==='quest')) { %><div class="notice notice-success" role="status"><span aria-hidden="true">✦</span> <%= notice %></div><% } %>
        <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
        <%- include(screen) %>
        <p class="action-feedback" data-action-feedback role="status" aria-live="polite"></p>
        <p class="connection-status" data-connection-status role="status" aria-live="polite"></p>
        <footer class="page-footer"><span>Kingdoms Restored · Multiplayer alpha</span><a href="/rules">Alpha rules</a><a href="/legal/privacy">Privacy</a><a href="/legal/terms">Terms</a><a href="/account-deletion">Delete account</a></footer>
      </main>
    </div>
    <% if (state) { %><%- include('partials/primary-nav') %><% } %>
  </div>
  <% if (state) { %><script type="module" src="/assets/community.js?v=<%= alpha.id %>-phase6-competition1"></script><script type="module" src="/assets/realm.js?v=<%= alpha.id %>-complete-rebuild-1"></script><% } %>
<% if(state) { %><script type="module" src="/assets/shopping.js?v=complete-rebuild-1"></script><% } %>
<% if(state) { %><script type="module" src="/assets/experience.js?v=static-rewards-1"></script><% } %>
<% if(state) { %><script type="module" src="/assets/status.js?v=complete-rebuild-1"></script><% } %>
<script type="module" src="/assets/sound.js?v=phase491-quiet1"></script>
<% if(state) { %><script type="module" src="/assets/market.js?v=complete-rebuild-1"></script><script type="module" src="/assets/interface.js?v=phase48-shared1"></script><% } %>
<% if(state) { %><script type="module" src="/assets/player-experience.js?v=complete-rebuild-1"></script><% } %>
</body>
</html>
