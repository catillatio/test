<section class="hero hero-army compact-hero"><img class="hero-art" src="/assets/art/army.png" alt="" width="250" height="444"><div class="hero-copy"><p class="eyebrow">BENEATH ONE BANNER</p><h2>No warrior<br>stands alone.</h2><p>Recruit loyal militia. Each soldier adds strength to your attack and resolve to your defense.</p></div></section>
<div class="content-grid detail-grid">
  <section class="panel feature-card" aria-labelledby="recruit-title">
    <div class="section-heading"><span class="category-label">RECRUITMENT</span><img class="section-icon" src="/assets/art/tab-army.png" width="48" height="48" alt=""></div>
    <h2 id="recruit-title"><%= rules.unit.name %></h2><p class="description"><%= rules.unit.description %></p>
    <dl class="reward-grid"><div><dt>Each recruit</dt><dd class="gold"><%= rules.unit.goldCost %> gold</dd></div><div><dt>Attack</dt><dd>+<%= rules.unit.attack %></dd></div><div><dt>Defense</dt><dd>+<%= rules.unit.defense %></dd></div></dl>
    <% const available = Math.max(0, Math.min(rules.armyCapacity - state.units, Math.floor(state.gold / rules.unit.goldCost))); %>
    <form method="post" action="/game/army/recruit" class="recruit-form"><%- include('partials/command-fields') %><input type="hidden" name="unitId" value="<%= rules.unit.id %>"><div class="field"><label for="recruit-quantity">Number of recruits</label><input id="recruit-quantity" name="quantity" type="number" inputmode="numeric" min="1" max="<%= Math.max(1, available) %>" value="1" required<% if (!available) { %> disabled<% } %> aria-describedby="recruit-hint"></div><button type="submit" class="button button-gold"<% if (!available) { %> disabled<% } %>>Recruit militia</button></form>
    <p class="field-hint" id="recruit-hint"><% if (state.units >= rules.armyCapacity) { %>Your company is full. All <%= rules.armyCapacity %> places are filled.<% } else if (!available) { %>Complete a quest to earn enough gold for another recruit.<% } else { %>You can afford up to <%= available %> recruits. Each costs <%= rules.unit.goldCost %> gold.<% } %></p>
  </section>
  <aside class="panel" aria-labelledby="roster-title"><p class="eyebrow">YOUR COMPANY</p><h2 id="roster-title">Ready to rally</h2><div class="roster-count"><strong><%= state.units %></strong><span>of <%= rules.armyCapacity %><br>militia recruited</span></div><dl class="summary-list"><div><dt>Army attack bonus</dt><dd>+<%= state.units * rules.unit.attack %></dd></div><div><dt>Army defense bonus</dt><dd>+<%= state.units * rules.unit.defense %></dd></div><div><dt>Total attack strength</dt><dd><%= state.attack %></dd></div><div><dt>Total defense strength</dt><dd><%= state.defense %></dd></div></dl><a class="button button-outline full-width" href="/game/battle">Take the field</a></aside>
</div>
