<nav class="category-tabs army-tabs" aria-label="Army sections"><% for(const tab of [{id:'recruit',name:'Recruit'},{id:'army',name:'My Army'},{id:'dashboard',name:'Dashboard'}]) { %><a href="/game/army?tab=<%= tab.id %>"<% if(armyTab===tab.id) { %> aria-current="page"<% } %>><%= tab.name %></a><% } %></nav>
<% if(armyTab==='recruit') { %>
<section class="panel"><h2 class="strip-title">Your Invitation Code</h2><div class="army-code-row"><code class="army-code" id="invitation-code"><%= state.invitationCode %></code><button type="button" class="button button-outline" data-copy-code data-copy-target="invitation-code">Copy</button></div><p class="copy-code-status" data-copy-status role="status"></p><p class="field-hint">Share your code to join forces. Players choose whether to accept.</p>
<form method="post" action="/game/army/invite-code" class="message-form"><%- include('partials/command-fields') %><label for="ally-code">Enter a warrior's invitation code</label><input id="ally-code" name="code" type="text" minlength="12" maxlength="12" pattern="[A-Fa-f0-9]{12}" required autocomplete="off" spellcheck="false" autocapitalize="characters" placeholder="12-character code"><button class="button button-gold" type="submit">Invite Ally</button></form>
<details class="army-rule-details"><summary>Invitation rules &amp; other options ⌄</summary><p class="field-hint">There is no daily invitation quota. Distinct invitations can be sent immediately. A repeat invitation to the same player requires 24 hours. Enabled development rivals accept valid invitations immediately.</p><details><summary>Invite by character ID</summary><form method="post" action="/game/army/invite" class="inline-form"><%- include('partials/command-fields') %><label for="legacy-ally">Character ID</label><input id="legacy-ally" name="targetCharacterId" type="text" maxlength="36" required><button class="button button-outline" type="submit">Invite by ID</button></form></details></details></section>
<section class="panel"><h2 class="strip-title">Grow Your Army</h2><p class="compact-help">Invite allies using their invitation code or the Invite to Army action on a public profile. Each accepted ally adds one available member; your own equipment supplies the army.</p><a class="button button-outline" href="/game/battle">Find warriors to invite</a><p class="field-hint">Existing militia remain in your army. Gold does not recruit new militia.</p></section>

<% } else if(armyTab==='army') { %><section class="panel"><h2 class="strip-title">My Army (<%= state.army.participants %>)</h2><dl class="flow-grid"><div><dt>Participating</dt><dd><%= state.army.participants %> / <%= state.army.capacity %></dd></div><div><dt>Total available</dt><dd><%= state.army.total %></dd></div><div><dt>Mercenaries</dt><dd><%= state.units %></dd></div><div><dt>Player allies</dt><dd><%= state.army.allies %></dd></div></dl><p class="compact-help">You lead one place. Allies and retained militia share the active limit. Each participating member can use one of each equipment category from your inventory.</p></section>
<%- include('partials/army-roster') %>

<p class="army-strength">Army attack <strong><%= state.attack %></strong> · Defense <strong><%= state.defense %></strong>. Calling and allocated skills are included. <a href="/game/armory">Review equipment ›</a></p><a class="button button-outline" href="/game/army">Invite allies</a>
<% } else { %>
<section class="panel"><h2 class="strip-title">Army Dashboard</h2><div class="army-counts"><a href="/game/army?tab=army&amp;roster=accepted"><strong><%= state.army.allies %></strong> accepted allies</a><a href="/game/army?tab=army&amp;roster=incoming"><strong><%= (state.army.incoming??0) %></strong> incoming invitations</a></div><p class="compact-help"><%= state.army.participants %> / <%= state.army.capacity %> participating · <%= state.units %> retained militia · <%= (state.army.outgoing??0) %> invitations sent</p><p class="army-strength">Attack <%= state.attack %> · Defense <%= state.defense %> · Each participant uses at most one weapon, armor, and spell from your own inventory.</p></section>
<%- include('partials/army-roster') %>

<section class="panel"><h2 class="strip-title">Recent Army Activity</h2><% if(!armyEvents.length) { %><p class="compact-help">Your next invitations and accepted allies will appear here. Existing allies remain in My Army.</p><% } %><% for(const event of armyEvents) { %><article class="army-event"<% const attention=notifications.events.find(e=>e.kind==='army_accepted'&&e.id===event.id);if(attention) { %> data-notification-event="<%= JSON.stringify(attention) %>"<% } %>><a class="player-link" href="/game/players/<%= event.actor_id %>"><%= event.actor_name %></a> · invitation <%= event.kind %> · <a class="player-link" href="/game/players/<%= event.target_id %>"><%= event.target_name %></a><time class="relative-time" datetime="<%= new Date(event.created_at).toISOString() %>"><%= relativeTime(event.created_at,state.serverTime) %></time></article><% } %></section>
<%- include('partials/notification-read') %>
<% } %>
