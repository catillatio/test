<section class="panel"><h2 class="strip-title">My Army (<%= state.army.participants %>)</h2><dl class="flow-grid"><div><dt>Participating</dt><dd><%= state.army.participants %> / <%= state.army.capacity %></dd></div><div><dt>Total available</dt><dd><%= state.army.total %></dd></div><div><dt>Mercenaries</dt><dd><%= state.units %></dd></div><div><dt>Player allies</dt><dd><%= state.army.allies %></dd></div></dl><p class="compact-help">You lead one place. Allies and militia share the active limit. Each participating member can use one of each equipment category from your inventory.</p></section>
<section class="panel"><h2 class="strip-title">Recruit Militia</h2><p><strong><%= rules.unit.goldCost %> gold</strong> each · Up to <%= alpha.limits.mercenaries %> retained militia. Surplus recruits remain yours when the active army is full.</p><% const available=Math.min(alpha.limits.mercenaries-state.units,Math.floor(state.gold/rules.unit.goldCost)); %>
<form method="post" action="/game/army/recruit" class="inline-form"><%- include('partials/command-fields') %><input type="hidden" name="unitId" value="<%= rules.unit.id %>"><label for="recruit-quantity">Number of recruits</label><input id="recruit-quantity" name="quantity" type="number" inputmode="numeric" min="1" max="<%= Math.max(1,available) %>" value="1" required><button class="button button-gold" type="submit"<% if (!available) { %> disabled<% } %>>Recruit militia</button></form></section>
<section class="panel"><h2 class="strip-title">Invite a player</h2><p class="field-hint">Share your army code: <code class="army-code"><%= state.id %></code></p><form method="post" action="/game/army/invite" class="inline-form"><%- include('partials/command-fields') %><label for="ally-code">Their army code</label><input id="ally-code" name="targetCharacterId" type="text" maxlength="36" required autocomplete="off" spellcheck="false"><button class="button button-gold" type="submit">Invite ally</button></form><p class="field-hint">Invitations need acceptance. Every leader equips their own army; equipment and gold are never transferred by joining.</p></section>
<section class="panel"><h2 class="strip-title">Allies and invitations</h2><% if (!state.army.links.length) { %><p>Your roster is waiting for its first ally.</p><% } %>
<% for (const link of state.army.links) { %><div class="ally-row"><div><strong><%= link.name %></strong><span>Level <%= link.level %> <%= link.className %></span><small><%= link.status==='accepted'?'Ally':link.incoming?'Incoming invitation':'Invitation sent' %></small></div><div class="ally-actions"><% if (link.status==='pending'&&link.incoming) { %><form method="post" action="/game/army/accept"><%- include('partials/command-fields') %><input type="hidden" name="targetCharacterId" value="<%= link.characterId %>"><button class="button button-gold" type="submit" aria-label="Accept <%= link.name %>">Accept</button></form><% } %><form method="post" action="/game/army/remove"><%- include('partials/command-fields') %><input type="hidden" name="targetCharacterId" value="<%= link.characterId %>"><button class="button button-outline" type="submit" aria-label="Remove <%= link.name %>"><%= link.status==='accepted'?'Remove':'Cancel' %></button></form></div></div><% } %></section>
