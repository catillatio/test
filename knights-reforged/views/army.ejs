<nav class="category-tabs army-tabs" aria-label="Army sections"><% for(const tab of [{id:'recruit',name:'Recruit'},{id:'army',name:'My Army'},{id:'dashboard',name:'Dashboard'}]) { %><a href="/game/army?tab=<%= tab.id %>"<% if(armyTab===tab.id) { %> aria-current="page"<% } %>><%= tab.name %></a><% } %></nav>
<% if(armyTab==='recruit') { %>
<section class="panel"><h2 class="strip-title">Your Invitation Code</h2><code class="army-code"><%= state.invitationCode %></code><p class="field-hint">Share this persistent code with a player. Joining always needs their consent.</p>
<form method="post" action="/game/army/invite-code" class="message-form"><%- include('partials/command-fields') %><label for="ally-code">Invite using their code</label><input id="ally-code" name="code" type="text" minlength="12" maxlength="12" pattern="[A-Fa-f0-9]{12}" required autocomplete="off" spellcheck="false" autocapitalize="characters"><button class="button button-gold" type="submit">Invite Ally</button></form>
<details><summary>Legacy character-ID invitation</summary><form method="post" action="/game/army/invite" class="inline-form"><%- include('partials/command-fields') %><label for="legacy-ally">Character ID</label><input id="legacy-ally" name="targetCharacterId" type="text" maxlength="36" required><button class="button button-outline" type="submit">Invite by ID</button></form></details><p class="field-hint">No Storm8 account required. Maximum 20 invitations/day, 30 seconds apart. A repeat invitation to the same player requires 24 hours.</p></section>
<section class="panel"><h2 class="strip-title">Recruit Militia</h2><p><strong><%= rules.unit.goldCost %> gold</strong> each · Up to <%= alpha.limits.mercenaries %> retained militia. Surplus recruits remain yours when the active army is full.</p><% const available=Math.min(alpha.limits.mercenaries-state.units,Math.floor(state.gold/rules.unit.goldCost)); %>
<form method="post" action="/game/army/recruit" class="inline-form"><%- include('partials/command-fields') %><input type="hidden" name="unitId" value="<%= rules.unit.id %>"><label for="recruit-quantity">Number of recruits</label><input id="recruit-quantity" name="quantity" type="number" inputmode="numeric" min="1" max="<%= Math.max(1,available) %>" value="1" required><button class="button button-gold" type="submit"<% if (!available) { %> disabled<% } %>>Recruit militia</button></form></section>

<% } else if(armyTab==='army') { %><section class="panel"><h2 class="strip-title">My Army (<%= state.army.participants %>)</h2><dl class="flow-grid"><div><dt>Participating</dt><dd><%= state.army.participants %> / <%= state.army.capacity %></dd></div><div><dt>Total available</dt><dd><%= state.army.total %></dd></div><div><dt>Mercenaries</dt><dd><%= state.units %></dd></div><div><dt>Player allies</dt><dd><%= state.army.allies %></dd></div></dl><p class="compact-help">You lead one place. Allies and militia share the active limit. Each participating member can use one of each equipment category from your inventory.</p></section>
<%- include('partials/army-roster') %>

<p class="army-strength">Army attack <strong><%= state.attack %></strong> · Defense <strong><%= state.defense %></strong>. Calling and allocated skills are included. <a href="/game/armory">Review equipment ›</a></p><a class="button button-outline" href="/game/army">Recruit more militia / Invite allies</a>
<% } else { %>
<section class="panel"><h2 class="strip-title">Army Dashboard</h2><div class="army-counts"><a href="/game/army?tab=army"><strong><%= state.army.allies %></strong> accepted allies</a><a href="/game/army?tab=army"><strong><%= state.army.links.filter(link=>link.status==='pending'&&link.incoming).length %></strong> incoming invitations</a></div><p class="compact-help"><%= state.army.participants %> / <%= state.army.capacity %> participating · <%= state.units %> retained militia · <%= state.army.links.filter(link=>link.status==='pending'&&!link.incoming).length %> invitations sent</p><p class="army-strength">Attack <%= state.attack %> · Defense <%= state.defense %> · Each participant uses at most one weapon, armor, and spell from your own inventory.</p></section>
<%- include('partials/army-roster') %>

<section class="panel"><h2 class="strip-title">Recent Army Activity</h2><% if(!armyEvents.length) { %><p class="compact-help">Your next invitations and accepted allies will appear here. Existing allies remain in My Army.</p><% } %><% for(const event of armyEvents) { %><article class="army-event"><a class="player-link" href="/game/players/<%= event.actor_id %>"><%= event.actor_name %></a> · invitation <%= event.kind %> · <a class="player-link" href="/game/players/<%= event.target_id %>"><%= event.target_name %></a><time class="relative-time" datetime="<%= new Date(event.created_at).toISOString() %>"><%= relativeTime(event.created_at,state.serverTime) %></time></article><% } %></section>
<% } %>
