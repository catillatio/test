<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex"><title><%= title %> · Kingdom Come</title><link rel="stylesheet" href="/assets/play-policy.css?v=1"></head><body><main><a href="/game/home">Kingdom Come</a><h1><%= title %></h1><p class="draft" role="note">OWNER REVIEW DRAFT — unresolved publisher, contact, retention and legal fields prevent final publication.</p>
<% for(const [heading,body] of sections){ %><section><h2><%= heading %></h2><p><%= body %></p></section><% } %>
<% if(deletion){ %><section aria-labelledby="request-title"><h2 id="request-title">Request account and data deletion</h2><p>This queues a request. It does not delete your account immediately.</p><% if(receipt){ %><p role="status">Request received. Status: pending. Your receipt: <strong><%= receipt %></strong>. Deletion is not complete.</p><% } %><form method="post" action="/account-deletion/requests"><input type="hidden" name="csrf" value="<%= csrf %>"><label for="username">Account name</label><input id="username" name="username" autocomplete="username" maxlength="24" required><label for="password">Current password</label><input id="password" name="password" type="password" autocomplete="current-password" maxlength="128" required><label class="confirm" for="confirm"><input id="confirm" type="checkbox" name="confirm" value="request-account-deletion" required> I request deletion of my account and associated personal data.</label><button type="submit">Request deletion</button></form></section><% } %>
<nav aria-label="Legal documents"><a href="/legal/privacy">Privacy</a><a href="/legal/terms">Terms</a><a href="/legal/community">Community Guidelines</a><a href="/account-deletion">Request deletion</a><a href="/game/settings">Settings</a></nav></main></body></html>