<section class="panel trade-confirm" data-trade-confirm aria-labelledby="trade-title"><h2 class="strip-title" id="trade-title"><%= tradeQuote.kind==='land_buy'?'Confirm property purchase':'Confirm property sale' %></h2><div class="receipt-item"><%- include('partials/catalog-art',{entry:tradeQuote.property,small:false}) %><div><h3><%= tradeQuote.property.name %> ×<%= tradeQuote.quantity %></h3><p><%= tradeQuote.kind==='land_buy'?'Total cost':'Resale return' %>: <strong class="gold"><%= tradeQuote.amount.toLocaleString('en') %> gold</strong></p><p>Projected net income: <strong class="gold"><%= tradeQuote.projectedNet.toLocaleString('en') %> gold/hr</strong></p><p>Owned now: <%= tradeQuote.owned %> · After: <%= tradeQuote.owned+(tradeQuote.kind==='land_buy'?tradeQuote.quantity:-tradeQuote.quantity) %></p></div></div><p class="field-hint"><%= tradeQuote.kind==='land_buy'?'New property joins your existing hourly clock; its first partial period is prorated.':'Resale uses half the actual recorded purchase costs, rounded down. Earned time is settled before selling.' %> Your shared payment time is unchanged.</p><form method="post" action="/game/land/<%= tradeQuote.kind==='land_buy'?'buy':'sell' %>"><%- include('partials/command-fields') %><input type="hidden" name="propertyId" value="<%= tradeQuote.property.id %>"><input type="hidden" name="quantity" value="<%= tradeQuote.quantity %>"><input type="hidden" name="quoteId" value="<%= tradeQuote.id %>"><button class="button <%= tradeQuote.kind==='land_buy'?'button-gold':'button-outline' %>" type="submit"><%= tradeQuote.kind==='land_buy'?'Confirm purchase':'Confirm sale' %></button></form><button class="button button-outline" type="button" data-back-to-market>Change quantity</button><p class="field-hint">Confirmation is valid for five minutes. The server rechecks your purse, holdings, price and projected income.</p></section>
