<nav class="category-tabs" aria-label="Battle categories"><a href="/game/battle">Attack Rivals</a><a href="/game/bounties" aria-current="page"><span class="bounty-label">Bounty List (<span data-bounty-count data-next-expiry="<%= nextBountyExpiry??'' %>"><%= bountyCount %></span>)</span></a></nav>
<section class="panel bounty-list" aria-label="Open bounties">
<% if(!bountyBoard.active.length) { %><p class="compact-help">No open bounties. <a href="/game/battle">Choose a rival</a> to place one.</p><% } %>
<% for(const bounty of bountyBoard.active) {
 const own=bounty.sponsor_id===state.id,target=bounty.target_id===state.id;
 const restriction=target?'You are this contract’s target.':own?'Sponsors cannot claim their own contracts.':!bountyBoard.eligible?'Reach level 3 and complete five quests.':bounty.claimBlockedReason||bounty.attackBlockedReason;
 const reason=restriction||(state.health<alpha.combat.minimumHealth||state.spirit<1?'Each attack requires at least '+alpha.combat.minimumHealth+' Health and 1 Stamina.':null);
 const event=(bountyBoard.attentionFeed??[]).find(event=>event.data.bountyId===bounty.id);
 const unread=event?notifications.events.find(n=>n.id===event.id&&n.kind==='bounty_'+event.data.event):null;
%>
<article class="bounty-row"<% if(unread) { %> data-notification-event="<%= JSON.stringify(unread) %>"<% } %>>
<div class="bounty-target"><h3><a class="player-link" href="/game/players/<%= bounty.target_id %>"><%= bounty.name %></a></h3><span>Level <%= bounty.level %> <%= bounty.profile_class %></span></div>
<strong class="gold bounty-amount"><%= bounty.amount.toLocaleString('en') %> gold</strong>
<form method="post" action="/game/battle/attack"><%- include('partials/command-fields') %><input type="hidden" name="targetCharacterId" value="<%= bounty.target_id %>"><input type="hidden" name="bountyId" value="<%= bounty.id %>"><button class="button button-gold" type="submit" aria-label="Hunt <%= bounty.name %>" data-attack-ready="<%= restriction?'false':'true' %>"<% if(reason) { %> disabled title="<%= reason %>"<% } %>>Attack</button></form>
</article><% } %></section>
<details class="panel bounty-rules"><summary>Bounty rules and limits</summary><p class="compact-help">Posting and hunting require level <%= bountyRules.minimumLevel %> and <%= bountyRules.minimumQuests %> completed quests. Hunts cross all levels and use the normal Health and Stamina costs. A losing attack can claim if it deals the real finishing damage.</p><p class="compact-help">Use Add to Bounty List near the top of a rival's profile. Place 1–10,000 gold from your unbanked purse; Vault funds must be withdrawn first. The listing fee is 10%, rounded up, minimum 1 gold; review the exact total before confirmation. One active bounty per target. Expiration after 24 hours and cancellation after one hour return the full principal; the disclosed fee is retained.</p><p class="compact-help">In any rolling 24 hours, each sponsor may place at most <%= bountyRules.sponsorTargetDailyLimit %> bounties on the same target, and that target may receive at most <%= bountyRules.targetDailyLimit %> placements across all sponsors. Ended contracts still count until their placement leaves that window. After a contract ends, relisting is immediate, including while the target recovers at 0 Health. Attacking that new contract waits for positive Health from natural recovery; there is no automatic heal or extra relisting cooldown. Posting on yourself or an army ally remains unavailable. Bots never sponsor or claim; they can be targets only when the development flag is enabled. Eligible army allies of the sponsor or target may hunt. Sponsors and targets cannot claim their own contracts. Only the eligible finishing attacker receives the reward and one kill; ordinary wins and knockouts award no kills. The defeated target stays at 0 Health and recovers naturally. Coordinated account ownership cannot be detected perfectly during alpha.</p></details>
<details class="panel bounty-records"><summary>Your bounty records</summary>
<% if(!bountyBoard.history.length) { %><p class="compact-help">Your placed, targeted and claimed contracts will appear here.</p><% } %>
<% for(const bounty of bountyBoard.history) { const own=bounty.sponsor_id===state.id; %><article class="bounty-history-row"><div><%- include('partials/bounty-attention',{contractId:bounty.id}) %><a class="player-link" href="/game/players/<%= bounty.target_id %>"><%= bounty.target_name %></a> · <span class="gold"><%= bounty.amount.toLocaleString('en') %> gold</span><span class="bounty-status"><%= bounty.status %></span><small><% if(own) { %>You posted this contract<% } else { %>Posted by <a class="player-link" href="/game/players/<%= bounty.sponsor_id %>"><%= bounty.sponsor_name %></a><% } %><%= ['expired','canceled'].includes(bounty.status)?' · principal refunded; fee retained':'' %><%= bounty.claimant_id===state.id?' · you received the reward':'' %></small><% if(bounty.status==='claimed') { %><small>Claimed by <a class="player-link" href="/game/players/<%= bounty.claimant_id %>"><%= bounty.claimant_name??'Bounty hunter' %></a><% if(bounty.settled_at) { %> · <time datetime="<%= new Date(bounty.settled_at).toISOString() %>"><%= new Date(bounty.settled_at).toLocaleString('en-GB',{timeZone:'UTC'}) %> UTC</time><% } %><%= bounty.recorded_claim?' · successful bounty claim':' · historical contract record' %><% if(bounty.battle_outcome) { %> · <%= bounty.battle_outcome==='defender_win'?'Defender won the battle calculation':'Attacker won the battle calculation' %><% } %></small><% if([bounty.target_id,bounty.claimant_id].includes(state.id)) { %><a class="text-link" href="/game/battles/<%= bounty.battle_id %>">Saved combat report ›</a><% } %><% } %></div>
<% if(own&&bounty.status==='active') { %><form method="post" action="/game/bounties/cancel"><%- include('partials/command-fields') %><input type="hidden" name="bountyId" value="<%= bounty.id %>"><button class="button button-outline" type="submit"<% if(Date.parse(state.serverTime)<Date.parse(bounty.created_at)+bountyRules.cancelAfterSeconds*1000) { %> disabled<% } %>>Cancel</button></form><% } %></article><% } %>

<%- include('partials/notification-read') %>
</details>
