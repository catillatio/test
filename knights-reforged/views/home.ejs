<section class="royal-announcement" aria-label="Royal Announcements"><% for(const announcement of announcements) { %><h2><%= announcement.heading %></h2><p><%= announcement.text %></p><% } %></section>
<% if(experience?.tutorial.status==='not_started') { %><section class="tutorial-invitation"><h2>New to Kingdom Come?</h2><p>Learn how to complete quests, earn gold, purchase equipment, battle enemies, and grow your kingdom.</p><form method="post" action="/game/tutorial"><%- include('partials/command-fields') %><input type="hidden" name="action" value="start"><button class="button button-gold" type="submit">Start Tutorial</button></form><form method="post" action="/game/tutorial"><%- include('partials/command-fields') %><input type="hidden" name="action" value="skip"><button class="tutorial-skip" type="submit">Skip tutorial</button></form></section><% } else if(experience&&(experience.tutorial.status!=='completed'||experience.tutorial.replaying)) { %><section class="tutorial-resume"><p>Tutorial · Step <%= experience.tutorial.position??1 %> of 8</p><form method="post" action="/game/tutorial"><%- include('partials/command-fields') %><input type="hidden" name="action" value="resume"><button class="button button-gold" type="submit">Continue Tutorial</button></form></section><% } %>

<section class="home-menu" aria-label="Main menu">
<a class="button button-outline" href="/game/land"><span><svg class="menu-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#land"></use></svg>Land</span></a>
<a class="button button-outline" href="/game/army?tab=army"><span><svg class="menu-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#army"></use></svg>My Army (<%= state.army.participants %>)</span></a>
<a class="button button-outline" href="/game/profile"><span><svg class="menu-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#profile"></use></svg>My Profile</span></a>
<a class="button button-outline" href="/game/vault"><span><svg class="menu-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#vault"></use></svg>Vault</span></a>

<a class="button button-outline" href="/rules"><span><svg class="menu-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#help"></use></svg>Help / Rules</span></a>
<a class="button button-outline" href="/game/settings"><span><svg class="menu-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#settings"></use></svg>Settings</span></a>
<a class="button button-outline hall-menu-link" href="/game/champions"><span><svg class="menu-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#champions"></use></svg>Hall of Champions</span></a>
<a class="button button-outline calling-menu-link" href="/game/home?calling=1#calling"><span><svg class="menu-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#battle"></use></svg>Calling</span><small><%= callingName(state.className) %></small></a>
</section>
<% if(showCalling||actionResult?.kind==='profile') { %><%- include('partials/calling') %><% } %>
<% if(state.skillPoints) { %><p class="compact-help"><a class="text-link" href="/game/profile?tab=skills#skills"><%= state.skillPoints %> skill points available ›</a> · <%= state.xpToNext %> XP until your next level.</p><% } %>
<% if(state.maintenance.paused) { %><p class="compact-help warning">Equipment upkeep is paused. <a href="/game/armory">Manage upkeep ›</a></p><% } %>
<section aria-labelledby="activity-title"><h2 id="activity-title" class="profile-section-heading">Recent Activity</h2>
<nav class="category-tabs feed-tabs" aria-label="Activity categories"><% for(const tab of [{id:'all',name:'All'},{id:'battles',name:'Battles'},{id:'comments',name:'Comments'},{id:'broadcasts',name:'Broadcasts'}]) { %><a href="/game/home?feed=<%= tab.id %>"<% if(feedTab===tab.id) { %> aria-current="page"<% } %>><%= tab.name %></a><% } %></nav>
<% if(feedTab==='broadcasts') { %><%- include('partials/message-form',{channel:'broadcast',profileId:null}) %><p class="compact-help">Public realm messages. Level 2 and three quests required; 12 posts per rolling day. Temporary rivals never post.</p><% } else if(feedTab==='comments') { %><%- include('partials/message-form',{channel:'comment',profileId:state.id}) %><p class="compact-help">Comments on your profile and comments you leave for others. Visit another player's Profile to leave them a message.</p><% } %>
<%- include('partials/activity-feed',{pageBase:'/game/home?feed='+feedTab}) %><a class="feed-refresh text-link" href="/game/home?feed=<%= feedTab %>">Refresh activity ↻</a></section>
