<% const guide=experience.tutorial;const complete=guide.status==='completed'&&!guide.replaying;const active=guide.status==='active'||guide.replaying;const position=guide.position??1;const step=guide.steps[position-1]; %>
<% if(complete) { %><section class="panel tutorial-complete reward-celebration" data-celebration-id="tutorial-complete-<%= state.id %>-<%= guide.completedAt??'legacy' %>" aria-labelledby="tutorial-complete-title"><span class="tutorial-complete-emblem" aria-hidden="true">♛</span><h2 id="tutorial-complete-title">TUTORIAL COMPLETE!</h2><p>You're ready to build your kingdom.</p><p class="compact-help">Your guide stays here whenever you need it. Your kingdom and rewards are unchanged.</p><a class="button button-gold" href="/game/home">Continue Playing</a><form method="post" action="/game/tutorial"><%- include('partials/command-fields') %><input type="hidden" name="action" value="replay"><button class="tutorial-skip" type="submit">Replay the guide</button></form></section>
<% } else if(!active) { %><section class="panel guide-welcome"><h2>New to Kingdom Come?</h2><p>Learn how to complete quests, earn gold, purchase equipment, battle enemies, and grow your kingdom.</p><p class="compact-help">Eight short lessons. You can pause, skip or return whenever you like. Actions you've already completed still count.</p><form method="post" action="/game/tutorial"><%- include('partials/command-fields') %><input type="hidden" name="action" value="<%= guide.status==='not_started'?'start':'resume' %>"><button class="button button-gold" type="submit"><%= guide.status==='not_started'?'Start Tutorial':'Continue Tutorial' %></button></form><a class="text-link" href="/game/home">Continue Playing ›</a></section>
<% } else { %><section class="panel guide-lesson" aria-labelledby="guide-title"><p class="guide-progress-label">Step <%= position %> of 8<%= guide.replaying?' · Replay':'' %></p><progress class="reward-progress" value="<%= position %>" max="8" aria-label="Tutorial lesson"></progress><h2 id="guide-title"><%= step.name %></h2><p><%= step.help %></p><% if(step.done) { %><p class="guide-done">✓ Already done — no need to repeat it.</p><% } %><a class="button button-gold guide-show-me" href="<%= step.href %>">Show Me</a>
<div class="guide-controls"><form method="post" action="/game/tutorial"><%- include('partials/command-fields') %><input type="hidden" name="action" value="back"><button class="button button-outline" type="submit"<% if(position===1) { %> disabled<% } %>>Back</button></form><form method="post" action="/game/tutorial"><%- include('partials/command-fields') %><input type="hidden" name="action" value="<%= position===8?'finish':'next' %>"><button class="button button-outline" type="submit"><%= position===8?'Finish Tutorial':'Next' %></button></form><form method="post" action="/game/tutorial"><%- include('partials/command-fields') %><input type="hidden" name="action" value="skip"><button class="tutorial-skip" type="submit">Skip for now</button></form></div><p class="field-hint">Read at your own pace. Next never spends gold or starts a battle.</p></section><% } %>
