<section class="panel quest-equipment" aria-labelledby="equipment-needed"><h2 class="strip-title" id="equipment-needed"><%= questEquipment.missing.length?'Additional equipment required':'Ready for your next deed' %></h2><h3><%= questEquipment.quest.name %></h3>
<% if(state.level<questEquipment.quest.level) { %><p class="warning">Reach Level <%= questEquipment.quest.level %> to attempt this quest or buy its required equipment.</p><% } %>
<% if(questEquipment.missing.length) { %><p class="compact-help">Only the copies you are missing are listed. Equipment remains yours after the quest.</p><ul class="requirements-shopping-list"><% for(const needed of questEquipment.missing) { %><li><%- include('partials/catalog-art',{entry:needed.item,small:true}) %><span><strong><%= needed.item.name %></strong> ×<%= needed.quantity %><small><%= needed.item.price.toLocaleString('en') %> gold each</small></span><strong class="gold"><%= needed.cost.toLocaleString('en') %> gold</strong></li><% } %></ul><p class="requirements-total">Total required <strong class="gold"><%= questEquipment.total.toLocaleString('en') %> gold</strong></p><% if(questEquipment.shortfall) { %><p class="warning">You need <%= questEquipment.shortfall.toLocaleString('en') %> more gold. Your purse holds <%= state.gold.toLocaleString('en') %> gold.</p><% } %><form method="post" action="/game/quests/<%= questEquipment.quest.id %>/equipment"><%- include('partials/command-fields') %><button class="button button-gold" type="submit"<% if(questEquipment.shortfall||state.level<questEquipment.quest.level) { %> disabled<% } %>>Buy Missing Equipment</button></form>
<% } else { %><p class="success">You own all the required equipment. Your army uses its best gear automatically.</p><p><span class="mana"><%= questEquipment.quest.mana %> Mana</span> · <%= questEquipment.quest.goldMin %>–<%= questEquipment.quest.goldMax %> gold · +<%= questEquipment.quest.xp %> XP</p><form method="post" action="/game/quests/<%= questEquipment.quest.id %>/run"><%- include('partials/command-fields') %><button class="button button-gold" type="submit"<% if(!questEquipment.quest.ready) { %> disabled<% } %>>Do Quest</button></form><% if(!questEquipment.quest.ready) { %><p class="warning"><%= questEquipment.quest.lockReason??'This quest is not available yet.' %></p><% } %><% } %><p class="field-hint">Buying equipment does not spend Mana or complete this quest. You confirm the quest separately.</p><a class="text-link" href="/game/quests">Return to Quests ›</a></section>
