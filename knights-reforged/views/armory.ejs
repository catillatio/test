<section class="hero hero-armory compact-hero"><img class="hero-art" src="/assets/art/armory.png" alt="" width="255" height="453"><div class="hero-copy"><p class="eyebrow">THE VILLAGE FORGE</p><h2>A good blade.<br>A steadier hand.</h2><p>Put your hard-earned gold into equipment. A weapon only lends its strength once you equip it.</p></div></section>
<div class="content-grid detail-grid">
  <section class="panel feature-card" aria-labelledby="weapon-title">
    <div class="section-heading"><span class="category-label">WEAPON · IRON</span><span class="small-tag"><%= state.inventoryId ? 'Owned' : 'Available' %></span></div>
    <div class="item-heading"><div class="item-emblem" aria-hidden="true">⚔</div><div><h2 id="weapon-title"><%= rules.weapon.name %></h2><p class="description"><%= rules.weapon.description %></p></div></div>
    <dl class="reward-grid"><div><dt>Price</dt><dd class="gold"><%= rules.weapon.goldCost %> gold</dd></div><div><dt>Attack</dt><dd>+<%= rules.weapon.attack %></dd></div><div><dt>Defense</dt><dd>+<%= rules.weapon.defense %></dd></div></dl>
    <% if (!state.inventoryId) { %>
      <form method="post" action="/game/armory/buy"><%- include('partials/command-fields') %><input type="hidden" name="itemId" value="<%= rules.weapon.id %>"><button type="submit" class="button button-gold full-width"<% if (state.gold < rules.weapon.goldCost) { %> disabled<% } %>>Purchase iron sword</button></form>
      <% if (state.gold < rules.weapon.goldCost) { %><p class="field-hint">You need <%= rules.weapon.goldCost - state.gold %> more gold. A border patrol is a good place to start.</p><% } %>
    <% } else if (!state.equipped) { %>
      <form method="post" action="/game/armory/equip"><%- include('partials/command-fields') %><input type="hidden" name="inventoryEntryId" value="<%= state.inventoryId %>"><button type="submit" class="button button-gold full-width">Equip iron sword</button></form>
      <p class="field-hint">This sword is in your inventory. Equip it to use its bonuses.</p>
    <% } else { %><div class="equipped-state"><span aria-hidden="true">✓</span> Equipped and ready for battle</div><% } %>
  </section>
  <aside class="panel" aria-labelledby="loadout-title"><p class="eyebrow">YOUR LOADOUT</p><h2 id="loadout-title">Armed for the road</h2><div class="equipment-slot<%= state.equipped ? ' is-equipped' : '' %>"><img src="/assets/art/tab-armory.png" alt="" width="52" height="52"><div><span class="muted">Weapon slot</span><strong><%= state.equipped ? rules.weapon.name : 'Empty' %></strong></div></div><dl class="summary-list"><div><dt>Equipment attack</dt><dd>+<%= state.equipped ? rules.weapon.attack : 0 %></dd></div><div><dt>Equipment defense</dt><dd>+<%= state.equipped ? rules.weapon.defense : 0 %></dd></div><div><dt>Total attack</dt><dd><%= state.attack %></dd></div><div><dt>Total defense</dt><dd><%= state.defense %></dd></div></dl><a class="text-link" href="/game/battle">Test your strength <span aria-hidden="true">→</span></a></aside>
</div>
