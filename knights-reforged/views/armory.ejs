<nav class="category-tabs" aria-label="Armory categories"><% for (const tab of [{id:'weapon',name:'Weapons'},{id:'armor',name:'Armor'},{id:'spell',name:'Spells'}]) { %><a href="/game/armory?category=<%= tab.id %>"<% if (category===tab.id) { %> aria-current="page"<% } %>><%= tab.name %></a><% } %></nav>
<p class="compact-help">Each participating army member automatically uses at most <strong>1 weapon, 1 armor and 1 spell</strong>. Best Attack is used when attacking; best Defense when defending.</p>
<%- include('partials/maintenance') %>
<div class="catalog" aria-label="Equipment catalog">
<% for (const item of alpha.items.filter(i=>i.category===category)) { const owned=state.inventory.find(i=>i.id===item.id);const quantity=owned?.quantity??0;const unlocked=state.level>=item.level;const affordable=Math.min(alpha.limits.transaction,alpha.limits.inventory-quantity,Math.floor(state.gold/item.price)); %>
  <article class="catalog-row" data-item="<%= item.id %>">
    <img class="catalog-art" src="/assets/art/alpha/<%= item.art %>.svg" width="76" height="76" alt="<%= item.name %> illustration">
    <div class="catalog-description"><h2><%= item.name %></h2><span>Attack: <strong><%= item.attack %></strong></span><span>Defense: <strong><%= item.defense %></strong></span><span>Upkeep: <strong class="<%= item.upkeep?'cost':'' %>"><%= item.upkeep %></strong> / hour</span><% if (!unlocked) { %><span class="warning">Unlock at level <%= item.level %></span><% } %></div>
    <div class="catalog-trade"><div class="price-owned"><strong class="gold">● <%= item.price.toLocaleString('en') %></strong><span>Owned: <strong><%= quantity %></strong></span></div>
      <div class="trade-actions">
        <form method="post" action="/game/armory/buy"><%- include('partials/command-fields') %><input type="hidden" name="itemId" value="<%= item.id %>"><label class="sr-only" for="buy-<%= item.id %>">Buy quantity for <%= item.name %></label><input class="quantity" id="buy-<%= item.id %>" name="quantity" type="number" inputmode="numeric" min="1" max="<%= Math.max(1,affordable) %>" value="1" required aria-label="Buy quantity for <%= item.name %>"><button class="button button-gold" type="submit" aria-label="Buy <%= item.name %>"<% if (!unlocked||!affordable) { %> disabled<% } %>>Buy</button></form>
        <form method="post" action="/game/armory/sell"><%- include('partials/command-fields') %><input type="hidden" name="itemId" value="<%= item.id %>"><label class="sr-only" for="sell-<%= item.id %>">Sell quantity for <%= item.name %></label><input class="quantity" id="sell-<%= item.id %>" name="quantity" type="number" inputmode="numeric" min="1" max="<%= Math.max(1,Math.min(quantity,alpha.limits.transaction)) %>" value="1" required><button class="button button-outline" type="submit" aria-label="Sell <%= item.name %>"<% if (!quantity) { %> disabled<% } %>>Sell</button></form>
      </div>
    </div>
  </article>
<% } %>
</div>
<p class="compact-help">Sales return half the recorded cost of each copy, rounded down. Buying never requires passive income. Upkeep gear reserves one hourly bill when carried gold allows; otherwise it waits safely for funding.</p>
<section class="panel"><h2 class="strip-title">Your automatic loadout</h2><p><%= state.army.participants %> participating members · Attack <strong><%= state.attack %></strong> · Defense <strong><%= state.defense %></strong></p><div class="loadout-grid"><% for (const group of [{name:'Attacking',items:state.attackEquipment.selected},{name:'Defending',items:state.defenseEquipment.selected}]) { %><div><h3><%= group.name %></h3><ul class="plain-list"><% for (const item of group.items) { %><li><%= item.name %> ×<%= item.quantity %></li><% } %><% if (!group.items.length) { %><li>No usable equipment yet.</li><% } %></ul></div><% } %></div></section>
