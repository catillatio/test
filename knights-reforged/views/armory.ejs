<nav class="category-tabs" aria-label="Armory categories"><% for (const tab of [{id:'weapon',name:'Weapons'},{id:'armor',name:'Armor'},{id:'spell',name:'Spells'}]) { %><a href="/game/armory?category=<%= tab.id %>"<% if (category===tab.id) { %> aria-current="page"<% } %>><%= tab.name %></a><% } %></nav>
<details class="market-upkeep"<% if(state.maintenance.paused) { %> open<% } %>><summary>Army upkeep <strong class="gold"><%= state.maintenance.hourlyRate.toLocaleString('en') %> /hr</strong><span>Details ⌄</span></summary><%- include('partials/maintenance') %><p class="compact-help">Each participating member automatically uses their best weapon, armor and spell. Sales return two-thirds of each copy's recorded cost, rounded down.</p></details>
<% const bulk=typeof marketBulkId==='string'?alpha.items.find(i=>i.id===marketBulkId&&i.category===category):null;if(bulk) { const owned=state.inventory.find(i=>i.id===bulk.id);const available=state.level>=bulk.level?Math.min(alpha.limits.transaction,alpha.limits.inventory-(owned?.quantity??0),Math.floor(state.gold/bulk.price)):0; %>
<%- include('partials/market-bulk',{entry:bulk,type:'equipment',availableBuy:available,availableSell:owned?.maxSell??0,buyCosts:Array.from({length:Math.max(1,available)},(_,i)=>bulk.price*(i+1)),sellCosts:owned?.resaleSteps??[]}) %><% } %>
<div class="catalog market-catalog" aria-label="Equipment catalog">
<% for (const item of alpha.items.filter(i=>i.category===category).sort((a,b)=>a.level-b.level||a.price-b.price)) { const owned=state.inventory.find(i=>i.id===item.id);const quantity=owned?.quantity??0;const unlocked=state.level>=item.level;const affordable=unlocked?Math.max(0,Math.min(alpha.limits.transaction,alpha.limits.inventory-quantity,Math.floor(state.gold/item.price))):0; %>
<article class="catalog-row" id="item-<%= item.id %>" data-item="<%= item.id %>">
<%- include('partials/catalog-art',{entry:item,small:false}) %>
<div class="catalog-description"><h2><%= item.name %></h2><span>Attack <strong><%= item.attack %></strong> · Defense <strong><%= item.defense %></strong></span><div class="catalog-more"><span>Upkeep <strong class="<%= item.upkeep?'cost':'' %>"><%= item.upkeep.toLocaleString('en') %></strong> /hr</span><%- include('partials/market-link',{entry:item,type:'equipment'}) %></div><% if(!unlocked) { %><span class="warning">Level <%= item.level %> required</span><% } %></div>
<div class="catalog-trade"><div class="price-owned"><strong class="gold"><svg class="coin-icon" width="15" height="15" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-mockup2#coin"></use></svg> <%= item.price.toLocaleString('en') %></strong><span>Owned <strong><%= quantity %></strong></span></div>
<%- include('partials/market-trade',{entry:item,type:'equipment',availableBuy:affordable,availableSell:owned?.maxSell??0,refund:owned?.resaleSteps?.[0]??0}) %></div>
</article><% } %></div>
<section class="panel" id="automatic-loadout"><h2 class="strip-title">Your automatic loadout</h2><p><%= state.army.participants %> participating members · Attack <strong><%= state.attack %></strong> · Defense <strong><%= state.defense %></strong></p><div class="loadout-grid"><% for (const group of [{name:'Attacking',items:state.attackEquipment.selected},{name:'Defending',items:state.defenseEquipment.selected}]) { %><div><h3><%= group.name %></h3><ul class="plain-list"><% for (const item of group.items) { %><li><%= item.name %> ×<%= item.quantity %></li><% } %><% if (!group.items.length) { %><li>No usable equipment yet.</li><% } %></ul></div><% } %></div></section>
