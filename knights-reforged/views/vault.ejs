<section class="panel vault-panel"><h2 class="profile-section-heading">The Royal Vault</h2>
<dl class="profile-gold-flow"><div><dt>Unbanked gold</dt><dd class="gold"><%= state.gold.toLocaleString('en') %></dd></div><div><dt>Protected Vault balance</dt><dd class="gold"><%= (state.bankedGold??0).toLocaleString('en') %></dd></div></dl>
<p class="compact-help">Protected savings · Free deposits and withdrawals.</p><details class="vault-rules"><summary>Vault rules</summary><p class="compact-help">Banked gold cannot be stolen or spent on equipment, upkeep or bounties. Withdraw to your purse before spending. Deposits and withdrawals are free. The Vault pays no interest.</p></details>
<div class="vault-transfers"><% for(const deposit of [true,false]) { %><form method="post" action="/game/vault/<%= deposit?'deposit':'withdraw' %>"><%- include('partials/command-fields') %><label for="vault-<%= deposit?'deposit':'withdraw' %>"><%= deposit?'Deposit':'Withdraw' %> gold</label><input id="vault-<%= deposit?'deposit':'withdraw' %>" name="amount" type="number" inputmode="numeric" min="1" max="2147483647" value="1" required><button class="button <%= deposit?'button-gold':'button-outline' %>" type="submit"><%= deposit?'Deposit':'Withdraw' %></button></form><% } %></div>
</section><section class="panel"><h2 class="strip-title">Recent Vault transactions</h2><% if(!vaultEntries.length) { %><p class="compact-help">No Vault transactions yet.</p><% } %><% for(const entry of vaultEntries) { %><div class="vault-entry"><strong><%= entry.amount>0?'+':'' %><%= entry.amount.toLocaleString('en') %> gold</strong><span><%= entry.reason %> · Balance <%= entry.balance_after.toLocaleString('en') %></span><time datetime="<%= new Date(entry.created_at).toISOString() %>"><%= relativeTime(entry.created_at,state.serverTime) %></time></div><% } %></section>
