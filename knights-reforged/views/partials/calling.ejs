<section class="panel calling-panel" id="calling" aria-labelledby="calling-title"><div class="calling-heading"><h2 id="calling-title">Calling</h2><a class="text-link" href="/game/home">Close</a></div>
<p class="compact-help"><strong><%= callingName(state.className) %></strong> · <%= state.calling.description %></p>
<details class="calling-details"><summary>Bonuses and recovery</summary><div class="calling-list"><% for(const [name,calling] of Object.entries(strategy.callings)) { %><div class="calling-row<%= state.className===name?' is-current':'' %>"><h3><%= callingName(name) %></h3><p><%= calling.attackPercent>0?'+':'' %><%= calling.attackPercent %>% attack · <%= calling.defensePercent>0?'+':'' %><%= calling.defensePercent %>% defense<br><%= name==='Freeblade'?'10% shorter Spirit recovery intervals':name==='Warden'?'10% shorter Health recovery intervals':'10% shorter Mana recovery intervals' %></p></div><% } %></div>
<p class="field-hint">Bonuses multiply trained army power; equipment, ownership quantities and skill allocations remain decisive. Your current recovery intervals: <%= state.calling.healthSeconds %>s Health · <%= state.calling.manaSeconds %>s Mana · <%= state.calling.spiritSeconds %>s Spirit.</p>
</details>
<% const ready=!state.calling.changeReadyAt||Date.parse(state.calling.changeReadyAt)<=Date.parse(state.serverTime); %>
<form method="post" action="/game/profile/calling" class="inline-form"><%- include('command-fields') %><input type="hidden" name="returnTo" value="home"><label for="calling-choice">Calling</label><select id="calling-choice" name="className"><% for(const name of Object.keys(strategy.callings)) { %><option value="<%= name %>"<% if(state.className===name) { %> selected<% } %>><%= callingName(name) %></option><% } %></select><button class="button button-outline" type="submit"<% if(!ready) { %> disabled<% } %>>Choose calling</button></form>
<p class="field-hint"><%= state.calling.changeCost?'Further changes cost '+state.calling.changeCost+' gold.':'Your first change is free.' %> One change per 24 hours. Changing starts fresh recovery intervals.<% if(!ready) { %> Next change: <time datetime="<%= state.calling.changeReadyAt %>"><%= new Date(state.calling.changeReadyAt).toLocaleString('en-GB',{timeZone:'UTC'}) %> UTC</time>.<% } %></p>
</section>
