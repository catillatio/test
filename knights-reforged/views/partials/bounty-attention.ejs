<% for(const event of bountyBoard.attentionFeed??[]) { if(event.data.bountyId!==contractId)continue;const unread=notifications.events.find(n=>n.id===event.id&&n.kind==='bounty_'+event.data.event);if(unread) { %><small class="bounty-notification-marker" data-notification-event="<%= JSON.stringify(unread) %>"><%= unread.kind==='bounty_placed'?'New contract':'New claim update' %></small><% } } %>
