<% if(combatTarget) { const target=combatTarget; %>
<section class="panel follow-up-combat" data-combat-target="<%= target.targetId %>" aria-label="Continue combat">
  <h2 class="strip-title"><a class="player-link" href="/game/players/<%= target.targetId %>"><%= target.name %></a></h2>
  <p>Current Health <strong data-target-health><%= target.health %></strong> / <span data-target-max-health><%= target.maxHealth %></span></p>
  <meter data-target-meter min="0" max="<%= target.maxHealth %>" value="<%= target.health %>" aria-label="Opponent current Health"></meter>
  <form method="post" action="/game/battle/attack" data-combat-form><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= target.targetId %>">
    <button class="button button-gold attack-again" type="submit" data-attack-ready="<%= target.eligible?'true':'false' %>"<% if(!target.allowed) { %> disabled<% } %>><%= screen==='report'?'Attack Again':'Attack' %></button>
  </form>
  <p class="compact-help combat-restriction" role="status" data-combat-restriction><%= target.reason??'Ready. Each attack costs 1 Spirit. Attack again immediately after the result.' %></p>
  <p class="field-hint">Fresh attack, fresh report. Reward limits remain in effect. No extra repeat-attack limit.</p>
</section><% } %>
