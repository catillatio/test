<% const found=(actionResult?.data?.equipmentDrops??[]).map(drop=>({drop,item:authoritativeItems.find(item=>item.id===drop.id)})).filter(row=>row.item); %>
<% if(found.length) { %><aside class="rare-discovery" role="status" aria-label="Rare quest equipment discovered"><h3>Rare equipment discovered</h3><p class="compact-help">Quest-exclusive treasure · Yours to use in your army</p><% for(const {drop,item} of found) { %><div class="rare-discovery-item"><%- include('catalog-art',{entry:item,small:true}) %><div><strong><%= item.name %> ×<%= drop.quantity %></strong><small>Attack <%= item.attack %> · Defense <%= item.defense %> · Upkeep <%= item.upkeep %> / hr</small></div></div><% } %><a class="text-link" href="/game/profile#discoveries">View your discoveries ›</a></aside><% } %>
