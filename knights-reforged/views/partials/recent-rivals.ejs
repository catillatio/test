<section class="panel recent-rivals" aria-labelledby="recent-rivals-title"><h2 class="profile-section-heading" id="recent-rivals-title">Recent Rivals</h2>
<% if(typeof recentRivals==='undefined'||!recentRivals.length) { %><p class="compact-help">Your encounters with other players will appear here. Temporary rivals are listed below.</p><% } else { %><ul class="recent-rival-list"><% for(const rival of recentRivals) { %><li><div><a class="player-link" href="/game/players/<%= rival.id %>#rivalry"><%= rival.name %></a><small>Level <%= rival.level %> · You <%= rival.wins %> — <%= rival.losses %> them</small><span class="recent-rival-result"><%- include('outcome',{won:rival.won}) %><time datetime="<%= rival.createdAt %>"><%= relativeTime(rival.createdAt,state.serverTime) %></time></span><span class="recent-rival-links"><a class="text-link" href="/game/players/<%= rival.id %>#rivalry">View Profile ›</a> <a class="text-link" href="/game/battles/<%= rival.battleId %>">View Battle ›</a></span></div><form method="post" action="/game/battle/attack"><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= rival.id %>"><button class="button button-gold" type="submit" aria-label="Challenge <%= rival.name %>"<% if(!rival.combat.allowed) { %> disabled<% } %>>Attack</button><% if(rival.combat.reason) { %><small class="field-hint"><%= rival.combat.reason %></small><% } %></form></li><% } %></ul><% } %></section>
