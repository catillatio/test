<% if(typeof purchaseFeedback!=='undefined'&&purchaseFeedback?.id===entry.id) { %><p class="market-purchase-feedback" role="status"><a href="/game/purchases/<%= purchaseFeedback.commandId %>" aria-label="View saved receipt: purchased <%= purchaseFeedback.quantity %> <%= purchaseFeedback.name %> for <%= purchaseFeedback.goldSpent %> gold">Purchased ×<%= purchaseFeedback.quantity %> · <%= Number(purchaseFeedback.goldSpent).toLocaleString('en') %> gold<span>Receipt ›</span></a></p><% } %>
