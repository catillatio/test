<% const broadcast=channel==='broadcast';const length=broadcast?community.social.broadcastCharacters:community.social.commentCharacters; %>
<form method="post" action="/game/social/<%= broadcast?'broadcast':'comment' %>" class="message-form">
  <%- include('command-fields') %><% if(!broadcast) { %><input type="hidden" name="profileId" value="<%= profileId %>"><% } %>
  <label for="social-body"><%= broadcast?'Speak to the realm':'Leave a profile comment' %></label>
  <textarea id="social-body" name="body" maxlength="<%= length %>" rows="3" required placeholder="<%= broadcast?'A word from your kingdom…':'Write a respectful message…' %>"></textarea>
  <div class="message-controls"><small><%= length %> characters · <%= broadcast?community.social.broadcastCooldownSeconds:community.social.commentCooldownSeconds %>s between posts</small><button class="button button-gold" type="submit"><%= broadcast?'Broadcast':'Post Comment' %></button></div>
</form>
