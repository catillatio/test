<% if (entry.illustration) { const art=entry.illustration; %><span class="catalog-art fantasy-art atlas-<%= art.atlas %> art-col-<%= art.column %> art-row-<%= art.row %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="<%= art.atlas %>"></span><% } else { %><img class="catalog-art<%= small?' art-small':'' %>" src="/assets/art/alpha/<%= entry.art %>.svg" width="76" height="76" alt="<%= entry.name %> illustration"><% } %>
