<% const selectedEquipment=['oathbound-greatsword','crown-of-ash-blade','eclipse-greatsword','sovereigns-bastion','eclipse-citadel-plate'].indexOf(entry.id);
const selectedProperty=['dawnspire-cathedral','wyrmcrest-keep','astral-observatory','throne-of-ash','eclipse-citadel','tempest-port'].indexOf(entry.id);
const revisedProperty=['wyrmcrest-keep','moonwell-sanctuary'].indexOf(entry.id);
const preparedArt=typeof approvedExpansionArt==='function'?approvedExpansionArt(entry.id):null;
if(preparedArt) { %><img class="catalog-art<%= small?' art-small':'' %>" src="<%= preparedArt %>" width="76" height="76" alt="<%= entry.name %> illustration"><% } else if(entry.art?.startsWith('pending:')) { %><span class="catalog-art pending-art<%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %>: artwork pending owner approval">Art pending</span><% } else if(selectedEquipment>=0) { %><span class="catalog-art fantasy-art equipment-art-51b equipment-art-51b-<%= selectedEquipment %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="equipment-51b-current-1"></span><% } else if(selectedProperty>=0) { %><span class="catalog-art property-art-51b property-art-51b-<%= selectedProperty %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="properties-51b"></span><% } else if(revisedProperty>=0) { %><span class="catalog-art property-art-49 property-art-49-<%= revisedProperty %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="properties-49"></span><% } else if (entry.illustration) { const art=entry.illustration; %><span class="catalog-art fantasy-art atlas-<%= art.atlas %> art-col-<%= art.column %> art-row-<%= art.row %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="<%= art.atlas %>"></span><% } else { %><img class="catalog-art<%= small?' art-small':'' %>" src="/assets/art/alpha/<%= entry.art %>.svg" width="76" height="76" alt="<%= entry.name %> illustration"><% } %>
