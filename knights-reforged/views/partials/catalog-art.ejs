<% const presentation=typeof presentationArt==='function'?presentationArt(entry):{entry,path:null,use:null};const artEntry=presentation.entry;
const selectedEquipment=['oathbound-greatsword','crown-of-ash-blade','eclipse-greatsword','sovereigns-bastion','eclipse-citadel-plate'].indexOf(artEntry.id);
const selectedProperty=['dawnspire-cathedral','wyrmcrest-keep','astral-observatory','throne-of-ash','eclipse-citadel','tempest-port'].indexOf(artEntry.id);
const revisedProperty=['wyrmcrest-keep','moonwell-sanctuary'].indexOf(artEntry.id);
const preparedArt=presentation.path??(typeof preparedExpansionArt==='function'?preparedExpansionArt(artEntry.id):typeof approvedExpansionArt==='function'?approvedExpansionArt(artEntry.id):null);
if(preparedArt) { %><img<% if(entry.presentationId) { %> data-presentation="<%= entry.presentationId??'' %>" data-art-source="<%= artEntry.id %>"<% } %> class="catalog-art expansion-art<%= small?' art-small':'' %>" src="<%= preparedArt %>" data-expansion-item="<%= entry.id %>" data-art-use="<%= presentation.use??(typeof expansionArtUse==='function'?expansionArtUse(artEntry.id):'unreviewed') %>" loading="lazy" decoding="async" width="76" height="76" alt="<%= entry.name %> illustration"><% } else if(artEntry.art?.startsWith('pending:')) { %><span<% if(entry.presentationId) { %> data-presentation="<%= entry.presentationId??'' %>" data-art-source="<%= artEntry.id %>"<% } %> class="catalog-art pending-art<%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %>: artwork pending owner approval">Art pending</span><% } else if(selectedEquipment>=0) { %><span<% if(entry.presentationId) { %> data-presentation="<%= entry.presentationId??'' %>" data-art-source="<%= artEntry.id %>"<% } %> class="catalog-art fantasy-art equipment-art-51b equipment-art-51b-<%= selectedEquipment %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="equipment-51b-current-1"></span><% } else if(selectedProperty>=0) { %><span<% if(entry.presentationId) { %> data-presentation="<%= entry.presentationId??'' %>" data-art-source="<%= artEntry.id %>"<% } %> class="catalog-art property-art-51b property-art-51b-<%= selectedProperty %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="properties-51b"></span><% } else if(revisedProperty>=0) { %><span<% if(entry.presentationId) { %> data-presentation="<%= entry.presentationId??'' %>" data-art-source="<%= artEntry.id %>"<% } %> class="catalog-art property-art-49 property-art-49-<%= revisedProperty %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="properties-49"></span><% } else if (artEntry.illustration) { const art=artEntry.illustration; %><span<% if(entry.presentationId) { %> data-presentation="<%= entry.presentationId??'' %>" data-art-source="<%= artEntry.id %>"<% } %> class="catalog-art fantasy-art atlas-<%= art.atlas %> art-col-<%= art.column %> art-row-<%= art.row %><%= small?' art-small':'' %>" role="img" aria-label="<%= entry.name %> illustration" data-art-atlas="<%= art.atlas %>"></span><% } else { %><img<% if(entry.presentationId) { %> data-presentation="<%= entry.presentationId??'' %>" data-art-source="<%= artEntry.id %>"<% } %> class="catalog-art<%= small?' art-small':'' %>" src="/assets/art/alpha/<%= artEntry.art %>.svg" width="76" height="76" alt="<%= entry.name %> illustration"><% } %>
