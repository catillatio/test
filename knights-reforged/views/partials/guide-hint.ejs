<% const help=step.id==='quest'&&state.mana<(alpha.quests[0]?.mana??0)?'Mana is recovering. Wait a little, or use Next Lesson in the options.':step.id==='land'&&!state.land.properties[0]?.maxAffordable?'Earn some gold from quests, then return to buy Land. You can keep reading the tutorial now.':step.id==='skills'&&!state.skillPoints?'Earn experience to gain skill points. You can finish the tutorial and spend points later.':step.id==='attack'&&(state.spirit<alpha.combat.spiritCost||state.health<alpha.combat.minimumHealth)?'Your Health or Stamina needs time to recover. Next Lesson lets you keep learning.':null; %>
<% if(help) { %><p class="guide-resource-hint" role="status"><%= help %></p><% } %>
