<% const hp=state.healing,payment=state.payment; %>
<section class="realm-resources" aria-label="Your character's resources" data-realm-state data-income-receipt="<%= state.incomeReceipt?.id??'' %>" data-character-id="<%= state.id %>" data-server-time="<%= state.serverTime %>" data-state-version="<%= state.stateVersion %>" data-income-next="<%= payment.nextAt??'' %>">
 <div class="resource-upper">
  <div class="gold-resource"><span class="gold">● <strong data-wallet-gold data-gold-digits="<%= String(state.gold).length %>"><%= state.gold.toLocaleString('en') %></strong></span>
   <details class="status-disclosure income-disclosure"><summary aria-label="Upcoming income breakdown"><span data-payment-gold data-flow="<%= payment.gold>0?'positive':payment.gold<0?'negative':'neutral' %>" class="payment-amount <%= payment.gold<0?'cost':'gold' %>"><%= payment.gold>0?'+':'' %><%= (Math.abs(payment.gold)>=1000000?new Intl.NumberFormat('en',{notation:'compact',maximumFractionDigits:1}).format(payment.gold):payment.gold.toLocaleString('en')) %></span> Gold · <time data-payment-countdown><%= payment.nextAt?'…':'No Land' %></time><span class="status-caret" aria-hidden="true">⌄</span></summary>
    <div class="status-panel" role="region" aria-label="Income breakdown"><h2>Your next payment</h2><dl><div><dt>Gross Land income</dt><dd data-payment-gross><%= payment.gross.toLocaleString('en') %></dd></div><div><dt>Property upkeep</dt><dd data-payment-property-upkeep><%= payment.propertyUpkeep.toLocaleString('en') %></dd></div><div><dt>Equipment upkeep due</dt><dd data-payment-equipment-upkeep><%= payment.equipmentUpkeep.toLocaleString('en') %></dd></div><div><dt>Already prepaid</dt><dd data-payment-prepaid><%= payment.prepaidUpkeep.toLocaleString('en') %></dd></div><div><dt>Net purse change</dt><dd data-payment-net><%= payment.gold.toLocaleString('en') %></dd></div><div><dt>Net after all upkeep</dt><dd data-payment-economic-net><%= payment.economicNet.toLocaleString('en') %></dd></div></dl><p>Next payment: <time data-payment-time datetime="<%= payment.nextAt??'' %>"><%= payment.nextAt?new Date(payment.nextAt).toLocaleString('en-GB',{timeZone:'UTC'}):'No Land owned' %></time> UTC</p><p class="field-hint">Based on current holdings and active upkeep through the next shared boundary. Prepaid upkeep is not deducted from your purse twice. <span data-payment-partial><%= payment.partial?'New holdings earn a prorated first period.':'' %></span></p><p class="field-hint">Retained in a full treasury: <span data-payment-retained><%= payment.retainedGold %></span> gold. One-time rewards are excluded.</p><p class="field-hint" data-payment-no-land<% if(payment.nextAt) { %> hidden<% } %>>Open Land from Home to start earning. Equipment upkeep still follows its normal policy.</p></div>
   </details>
  </div>
  <details class="status-disclosure xp-resource"><summary aria-label="Experience and next unlocks"><progress data-xp-meter max="<%= state.levelRequirement %>" value="<%= state.levelXp %>" aria-label="Experience toward next level"></progress><small>XP <span data-level-xp><%= state.levelXp %></span> / <span data-level-required><%= state.levelRequirement %></span> ⌄</small></summary><div class="status-panel" role="region" aria-label="Progress and unlocks"><h2>Your next chapter</h2><p><strong><%= state.skillPoints %></strong> unspent skill points.</p><p><strong data-xp-remaining><%= state.xpToNext %></strong> XP to the next level.</p><% if(state.nextUnlock) { %><p>Level <%= state.nextUnlock.level %> unlocks:</p><ul class="plain-list"><% for(const name of state.nextUnlock.names) { %><li><%= name %></li><% } %></ul><% } else { %><p>You have reached the current content summit. Your earned progression is preserved.</p><% } %><a href="/game/profile?tab=skills#skills" class="text-link">Character skills ›</a></div></details>
  <a href="/game/profile"><strong data-level><%= state.level %></strong><small>Level</small><span class="sr-only"><%= state.skillPoints %> unspent skill points</span></a>
 </div>
 <div class="resource-lower">
 <% for(const r of [{id:'health',name:'Health',icon:'♥',value:state.health,max:state.maxHealth,next:state.healthNextAt},{id:'mana',name:'Mana',icon:'●',value:state.mana,max:state.maxMana,next:state.manaNextAt},{id:'spirit',name:'Spirit',icon:'♨',value:state.spirit,max:state.maxSpirit,next:state.spiritNextAt}]) { %>
 <details class="status-disclosure resource-disclosure <%= r.id %>"><summary class="realm-resource <%= r.id %>" aria-label="<%= r.id==='health'?'Restore Health with gold':r.name+' recovery details' %>"><span class="stat-icon" aria-hidden="true"><%= r.icon %></span><span class="resource-reading"><strong><span data-resource-value="<%= r.id %>"><%= r.value %></span> / <span data-resource-max="<%= r.id %>"><%= r.max %></span></strong><small><%= r.name %> <time data-recovery="<%= r.id %>" data-next="<%= r.next??'' %>"><%= r.next?'…':'Full' %></time> ⌄</small><meter min="0" max="<%= r.max %>" value="<%= r.value %>" data-resource-meter="<%= r.id %>" aria-label="<%= r.name %>"><%= r.value %></meter></span></summary>
  <div class="status-panel" role="region" aria-label="<%= r.name %> details"><h2><%= r.name %></h2>
  <% if(r.id==='health') { %><dl><div><dt>Current Health</dt><dd><span data-heal-current><%= hp.health %></span> / <span data-heal-maximum><%= hp.maxHealth %></span></dd></div><div><dt>Missing</dt><dd data-heal-missing><%= hp.missing %></dd></div><div><dt>Restore cost</dt><dd class="gold"><span data-heal-cost><%= hp.cost.toLocaleString('en') %></span> gold</dd></div><div><dt>Available gold</dt><dd class="gold" data-wallet-gold><%= state.gold.toLocaleString('en') %></dd></div></dl><p class="field-hint">Missing Health × <span data-heal-unit><%= hp.unitCost %></span> gold. Each 10 character levels adds one gold per Health. Natural recovery remains free.</p><form method="post" action="/game/health/restore" data-heal-form><%- include('command-fields') %><input type="hidden" name="maxCost" value="<%= hp.cost %>"><button class="button button-gold" type="submit"<% if(!hp.missing||!hp.affordable) { %> disabled<% } %>>Heal Now</button></form><p data-heal-message role="status"><%= !hp.missing?'Your Health is full. No gold is charged.':!hp.affordable?'You need '+hp.shortfall+' more gold.':'Restore to maximum Health.' %></p>
  <% } else { %><p><%= r.id==='mana'?'Mana powers repeatable quests.':'Each attack spends Spirit. Defending does not cost Spirit.' %></p><p>One point recovers every <%= r.id==='mana'?state.calling.manaSeconds:state.calling.spiritSeconds %> seconds, including while offline. Your Calling and skill allocations are included.</p><a class="text-link" href="/game/profile?tab=skills#skills">Improve capacity ›</a><% } %></div>
 </details><% } %>
 </div>
</section>
