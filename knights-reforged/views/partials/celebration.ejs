<% const compactLevel=typeof compact!=='undefined'&&compact;const levelUp=reward?.celebration;const definitions=typeof experienceRules==='undefined'?[]:experienceRules.achievements;const newAwards=(reward?.newAchievements??[]).map(id=>definitions.find(a=>a.id===id)).filter(Boolean); %>
<% if(levelUp) { %><section class="level-celebration reward-celebration<%= compactLevel?' is-compact':'' %>" data-celebration-id="<%= identity %>-level" role="status" aria-labelledby="level-up-title"><% if(!compactLevel) { %><p class="eyebrow">A new chapter begins</p><% } %><h2 id="level-up-title"><%= compactLevel?'Congratulations — level up!':'LEVEL UP!' %></h2><strong class="celebration-level" data-reward-count="<%= levelUp.level %>"><%= levelUp.level %></strong><% if(!compactLevel) { %><p>You have reached <strong>Level <%= levelUp.level %>!</strong></p><% } %><p><strong class="gold"><%= levelUp.points %></strong> skill <%= levelUp.points===1?'point':'points' %> awarded</p><a class="button button-gold" href="/game/profile?tab=skills#skills">Spend Skill Points</a><% const unlocks=[{name:'Equipment',items:levelUp.equipment},{name:'Quests',items:levelUp.quests},{name:'Land',items:levelUp.land}].filter(group=>group.items?.length);if(unlocks.length) { %><details class="level-unlocks"><summary>New opportunities unlocked</summary><% for(const group of unlocks) { %><h3><%= group.name %></h3><ul><% for(const name of group.items) { %><li><%= name %></li><% } %></ul><% } %></details><% } %></section><% } %>
<% for(const definition of newAwards) { %><section class="achievement-toast reward-celebration" data-celebration-id="<%= identity %>-<%= definition.id %>" role="status"><%- include('achievement-emblem',{definition}) %><div><p class="eyebrow">Achievement awarded!</p><h3><%= definition.name %></h3><p><%= definition.description %></p><a href="/game/achievements">View your collection ›</a></div></section><% } %>
