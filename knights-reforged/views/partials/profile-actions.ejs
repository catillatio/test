<section class="panel profile-actions" data-combat-target="<%= character.id %>" aria-label="Opponent actions">
<p class="opponent-health">Health <strong data-target-health><%= character.health %></strong> / <span data-target-max-health><%= character.maxHealth %></span></p>
<meter data-target-meter min="0" max="<%= character.maxHealth %>" value="<%= character.health %>" aria-label="Opponent current Health"></meter>
<div class="opponent-actions">
<form method="post" action="/game/battle/attack" data-combat-form><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= character.id %>"><button class="button button-gold" type="submit" data-attack-ready="<%= combatTarget?.eligible?'true':'false' %>"<% if(!combatTarget?.allowed) { %> disabled<% } %>>Attack</button></form>
<a class="button button-outline bounty-action" href="/game/bounties/new?target=<%= character.id %>">Add to Bounty List</a>
</div>
<p class="compact-help combat-restriction" role="status" data-combat-restriction><%= combatTarget?.reason??'Each attack costs 1 Stamina. No repeat-attack cooldown.' %></p>
<% if(!bountyPlacement.allowed) { %><p class="field-hint bounty-eligibility">Bounty unavailable: <%= bountyPlacement.reason %></p><% } %>
<%- include('bounty-quotas',{quota:bountyPlacement.quotas??null,compact:true}) %>
</section>

<section class="profile-recruitment" aria-label="Army request">
<form method="post" action="/game/army/invite"><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= character.id %>"><button class="button button-outline" type="submit"<% if(!recruitment.allowed) { %> disabled<% } %>>Invite to Army</button></form>
<p class="field-hint"><%= recruitment.reason??(recruitment.automatic?'Development rival: immediately accepts a valid request and uses one army place.':'Send a persistent request. This player chooses whether to accept.') %><% if(recruitment.status==='declined') { %> Previous request declined or removed; normal re-invitation rules apply.<% } %></p>
</section>
