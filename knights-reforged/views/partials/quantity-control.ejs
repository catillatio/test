<% const selling=typeof tradeMode!=='undefined'&&tradeMode==='sell';const incomes=typeof incomeSteps!=='undefined'?incomeSteps:[]; %>
<div class="purchase-quantity" data-quantity-control data-purchase-type="<%= purchaseType %>" data-trade-mode="<%= selling?'sell':'buy' %>" data-definition-id="<%= entry.id %>" data-required-level="<%= entry.level %>" data-unit-price="<%= entry.price %>" data-cost-steps="<%= JSON.stringify(costSteps) %>" data-income-steps="<%= JSON.stringify(incomes) %>" data-max="<%= available %>"<% if(typeof ownedQuantity!=='undefined') { %> data-owned="<%= ownedQuantity %>" data-upkeep="<%= unitUpkeep %>"<% } %>>
<div class="quantity-stepper" role="group" aria-label="<%= selling?'Sell':'Buy' %> quantity for <%= entry.name %>"><button class="quantity-step" type="button" data-quantity-minus aria-label="Decrease quantity for <%= entry.name %>" disabled>−</button><input class="quantity" id="<%= controlId %>" name="quantity" type="number" min="1" max="<%= Math.max(1,available) %>" value="1" readonly inputmode="none" aria-label="<%= selling?'Sell':'Buy' %> quantity for <%= entry.name %>"><button class="quantity-step" type="button" data-quantity-plus aria-label="Increase quantity for <%= entry.name %>"<% if(available<2) { %> disabled<% } %>>+</button></div>
<div class="quantity-presets" role="group" aria-label="Quick quantities for <%= entry.name %>"><% for(const n of [1,5,10,'max']) { %><button type="button" data-quantity-preset="<%= n %>" aria-label="Select <%= n==='max'?'maximum':n %> <%= entry.name %>"<% if(available<(n==='max'?1:n)) { %> disabled<% } %>><%= n==='max'?'Max':n %></button><% } %></div>
<span class="quantity-total"><%= selling?'Return':'Total' %>: <strong class="gold" data-quantity-total><%= (costSteps[0]??(selling?0:entry.price)).toLocaleString('en') %></strong> gold</span><% if(typeof ownedQuantity!=='undefined') { const after=ownedQuantity+(selling?-1:1); %><span class="quantity-owned-projection">After: <strong data-quantity-owned><%= after %></strong> owned<% if(purchaseType==='equipment') { %> · <strong data-quantity-upkeep><%= (Math.max(0,after)*unitUpkeep).toLocaleString('en') %></strong>/hr when funded<% } %></span><% } %><% if(incomes.length) { %><span class="quantity-projection">Net after: <strong data-quantity-income><%= incomes[0].toLocaleString('en') %></strong> /hr</span><% } %></div>
