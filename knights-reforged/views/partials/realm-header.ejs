<header class="topbar">
  <a class="realm-brand" href="<%= state ? '/game/home' : '/login' %>" aria-label="Knights Reforged home">
    <img src="/assets/art/kingdoms-live/icon.png" width="32" height="32" alt="">
    <span>Knights Reforged<small>The First Realm</small></span>
  </a>
  <div class="account-menu">
    <% if (state) { %>
      <span class="account-name"><%= accountName %></span>
      <form method="post" action="/logout">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <button class="button-quiet" type="submit">Sign out</button>
      </form>
    <% } else { %>
      <a class="text-link" href="/rules">Realm rules</a>
    <% } %>
  </div>
</header>
