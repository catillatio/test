<% const land=type==='land';const ownedQuantity=land?entry.owned:(state.inventory.find(item=>item.id===entry.id)?.quantity??0);const unitUpkeep=land?entry.hourlyUpkeep:entry.upkeep; %>
<section class="panel market-bulk-panel" id="bulk-trade" aria-labelledby="bulk-title">
<div class="market-panel-heading"><span class="bulk-item-art"><%- include('catalog-art',{entry,small:false}) %></span><div class="bulk-item-heading"><h2 id="bulk-title"><%= entry.name %></h2><p>Owned <strong data-bulk-owned><%= ownedQuantity %></strong> · Gold <strong class="gold" data-bulk-gold><%= state.gold.toLocaleString('en') %></strong></p></div><a class="market-close" href="<%= land?'/game/land#property-'+entry.id:'/game/armory?category='+entry.category+'#item-'+entry.id %>" aria-label="Close bulk controls">Close ×</a></div>
<div class="bulk-mode-tabs" role="tablist" aria-label="Trade direction" data-bulk-tabs hidden><% for(const mode of ['buy','sell']) { %><button type="button" id="bulk-tab-<%= mode %>" role="tab" aria-selected="<%= mode==='buy'?'true':'false' %>" aria-controls="bulk-panel-<%= mode %>" tabindex="<%= mode==='buy'?'0':'-1' %>" data-bulk-mode-tab="<%= mode %>"><%= mode==='buy'?'Buy':'Sell' %></button><% } %></div>
<div class="bulk-trades"><% for(const mode of ['buy','sell']) { const buying=mode==='buy'; %>
<form id="bulk-panel-<%= mode %>" data-bulk-mode="<%= mode %>" method="post" action="/game/<%= land?'land':'armory' %>/<%= mode %>"><%- include('command-fields') %><input type="hidden" name="<%= land?'propertyId':'itemId' %>" value="<%= entry.id %>">
<%- include('quantity-control',{purchaseType:type,tradeMode:mode,entry,available:buying?availableBuy:availableSell,controlId:'bulk-'+mode+'-'+entry.id,ownedQuantity,unitUpkeep,costSteps:buying?buyCosts:sellCosts,incomeSteps:land?(buying?entry.projectedBuyNetSteps:entry.projectedSaleNetSteps):[]}) %>
<button class="button <%= buying?'button-gold':'button-outline' %>" type="submit" aria-label="<%= buying?'Buy':'Sell' %> selected <%= entry.name %>"<% if((buying?availableBuy:availableSell)<1) { %> disabled<% } %>><%= buying?'Buy':'Sell' %> selected</button>
</form><% } %></div>
</section>
