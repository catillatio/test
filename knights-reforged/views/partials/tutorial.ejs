<% if(typeof experience!=='undefined'&&experience&&!['tutorial','home'].includes(screen)&&(experience.tutorial.status==='active'||experience.tutorial.replaying)) { const guide=experience.tutorial;const position=guide.position??1;const step=guide.steps[position-1]; %>
<% if(step) { %><aside class="tutorial-panel contextual-guide" aria-label="Tutorial" data-guide-target="<%= step.target %>"><a class="eyebrow" href="/game/tutorial">Tutorial · Step <%= position %> of 8<%= guide.replaying?' · Replay':'' %></a><h2><%= step.name %></h2><p id="tutorial-instruction"><%= step.help %></p><% if(step.done) { %><p class="guide-done">✓ Already done — no need to repeat it.</p><% } %><%- include('guide-hint',{step}) %><%- include('guide-actions',{step,position}) %><% if(step.id==='automatic') { %><%- include('guide-calling') %><% } %></aside><% } %>
<% } %>
