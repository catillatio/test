<% if(typeof experience!=='undefined'&&experience&&experience.tutorial.status==='active') { const step=experience.tutorial.steps.find(step=>!step.done); %><aside class="tutorial-panel" aria-label="Quick adventure guide"><div><span class="eyebrow">Your first adventure · <%= experience.tutorial.completed %>/8</span><h2><%= step?.name??'Your adventure continues' %></h2><p><%= step?.help??'You have learned the essentials. The realm is yours.' %></p><% if(step) { %><a class="text-link tutorial-next" href="<%= step.href %>">Show me ›</a><% } %></div><form method="post" action="/game/tutorial"><%- include('command-fields') %><input type="hidden" name="action" value="skip"><button class="tutorial-skip" type="submit">Skip guide</button></form></aside><% } %>
