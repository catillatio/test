<% if(typeof experience!=='undefined'&&experience&&!['tutorial','home'].includes(screen)&&(experience.tutorial.status==='active'||experience.tutorial.replaying)) { const guide=experience.tutorial;const position=guide.position??Math.max(1,guide.steps.findIndex(step=>!step.done)+1);const step=guide.steps[position-1]; %>
<% if(step) { %><aside class="tutorial-panel contextual-guide" aria-label="Adventure guide"><div><a class="eyebrow" href="/game/tutorial">Tutorial · Step <%= position %> of 8<%= guide.replaying?' · Replay':'' %></a><h2><%= step.name %></h2><p><%= step.help %></p><% if(step.done) { %><p class="guide-done">✓ Already done — no need to repeat it.</p><% } %><a class="button button-gold tutorial-next" href="<%= step.href %>" data-guide-destination="<%= step.target??'' %>">Show Me</a>
<div class="guide-controls"><% if(position>1) { %><form method="post" action="/game/tutorial"><%- include('command-fields') %><input type="hidden" name="action" value="back"><button class="tutorial-skip" type="submit">Back</button></form><% } %><form method="post" action="/game/tutorial"><%- include('command-fields') %><input type="hidden" name="action" value="<%= position===8?'finish':'next' %>"><button class="tutorial-skip" type="submit"><%= position===8?'Finish Tutorial':'Next' %></button></form><form method="post" action="/game/tutorial"><%- include('command-fields') %><input type="hidden" name="action" value="skip"><button class="tutorial-skip" type="submit">Skip for now</button></form></div></div></aside><% } %>
<% } %>
