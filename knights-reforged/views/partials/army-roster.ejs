<section class="panel"><h2 class="strip-title">Allies and invitations</h2><% if (!state.army.links.length) { %><p>Your roster is waiting for its first ally.</p><% } %>
<% for (const link of state.army.links) { %><div class="ally-row"><div><a class="player-link" href="/game/players/<%= link.characterId %>"><%= link.name %></a><span>Level <%= link.level %> <%= link.className %></span><small><%= link.status==='accepted'?'Ally':link.incoming?'Incoming invitation':'Invitation sent' %></small></div><div class="ally-actions"><% if (link.status==='pending'&&link.incoming) { %><form method="post" action="/game/army/accept"><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= link.characterId %>"><button class="button button-gold" type="submit" aria-label="Accept <%= link.name %>">Accept</button></form><form method="post" action="/game/army/reject"><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= link.characterId %>"><button class="button button-outline" type="submit" aria-label="Reject <%= link.name %>">Reject</button></form><% } %><% if(link.status==='accepted'||!link.incoming) { %><form method="post" action="/game/army/remove"><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= link.characterId %>"><button class="button button-outline" type="submit" aria-label="Remove <%= link.name %>"><%= link.status==='accepted'?'Remove':'Cancel' %></button></form><% } %></div></div><% } %></section>
