<% if(quota) { %><div class="compact-help bounty-quota-status" data-bounty-quotas role="status"><p>Your placements on this target: <strong><%= quota.sponsorTarget.remaining %> / <%= quota.sponsorTarget.limit %> remaining</strong>. All sponsors on this target: <strong><%= quota.target.remaining %> / <%= quota.target.limit %> remaining</strong> in the rolling 24 hours.</p>
<% for(const [bucket,label] of [[quota.sponsorTarget,'Your sponsor-target limit'],[quota.target,'The target-wide limit']]) { if(bucket.nextAvailableAt) { %><p><%= label %> next permits a placement at <time datetime="<%= bucket.nextAvailableAt %>"><%= new Date(bucket.nextAvailableAt).toLocaleString('en-GB',{timeZone:'UTC'}) %> UTC</time>, subject to a fresh server check.</p><% }} %>
<% if(typeof compact==='undefined'||!compact) { %><p>Claims, cancellations and expirations still count. No midnight reset or additional relisting cooldown. One active contract per target. Counts are checked again on confirmation.</p><% } %></div><% } %>
