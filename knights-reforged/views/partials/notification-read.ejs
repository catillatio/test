<% if(typeof notifications!=='undefined'&&notifications.events.length) { %><form method="post" action="/game/notifications/read" class="notification-read-form"><%- include('command-fields') %><input type="hidden" name="events" value="<%= JSON.stringify(notifications.events) %>"><input type="hidden" name="returnTo" value="<%= screen==='report'?'/game/battles/'+battle.id:screen==='profile'?'/game/profile?tab=comments':'/game/home' %>"><button class="button button-outline" type="submit">Mark shown events read</button><small>Only the attacks and comments displayed on this page.</small></form><% } %>
