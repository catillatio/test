<% if(typeof notifications!=='undefined'&&notifications.events.length) { %><form method="post" action="/game/notifications/read" class="notification-read-form"><%- include('command-fields') %><input type="hidden" name="events" value="<%= JSON.stringify(notifications.events) %>"><input type="hidden" name="returnTo" value="<%= screen==='report'?'/game/battles/'+battle.id:screen==='profile'?'/game/profile?tab=comments':screen==='bounties'?'/game/bounties':screen==='army'?'/game/army?tab=dashboard':'/game/home' %>"><button class="button button-outline" type="submit">Mark shown events read</button><small>Only the personal events displayed on this page.</small></form><% } %>

<% if(typeof readBatchId==='string'&&notifications.home>0) { %><div class="personal-notification-tools"><a class="text-link" href="/game/notifications">View <%= notifications.home %> unread personal events ›</a><form method="post" action="/game/notifications/read-all"><%- include('command-fields') %><input type="hidden" name="batchId" value="<%= readBatchId %>"><button class="button button-outline button-small" type="submit">Mark all current personal events as read</button></form></div><% } %>
<p class="notification-read-status" data-notification-read-status role="status" hidden>Viewed events could not be marked read. <button class="button button-outline button-small" type="button" data-notification-read-retry>Retry</button> If your session changed, reload this page.</p>
