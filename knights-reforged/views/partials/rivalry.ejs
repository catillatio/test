<% if(typeof rivalry!=='undefined'&&rivalry) { %><section class="panel rivalry-panel" id="rivalry" aria-labelledby="rivalry-title"><h2 class="profile-section-heading" id="rivalry-title">Your Rivalry</h2>
<p class="rivalry-heading">You and <a class="player-link" href="/game/players/<%= character.id %>"><%= character.name %></a></p>
<dl class="rivalry-stats"><div><dt>Encounters</dt><dd><%= rivalry.encounters??'–' %></dd></div><div><dt>Attacks / defenses</dt><dd><%= rivalry.attacksInitiated??'–' %> / <%= rivalry.defensiveEncounters??'–' %></dd></div><div><dt>Your kills / deaths</dt><dd><%= rivalry.kills??'–' %> / <%= rivalry.deaths??'–' %></dd></div><div><dt>Your victories</dt><dd><%= rivalry.wins %></dd></div><div><dt>Their victories</dt><dd><%= rivalry.losses %></dd></div><div><dt>Gold stolen by you</dt><dd class="gold"><%= BigInt(rivalry.goldTaken).toLocaleString('en') %></dd></div><div><dt>Gold stolen from you</dt><dd><%= BigInt(rivalry.goldLost).toLocaleString('en') %></dd></div><div><dt>Your bounty claims</dt><dd><%= rivalry.bountiesClaimed %></dd></div><div><dt>Their bounty claims</dt><dd><%= rivalry.bountiesLost %></dd></div></dl>
<% if(rivalry.unrecordedGold!=='0') { %><p class="field-hint"><%= rivalry.unrecordedGold %> older encounter(s) did not record a verifiable gold transfer. Gold totals include only supported records; bounty rewards are separate.</p><% } %>
<h3 class="rivalry-subheading">Last five encounters</h3><% if(!rivalry.battles.length) { %><p class="compact-help">Your banners have not met in battle yet.</p><% } %>
<ol class="rivalry-encounters"><% for(const encounter of rivalry.battles) { %><li><%- include('outcome',{won:encounter.won}) %><p><a class="player-link" href="/game/players/<%= encounter.attackerId %>"><%= encounter.attackerName %></a> attacked <a class="player-link" href="/game/players/<%= encounter.defenderId %>"><%= encounter.defenderName %></a></p><% if(encounter.bountyId) { %><small>Bounty claimed by <%= encounter.claimantId===state.id?'you':character.name %></small><% } %><time datetime="<%= encounter.createdAt %>"><%= relativeTime(encounter.createdAt,state.serverTime) %></time><a class="text-link" href="/game/battles/<%= encounter.id %>">View Battle ›</a></li><% } %></ol>
<form method="post" action="/game/battle/attack"><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= character.id %>"><button class="button button-gold" type="submit"<% if(!combatTarget?.allowed) { %> disabled<% } %>>Challenge <%= character.name %></button></form><% if(combatTarget?.reason) { %><p class="field-hint"><%= combatTarget.reason %></p><% } %>
</section><% } %>
