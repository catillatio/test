<details class="bounty-placement"><summary>Place bounty</summary><form method="post" action="/game/bounties/preview"><%- include('command-fields') %><input type="hidden" name="targetCharacterId" value="<%= target.id %>"><label for="bounty-<%= target.id %>">Bounty gold (1–10,000)</label><input id="bounty-<%= target.id %>" name="amount" type="number" inputmode="numeric" min="1" max="10000" value="1" required><small>Listing fee: 10%, rounded up, minimum 1 gold. Review the exact total before confirming. Refunds return the bounty; the fee is retained.</small><button class="button button-outline" type="submit" aria-label="Place bounty on <%= target.name %>">Place</button></form></details>
