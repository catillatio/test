<details open class="encounter-equipment <%= enemy?'enemy-equipment':'own-equipment' %>" aria-label="<%= heading %>">
<summary><span><%= enemy?'Their army':'Your army' %><% if(typeof participants==='number') { %> of <%= participants %><% } %> used</span><span class="equipment-chevron" aria-hidden="true">▾</span></summary>
<p class="equipment-owner"><a class="player-link" href="/game/players/<%= ownerId %>"><%= ownerName %></a><% if(typeof participants==='number') { %><span class="sr-only"> · <%= participants %> participating army members</span><% } %></p>
<% if(Array.isArray(equipment)) { %>
<% const first=[],remaining=[],categories=new Set();for(const used of equipment){const recordedCategory=used.category??alpha.items.find(item=>item.id===used.itemId)?.category;const category=['weapon','armor','spell'].includes(recordedCategory)?recordedCategory:'other';(categories.has(category)?remaining:first).push(used);categories.add(category);} %>
<%- include('battle-used-items',{entries:first,heading}) %>
<% if(remaining.length) { %><details class="additional-equipment"><summary>See <%= remaining.length %> more equipment <%= remaining.length===1?'type':'types' %></summary><%- include('battle-used-items',{entries:remaining,heading:heading+' additional equipment'}) %></details><% } %>
<% if(!equipment.length) { %><p class="compact-help">No equipment contributed to this battle.</p><% } %>
<% } else { %><p class="compact-help">Equipment quantities were not recorded in this historical battle.</p><% } %>
</details>
