<section class="champions-intro"><svg class="champions-crown" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-finish1#champions"></use></svg><p>Lifetime honors · Human players</p></section>
<nav class="champion-tabs" aria-label="Champion categories"><% for(const category of championCategories) { %><a href="/game/champions?category=<%= category.id %>" aria-label="<%= category.name %>"<% if(champions.category.id===category.id) { %> aria-current="page"<% } %>><%= ({victories:'Victories',bounties:'Hunters',land:'Land',level:'Level'})[category.id] %></a><% } %></nav>
<section class="panel champions-panel" aria-labelledby="champion-title"><h2 class="strip-title" id="champion-title"><%= champions.category.name %></h2>
<% if(champions.own) { %><p class="your-standing" role="status">Your place: <strong>#<%= formatStanding(champions.own.rank) %></strong> · <strong><%= formatStanding(champions.own.score) %></strong> <%= champions.category.unit %></p><% } else { %><p class="your-standing">Your place: Unranked · <%= champions.category.id==='victories'?'Win your first battle to join this hall.':champions.category.id==='bounties'?'Claim a bounty to join these hunters.':'Buy Land to establish your kingdom.' %></p><% } %>
<div class="champion-columns" aria-hidden="true"><span>#</span><span>Player</span><span><%= champions.category.unit %></span></div><ol class="champion-list" aria-label="Top twenty champions"><% for(const champion of champions.entries) { %><li class="champion-row champion-place-<%= champion.rank %><%= champion.self?' is-self':'' %>"<% if(champion.self) { %> aria-current="true"<% } %>><span class="champion-rank" aria-label="Rank <%= champion.rank %>"><%= champion.rank===1?'♛':champion.rank %></span><div><a class="player-link" href="/game/players/<%= champion.id %>"><span class="champion-name"><%= champion.name %><% if(champion.self) { %><small>You</small><% } %></span><small class="champion-level">Level <%= champion.level %></small><% if(champion.xp!==undefined) { %><small><%= formatStanding(champion.xp) %> total XP</small><% } %></a></div><strong class="champion-score"><%= formatStanding(champion.score) %><small><%= champions.category.unit %></small></strong></li><% } %></ol>
<% if(!champions.entries.length) { %><div class="empty-state"><p>No champions in this category yet. Your first deed could begin its history.</p><a class="button button-outline" href="/game/battle">Find a rival</a></div><% } %>
<details class="champion-rules"><summary>How places are decided</summary><p class="compact-help"><%= champions.category.help %></p><p class="compact-help">Lifetime records only. Ties use the earlier character creation date, then a stable character order. Highest Level compares total XP first. The top twenty are shown; your own place can be lower. Temporary rivals and unavailable accounts are excluded. Rankings grant no gold or XP.</p></details></section>
<a class="button button-outline" href="/game/battle">Return to Battle</a>
