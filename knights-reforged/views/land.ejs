<div data-land-screen data-server-time="<%= state.serverTime %>" data-next-payment="<%= state.land.nextPaymentAt??'' %>">
<section class="panel land-income-panel" aria-labelledby="land-income-title">
<details class="gold-flow" open><summary class="land-flow-head"><h2 id="land-income-title"><svg class="flow-icon" width="24" height="24" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-mockup2#coins"></use></svg> Gold Flow <small class="flow-unit">Hourly</small></h2><span class="flow-caret" aria-hidden="true">⌄</span><span class="sr-only" data-land-net aria-hidden="true"><%= state.economy.netHourlyIncome %></span></summary>
<div class="land-flow-body"><dl class="flow-grid">
<div><dt>Property Income</dt><dd><span data-land-gross><%= state.economy.grossHourlyIncome.toLocaleString('en') %></span><small> / hour</small></dd></div>
<div><dt>Property Upkeep</dt><dd class="gold"><span data-land-upkeep><%= state.economy.propertyUpkeep.toLocaleString('en') %></span><small> / hour</small></dd></div>
<div><dt>Equipment Upkeep</dt><dd><span data-equipment-upkeep><%= state.economy.equipmentUpkeep.toLocaleString('en') %></span><small> / hour</small></dd></div>
<div><dt>Net Hourly Income</dt><dd class="gold"><span data-land-net-detail><%= state.economy.netHourlyIncome.toLocaleString('en') %></span><small> / hour</small></dd></div>
</dl><div class="land-payment-row"><span>Next Payment</span><strong class="land-countdown gold" role="timer" data-land-countdown><%= state.land.nextPaymentAt?'Calculating…':'No Land' %></strong><time data-land-payment-time datetime="<%= state.land.nextPaymentAt??'' %>"><%= state.land.nextPaymentAt?new Date(state.land.nextPaymentAt).toLocaleTimeString('en-GB',{timeZone:'UTC',hour:'2-digit',minute:'2-digit'})+' UTC':'Buy a property to start earning.' %></time></div></div>
<details class="income-explanation"><summary>Payment details &amp; marketplace rules <span aria-hidden="true">⌄</span></summary><p class="field-hint"><strong data-next-property-payment><%= Number(state.land.nextPropertyPaymentGold??0).toLocaleString('en') %></strong> property gold at the next boundary, after property upkeep, before separately accrued equipment upkeep. <span data-partial-payment><%= state.land.partialNextPayment?'Includes a prorated first period.':'' %></span></p><p class="field-hint">Net/hour measures Land income minus all active upkeep. Equipment charges use your prepaid reserve first; wallet changes can differ while that reserve is being used. The reserve and charged amounts remain in the financial journal.</p><p class="field-hint">Each additional property of the same type costs 10% more. Bulk purchases use successive prices. Sell returns half each recorded cost; earned partial time is settled before selling.</p></details>
</details><p class="field-hint land-sync-note" data-land-status role="status">Shared hourly cycle · Offline income included</p><p class="field-hint" data-land-pending<% if (state.land.pendingGold==='0') { %> hidden<% } %>>Treasury full: <span data-land-pending-gold><%= BigInt(state.land.pendingGold).toLocaleString('en') %></span> retained gold will be released as you make room.</p><noscript><p>Return to this page after the UTC payment time to see settled income. Offline income is preserved.</p></noscript>
</section>
<% if (state.maintenance.paused) { %><p class="compact-help warning">Equipment upkeep is paused. The displayed net excludes its suspended <%= state.maintenance.hourlyRate %> gold/hour bill. <a href="/game/armory">Resume in Armory ›</a></p><% } %>
<% const bulk=typeof marketBulkId==='string'?state.land.properties.find(p=>p.id===marketBulkId):null;if(bulk) { %>
<%- include('partials/market-bulk',{entry:bulk,type:'land',availableBuy:bulk.unlocked?bulk.maxAffordable:0,availableSell:bulk.maxSell,buyCosts:bulk.priceSteps.map((_,i)=>bulk.priceSteps.slice(0,i+1).reduce((n,p)=>n+p,0)),sellCosts:bulk.saleRefundSteps}) %><% } %>
<div class="catalog land-properties market-catalog" aria-label="Property marketplace">
<% for (const property of state.land.properties) { const unlocked=state.level>=property.level;const available=unlocked?property.maxAffordable:0; %>
<article class="catalog-row land-property" id="property-<%= property.id %>" data-land-property="<%= property.id %>" data-price-steps="<%= JSON.stringify(property.priceSteps) %>">
<span class="property-art-frame"><%- include('partials/land-review-art',{entry:property}) %></span>
<div class="catalog-description"><h2><%= property.name %></h2><span>Income: <strong class="gold"><%= property.hourlyIncome.toLocaleString('en') %></strong> / hour</span><div class="catalog-more"><span>Upkeep: <strong class="gold"><%= property.hourlyUpkeep.toLocaleString('en') %></strong> / hour</span><%- include('partials/market-link',{entry:property,type:'land'}) %></div><% if(!unlocked) { %><span class="warning">Level <%= property.level %> required</span><% } %></div>
<div class="catalog-trade"><div class="price-owned"><strong class="gold"><svg class="coin-icon" width="25" height="25" aria-hidden="true"><use href="/assets/art/remaster-ui/icons.svg?v=phase48-mockup2#coins"></use></svg> <span data-land-unit-price><%= property.price.toLocaleString('en') %></span></strong><span>Owned: <strong data-land-owned><%= property.owned %></strong></span></div>
<%- include('partials/market-trade',{entry:property,type:'land',availableBuy:available,availableSell:property.maxSell,refund:property.saleRefundSteps[0]??0}) %></div>
<p class="sr-only" data-land-buy-hint><%= !unlocked?'Unlock at level '+property.level:property.remaining===0?'Ownership limit reached.':!available?'Earn more gold to buy.':'Joins the shared hourly cycle; first partial period is prorated.' %></p>
</article><% } %></div>
<details class="panel land-holdings-panel"><summary>Your holdings and payment times</summary><ul class="plain-list"><% for (const holding of state.land.holdings) { %><li><strong><%= holding.name %> ×<%= holding.quantity %></strong> · <%= holding.hourlyIncome-holding.hourlyUpkeep %> gold/hour<time datetime="<%= holding.nextPaymentAt %>" data-holding-payment="<%= holding.id %>"><%= holding.nextPaymentAt %></time></li><% } %><% if (!state.land.holdings.length) { %><li>No property owned.</li><% } %></ul></details>
</div><script type="module" src="/assets/land.js?v=<%= alpha.id %>-phase48-stage1"></script>
