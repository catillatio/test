<div data-land-screen data-server-time="<%= state.serverTime %>" data-next-payment="<%= state.land.nextPaymentAt??'' %>">
<section class="panel land-income-panel" aria-labelledby="land-income-title"><h2 class="strip-title" id="land-income-title">Gold flow</h2>
<dl class="flow-grid"><div><dt>Property income</dt><dd class="gold"><span data-land-gross><%= state.economy.grossHourlyIncome %></span> / hour</dd></div><div><dt>Property upkeep</dt><dd><span data-land-upkeep><%= state.economy.propertyUpkeep %></span> / hour</dd></div><div><dt>Equipment upkeep</dt><dd><span data-equipment-upkeep><%= state.economy.equipmentUpkeep %></span> / hour</dd></div><div><dt>Net hourly income</dt><dd class="gold"><span data-land-net><%= state.economy.netHourlyIncome %></span> / hour</dd></div></dl>
<div class="land-payment-row"><div><span class="muted">Next income payment</span><strong class="land-countdown" role="timer" data-land-countdown><%= state.land.nextPaymentAt?'Calculating…':'No property owned' %></strong><time data-land-payment-time datetime="<%= state.land.nextPaymentAt??'' %>"><%= state.land.nextPaymentAt??'Buy a property to start earning.' %></time></div></div>
<details class="income-explanation"><summary>Payment details &amp; marketplace rules ▾</summary><p class="field-hint"><strong data-next-property-payment><%= Number(state.land.nextPropertyPaymentGold??0).toLocaleString('en') %></strong> property gold at the next boundary, after property upkeep, before separately accrued equipment upkeep. <span data-partial-payment><%= state.land.partialNextPayment?'Includes a prorated first period.':'' %></span></p><p class="field-hint">Net/hour measures Land income minus all active upkeep. Equipment charges use your prepaid reserve first; wallet changes can differ while that reserve is being used. The reserve and charged amounts remain in the financial journal.</p><p class="field-hint"><strong>Reconstructed alpha economy.</strong> Each additional property of the same type costs 10% more. Bulk purchases use successive prices. Sell returns half each recorded cost; earned partial time is settled before selling.</p></details><p class="field-hint" data-land-status role="status">Shared hourly cycle · Offline income included</p><p class="field-hint" data-land-pending<% if (state.land.pendingGold==='0') { %> hidden<% } %>>Treasury full: <span data-land-pending-gold><%= BigInt(state.land.pendingGold).toLocaleString('en') %></span> retained gold will be released as you make room.</p><noscript><p>Return to this page after the UTC payment time to see settled income. Offline income is preserved.</p></noscript>
</section>
<% if (state.maintenance.paused) { %><p class="compact-help warning">Equipment upkeep is paused. The displayed net excludes its suspended <%= state.maintenance.hourlyRate %> gold/hour bill. <a href="/game/armory">Resume in Armory ›</a></p><% } %>
<div class="catalog land-properties">
<% for (const property of state.land.properties) { const unlocked=state.level>=property.level;const available=property.maxAffordable; %>
<article class="catalog-row land-property" id="property-<%= property.id %>" data-land-property="<%= property.id %>" data-price-steps="<%= JSON.stringify(property.priceSteps) %>">
<%- include('partials/catalog-art',{entry:property,small:false}) %>
<div class="catalog-description"><h2><%= property.name %></h2><small class="catalog-tier"><%= property.tier??'' %></small><span>Income: <strong class="gold"><%= property.hourlyIncome %></strong> / hour</span><span>Upkeep: <%= property.hourlyUpkeep %> / hour</span><% if (!unlocked) { %><span class="warning">Level <%= property.level %> required</span><% } %></div>
<div class="catalog-trade"><div class="price-owned"><strong class="gold">● <span data-land-unit-price><%= property.price.toLocaleString('en') %></span></strong><span>Owned: <strong data-land-owned><%= property.owned %></strong></span></div>
<div class="trade-actions">
<form method="post" action="/game/land/buy" class="land-buy-form"><%- include('partials/command-fields') %><input type="hidden" name="propertyId" value="<%= property.id %>"><%- include('partials/quantity-control',{purchaseType:'land',entry:property,available:unlocked?available:0,controlId:'land-quantity-'+property.id,incomeSteps:property.projectedBuyNetSteps,costSteps:property.priceSteps.map((_,i)=>property.priceSteps.slice(0,i+1).reduce((n,p)=>n+p,0))}) %><button class="button button-gold" type="submit" aria-label="Buy <%= property.name %>"<% if (!available||!unlocked) { %> disabled<% } %>>Buy</button></form>
<form method="post" action="/game/land/sell" data-land-sell><%- include('partials/command-fields') %><input type="hidden" name="propertyId" value="<%= property.id %>"><%- include('partials/quantity-control',{purchaseType:'land',tradeMode:'sell',entry:property,available:property.maxSell,controlId:'land-sell-'+property.id,costSteps:property.saleRefundSteps,incomeSteps:property.projectedSaleNetSteps}) %><button class="button button-outline" type="submit" aria-label="Sell <%= property.name %>"<% if(!property.owned) { %> disabled<% } %>>Sell</button></form>
</div></div><p class="land-row-hint field-hint" data-land-buy-hint><%= !unlocked?'Unlock at level '+property.level:property.remaining===0?'Ownership limit reached.':!available?'Earn more gold to buy.':'Joins the shared hourly cycle; first partial period is prorated.' %></p>
</article><% } %></div>
<details class="panel land-holdings-panel"><summary>Your holdings and payment times</summary><ul class="plain-list"><% for (const holding of state.land.holdings) { %><li><strong><%= holding.name %> ×<%= holding.quantity %></strong> · <%= holding.hourlyIncome-holding.hourlyUpkeep %> gold/hour<time datetime="<%= holding.nextPaymentAt %>" data-holding-payment="<%= holding.id %>"><%= holding.nextPaymentAt %></time></li><% } %><% if (!state.land.holdings.length) { %><li>No property owned.</li><% } %></ul></details>
</div><script type="module" src="/assets/land.js?v=<%= alpha.id %>-phase47-1"></script>
