<div data-land-screen data-server-time="<%= state.serverTime %>" data-next-payment="<%= state.land.nextPaymentAt??'' %>">
<section class="panel land-income-panel" aria-labelledby="land-income-title"><h2 class="strip-title" id="land-income-title">Gold flow</h2>
<dl class="flow-grid"><div><dt>Property income</dt><dd class="gold"><span data-land-gross><%= state.economy.grossHourlyIncome %></span> / hour</dd></div><div><dt>Property upkeep</dt><dd><span data-land-upkeep><%= state.economy.propertyUpkeep %></span> / hour</dd></div><div><dt>Equipment upkeep</dt><dd><span data-equipment-upkeep><%= state.economy.equipmentUpkeep %></span> / hour</dd></div><div><dt>Net hourly income</dt><dd class="gold"><span data-land-net><%= state.economy.netHourlyIncome %></span> / hour</dd></div></dl>
<div class="land-payment-row"><div><span class="muted">Next income payment</span><strong class="land-countdown" role="timer" data-land-countdown><%= state.land.nextPaymentAt?'Calculating…':'No property owned' %></strong><time data-land-payment-time datetime="<%= state.land.nextPaymentAt??'' %>"><%= state.land.nextPaymentAt??'Buy a property to start earning.' %></time></div><a class="button button-outline" href="/game/land">Refresh income</a></div>
<p class="field-hint" data-land-status role="status">Each purchase earns after one full hour, including completed offline hours.</p><p class="field-hint" data-land-pending<% if (state.land.pendingGold==='0') { %> hidden<% } %>>Treasury full: <span data-land-pending-gold><%= BigInt(state.land.pendingGold).toLocaleString('en') %></span> retained gold will be released as you make room.</p><noscript><p>Refresh after the UTC payment time to collect income.</p></noscript>
</section>
<p class="compact-help"><strong>Reconstructed alpha economy.</strong> Each additional property of the same type costs 10% more. Bulk purchases use successive prices. Sell returns half each recorded cost; sold units forfeit their unfinished hour.</p>
<% if (state.maintenance.paused) { %><p class="compact-help warning">Equipment upkeep is paused. The displayed net excludes its suspended <%= state.maintenance.hourlyRate %> gold/hour bill. <a href="/game/armory">Resume in Armory ›</a></p><% } %>
<div class="catalog land-properties">
<% for (const property of state.land.properties) { const unlocked=state.level>=property.level;const available=property.maxAffordable; %>
<article class="catalog-row land-property" data-land-property="<%= property.id %>" data-price-steps="<%= JSON.stringify(property.priceSteps) %>">
<img class="catalog-art" src="/assets/art/alpha/<%= property.art %>.svg" width="76" height="76" alt="<%= property.name %> illustration">
<div class="catalog-description"><h2><%= property.name %></h2><span>Income: <strong class="gold"><%= property.hourlyIncome %></strong> / hour</span><span>Upkeep: <%= property.hourlyUpkeep %> / hour</span><% if (!unlocked) { %><span class="warning">Level <%= property.level %> required</span><% } %></div>
<div class="catalog-trade"><div class="price-owned"><strong class="gold">● <span data-land-unit-price><%= property.price.toLocaleString('en') %></span></strong><span>Owned: <strong data-land-owned><%= property.owned %></strong></span></div>
<div class="trade-actions">
<form method="post" action="/game/land/buy" class="land-buy-form"><%- include('partials/command-fields') %><input type="hidden" name="propertyId" value="<%= property.id %>"><label class="sr-only" for="land-quantity-<%= property.id %>">Buy quantity for <%= property.name %></label><input class="quantity" id="land-quantity-<%= property.id %>" name="quantity" type="number" inputmode="numeric" min="1" max="<%= Math.max(1,available) %>" value="1" required<% if (!available||!unlocked) { %> disabled<% } %>><button class="button button-gold" type="submit" aria-label="Buy <%= property.name %>"<% if (!available||!unlocked) { %> disabled<% } %>>Buy</button></form>
<form method="post" action="/game/land/sell" data-land-sell><%- include('partials/command-fields') %><input type="hidden" name="propertyId" value="<%= property.id %>"><label class="sr-only" for="land-sell-<%= property.id %>">Sell quantity for <%= property.name %></label><input class="quantity" id="land-sell-<%= property.id %>" name="quantity" type="number" inputmode="numeric" min="1" max="<%= Math.max(1,Math.min(25,property.owned)) %>" value="1" required><button class="button button-outline" type="submit" aria-label="Sell <%= property.name %>"<% if (!property.owned) { %> disabled<% } %>>Sell</button></form>
</div></div><p class="land-row-hint field-hint" data-land-buy-hint><%= !unlocked?'Unlock at level '+property.level:property.remaining===0?'Ownership limit reached.':!available?'Earn more gold to buy.':'First payment after a full hour.' %></p>
</article><% } %></div>
<details class="panel land-holdings-panel"><summary>Your holdings and payment times</summary><ul class="plain-list"><% for (const holding of state.land.holdings) { %><li><strong><%= holding.name %> ×<%= holding.quantity %></strong> · <%= holding.hourlyIncome-holding.hourlyUpkeep %> gold/hour<time datetime="<%= holding.nextPaymentAt %>" data-holding-payment="<%= holding.id %>"><%= holding.nextPaymentAt %></time></li><% } %><% if (!state.land.holdings.length) { %><li>No property owned.</li><% } %></ul></details>
</div><script type="module" src="/assets/land.js"></script>
