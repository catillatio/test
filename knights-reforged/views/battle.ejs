<nav class="category-tabs" aria-label="Battle categories"><a href="/game/battle" aria-current="page">Attack Rivals</a><a href="/game/bounties"><span class="bounty-label">Bounty List (<span data-bounty-count data-next-expiry="<%= nextBountyExpiry??'' %>"><%= bountyCount %></span>)</span></a></nav>
<% const actorReady=state.health>=alpha.combat.minimumHealth&&state.spirit>=alpha.combat.spiritCost; %>
<section class="panel bounty-list" id="rival-list" aria-label="Attack rivals">
<% if (!opponents.length) { %><p class="compact-help">No rivals in your level range. <a href="/game/quests" class="text-link">Return to quests</a></p><% } %>
<% for (const opponent of opponents) {
 const targetReady=opponent.health>=community.combat.defenderMinimumHealth;
 const reason=!targetReady?'Opponent defeated — 0 Health. They must recover before another attack.':!actorReady?'Each attack requires at least '+alpha.combat.minimumHealth+' Health and '+alpha.combat.spiritCost+' Stamina.':null;
%><article class="bounty-row bounty-row--rival"><div class="bounty-target"><h3><a class="player-link" href="/game/players/<%= opponent.id %>"><%= opponent.name %></a></h3><span>Level <%= opponent.level %> <%= opponent.className %></span></div><form method="post" action="/game/battle/attack"><%- include('partials/command-fields') %><input type="hidden" name="targetCharacterId" value="<%= opponent.id %>"><button class="button button-gold" type="submit" aria-label="Attack <%= opponent.name %>" data-attack-ready="<%= targetReady?'true':'false' %>"<% if(reason) { %> disabled title="<%= reason %>"<% } %>>Attack</button></form></article><% } %>
</section>
<nav class="rival-list-controls" aria-label="Rival list controls">
<% if (nextOpponentCursor) { %><a class="button button-outline" href="/game/battle?after=<%= encodeURIComponent(nextOpponentCursor) %>">More rivals</a><% } %>
<a href="/game/battle?rotation=<%= typeof rivalRefresh==='undefined'?'':rivalRefresh %>#rival-list" class="refresh-rivals text-link">Refresh rivals ›</a>
<a class="champions-battle-link text-link" href="/game/champions">♛ Hall of Champions ›</a>
</nav>
<details class="panel bounty-records"><summary>Recent battles</summary>
<%- include('partials/history') %>
</details>

<% if(developmentBotsEnabled) { %><details class="battle-rules"><summary>About temporary rivals</summary><p class="compact-help bot-disclosure">Temporary rivals are passive computer-controlled opponents: they never initiate attacks against players. With the development recruitment flag enabled, they can accept invitations. Different rivals do not share a daily reward limit. Rewards taper when you defeat the same rival repeatedly. Gold depends on what the rival carries, and experience on the challenge. Every attack still uses normal Stamina and Health. They have at most 10 army members, recover Health naturally, and use level-appropriate equipment. Their saved Land earns income; attacks never refill their purses. <%= developmentBotBountiesEnabled?'Player-funded bot bounties are enabled; bots never fund or claim contracts.':'Bot bounty targets are disabled by development configuration.' %></p></details><% } %>
