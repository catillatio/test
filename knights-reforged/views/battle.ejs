<section class="hero hero-battle compact-hero"><img class="hero-art" src="/assets/art/battle.png" alt="" width="256" height="455"><div class="hero-copy"><p class="eyebrow">WHERE BANNERS MEET</p><h2>Steel your nerves.<br>Take the field.</h2><p>Challenge another player's company. Victory brings gold; every challenge becomes part of both warriors' stories.</p></div></section>
<% const coolingDown = new Date(state.attackReadyAt).getTime() > new Date(state.serverTime).getTime(); const actorReady = state.health > 0 && state.energy >= rules.combat.energyCost && !coolingDown; %>
<div class="battle-overview"><span>Challenge cost <strong><%= rules.combat.energyCost %> energy</strong></span><span>Your attack <strong><%= state.attack %></strong></span><span>Your defense <strong><%= state.defense %></strong></span><a href="/game/battle" class="text-link">Refresh opponents <span aria-hidden="true">↻</span></a></div>
<% if (!actorReady) { %><div class="notice notice-info" role="status"><% if (state.health <= 0) { %>You are recovering from battle. Health returns automatically; refresh in a moment.<% } else if (state.energy < rules.combat.energyCost) { %>You need <%= rules.combat.energyCost %> energy for a challenge. One energy returns every <%= rules.energyRegenSeconds %> seconds.<% } else { %>Catch your breath. You can challenge another warrior once every <%= rules.combat.cooldownSeconds %> seconds. Refresh this page when you are ready.<% } %></div><% } %>
<section class="panel" aria-labelledby="opponents-title"><div class="section-heading"><div><p class="eyebrow">OTHER BANNERS IN THE REALM</p><h2 id="opponents-title">Choose your opponent</h2></div><span class="small-tag"><%= opponents.length %> <%= opponents.length === 1 ? 'warrior' : 'warriors' %></span></div>
  <% if (!opponents.length) { %><div class="empty-state"><span class="empty-symbol" aria-hidden="true">⚔</span><h3>A quiet field, for now.</h3><p>Invite another player to this realm. They can create an account on another device or in a separate browser profile, then appear here.</p><a class="button button-outline" href="/game/quests">Patrol while you wait</a></div><% } else { %><ul class="opponent-list"><% for (const opponent of opponents) { %><li class="opponent-row"><span class="opponent-emblem" aria-hidden="true"><%= opponent.name.charAt(0).toUpperCase() %></span><div class="opponent-identity"><h3><%= opponent.name %></h3><p>Level <%= opponent.level %> <span aria-hidden="true">·</span> <%= opponent.units %> militia <span aria-hidden="true">·</span> <%= opponent.health %> health</p></div><form method="post" action="/game/battle/attack"><%- include('partials/command-fields') %><input type="hidden" name="targetCharacterId" value="<%= opponent.id %>"><button class="button button-outline" type="submit" aria-label="Challenge <%= opponent.name %>"<% if (!actorReady || opponent.health <= 0) { %> disabled<% } %>><%= opponent.health > 0 ? 'Challenge' : 'Recovering' %> <span aria-hidden="true">⚔</span></button></form></li><% } %></ul><% } %>
</section>
<%- include('partials/history') %>
