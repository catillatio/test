<nav class="category-tabs" aria-label="Battle categories"><a href="/game/battle" aria-current="page">Attack Rivals</a><a href="/game/bounties"><span class="bounty-label">Bounty List (<span data-bounty-count data-next-expiry="<%= nextBountyExpiry??'' %>"><%= bountyCount %></span>)</span></a></nav>
<a class="champions-battle-link text-link" href="/game/champions">♛ Hall of Champions ›</a>
<p class="compact-help">Army <strong><%= state.army.participants %></strong> participating · Each attack costs <strong>1 Spirit</strong>. Vault savings stay protected.</p>
<% const actorReady=state.health>=alpha.combat.minimumHealth&&state.spirit>=alpha.combat.spiritCost; %>
<% if (!actorReady) { %><p class="notice notice-info">Recover Health or Spirit to attack again. Resources update automatically.</p><% } %>
<section class="panel rival-panel" id="rival-list"><h2 class="strip-title"><span>Warrior</span><span>Army</span><span>Attack</span></h2>
<% if (!opponents.length) { %><div class="empty-state"><p>No rivals in your level range yet. Invite another player to the realm, or quest while you wait.</p><a href="/game/quests" class="button button-outline">Return to quests</a></div><% } %>
<% for (const opponent of opponents) { %><article class="rival-row"><div><h3><a class="player-link" href="/game/players/<%= opponent.id %>"><%= opponent.name %></a></h3><span>Level <%= opponent.level %> <%= callingName(opponent.className) %></span><small><%= opponent.health %> / <%= opponent.maxHealth %> Health</small><% if(opponent.botTier) { %><small class="bot-label">Temporary rival · <%= opponent.botTier %></small><% } %><%- include('partials/bounty-placement',{target:opponent}) %></div><strong><%= opponent.armySize %></strong><form method="post" action="/game/battle/attack"><%- include('partials/command-fields') %><input type="hidden" name="targetCharacterId" value="<%= opponent.id %>"><button class="button button-gold" type="submit" aria-label="Attack <%= opponent.name %>" data-attack-ready="<%= opponent.health>=community.combat.defenderMinimumHealth?'true':'false' %>"<% if (!actorReady||opponent.health<community.combat.defenderMinimumHealth) { %> disabled<% } %>>Attack</button></form></article><% } %>
<% if (nextOpponentCursor) { %><a class="button button-outline" href="/game/battle?after=<%= encodeURIComponent(nextOpponentCursor) %>">More rivals</a><% } %>
</section><p class="compact-help">Victories can take carried gold. Vault savings are protected. Repeated battles earn reduced rewards. <a href="/game/battle">Refresh rivals ›</a></p>
<%- include('partials/history') %>

<% if(developmentBotsEnabled) { %><details class="battle-rules"><summary>About temporary rivals</summary><p class="compact-help bot-disclosure">Temporary rivals are passive computer-controlled opponents: they never initiate attacks. With the development recruitment flag enabled, they can accept invitations. Different rivals do not share a daily reward limit. Rewards taper when you defeat the same rival repeatedly. Gold depends on what the rival carries, and experience on the challenge. Every attack still uses normal Spirit and Health. They have at most 10 army members, recover Health naturally, and use level-appropriate equipment. Their saved Land earns income; attacks never refill their purses. <%= developmentBotBountiesEnabled?'Player-funded bot bounties are enabled; bots never fund or claim contracts.':'Bot bounty targets are disabled by development configuration.' %></p></details><% } %>
