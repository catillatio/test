<nav class="category-tabs" aria-label="Battle categories"><a href="/game/battle" aria-current="page">Attack Rivals</a><a href="/game/bounties">Bounty List</a></nav>
<p class="compact-help">Attack costs <strong>1 Spirit</strong>. You need at least <%= alpha.combat.minimumHealth %> Health; the defender needs positive Health. Victory depends on character strength, participating army and automatically selected equipment.</p>
<div class="battle-summary"><span>Your attack <strong><%= state.attack %></strong></span><span>Defense <strong><%= state.defense %></strong></span><span>Army <strong><%= state.army.participants %></strong></span></div>
<% const actorReady=state.health>=alpha.combat.minimumHealth&&state.spirit>=alpha.combat.spiritCost&&Date.parse(state.attackReadyAt)<=Date.parse(state.serverTime); %>
<% if (!actorReady) { %><p class="notice notice-info">Recover Health or Spirit, or wait for your short attack cooldown. Resources update automatically.</p><% } %>
<section class="panel rival-panel"><h2 class="strip-title"><span>Army</span><span>Army size</span><span>Attack</span></h2>
<% if (!opponents.length) { %><p>No rivals in your level range yet. Invite another player to the realm, or quest while you wait.</p><a href="/game/quests" class="button button-outline">Return to quests</a><% } %>
<% for (const opponent of opponents) { %><article class="rival-row"><div><h3><a class="player-link" href="/game/players/<%= opponent.id %>"><%= opponent.name %></a></h3><span>Level <%= opponent.level %> <%= opponent.className %></span><small><%= opponent.health %> / <%= opponent.maxHealth %> Health</small><% if(opponent.botTier) { %><small class="bot-label">Temporary rival · <%= opponent.botTier %></small><% } else if(state.level>=strategy.bounties.minimumLevel && opponent.level>=strategy.bounties.minimumLevel) { %><details class="bounty-placement"><summary>Place bounty</summary><form method="post" action="/game/bounties/place"><%- include('partials/command-fields') %><input type="hidden" name="targetCharacterId" value="<%= opponent.id %>"><label for="bounty-<%= opponent.id %>">Gold (plus 10% fee)</label><input id="bounty-<%= opponent.id %>" name="amount" type="number" inputmode="numeric" min="100" max="10000" value="100" required><button class="button button-outline" type="submit" aria-label="Place bounty on <%= opponent.name %>">Place</button></form></details><% } %></div><strong><%= opponent.armySize %></strong><form method="post" action="/game/battle/attack"><%- include('partials/command-fields') %><input type="hidden" name="targetCharacterId" value="<%= opponent.id %>"><button class="button button-gold" type="submit" aria-label="Attack <%= opponent.name %>" data-attack-ready="<%= opponent.health>=community.combat.defenderMinimumHealth?'true':'false' %>"<% if (!actorReady||opponent.health<community.combat.defenderMinimumHealth) { %> disabled<% } %>>Attack</button></form></article><% } %>
<% if (nextOpponentCursor) { %><a class="button button-outline" href="/game/battle?after=<%= encodeURIComponent(nextOpponentCursor) %>">More rivals</a><% } %>
</section><p class="compact-help">The first three encounters you initiate against one rival in 24 hours can award gold/XP. Further fights still use Spirit and cause damage, but award neither. <a href="/game/battle">Refresh rivals ›</a></p>
<%- include('partials/history') %>

<% if(developmentBotsEnabled) { %><p class="compact-help bot-disclosure">Temporary rivals are passive computer-controlled opponents: they never initiate attacks or join armies. At most six rewarded bot encounters per 24 hours and one per bot; later fights use Spirit and Health but award no gold or XP. Their Health refreshes every 10 minutes and development funding is limited. They cannot receive bounties.</p><% } %>
