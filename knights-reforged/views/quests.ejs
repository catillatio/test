<% if (actionResult?.kind==='quest'&&actionResult.data) { const result=actionResult.data; %>
<section class="panel quest-result" role="status"><h2><%= result.levelGained ? 'Congratulations!' : 'Quest complete!' %></h2><strong><%= result.questName %></strong><div class="summary-inline"><span>You gained <strong class="gold"><%= result.gold %> gold</strong> · <%= result.xp %> XP</span><span>You used <%= result.mana %> Mana</span></div><% if (result.loot) { %><p class="success">You looted: <%= result.loot %></p><% } %><% if (result.levelGained) { %><p class="success">Level <%= state.level %> reached! Your resources are restored.</p><% } %><% if (Array.isArray(result.milestones)&&result.milestones.length) { %><p class="gold">Milestone awarded · Spend your new skill points in your profile.</p><% } %><form method="post" action="/game/quests/<%= result.questId %>/run"><%- include('partials/command-fields') %><button class="button button-outline" type="submit" data-quest-run="<%= result.questId %>"<% if (!state.quests.find(q=>q.id===result.questId)?.ready) { %> disabled<% } %>>Do Again</button></form></section>
<% } %>
<p class="compact-help">Repeat quests to earn gold and XP. Required equipment stays in your inventory. Mana returns while you are away.</p>
<details class="region-picker"><summary>Regions · <%= questArea==='nearby'?'Nearby quests':questArea==='all'?'All regions':alpha.content.areas.find(area=>area.id===questArea)?.name %></summary><nav aria-label="Quest regions"><a href="/game/quests">Nearby</a><a href="/game/quests?area=all">All regions</a><% for (const area of alpha.content.areas) { %><a href="/game/quests?area=<%= area.id %>"><%= area.name %> · Lv <%= area.level %></a><% } %></nav></details>
<% for (const area of alpha.content.areas.filter(area=>questArea==='all'||questArea===area.id||(questArea==='nearby'&&area.level<=state.level+2))) { %><section class="quest-area"><h2 class="area-title"><%= area.name %></h2><p class="region-description"><%= area.description %></p>
<% for (const quest of state.quests.filter(q=>q.area===area.name)) { const unlocked=state.level>=quest.level; %>
<article class="quest-card<%= unlocked?'':' is-locked' %>" data-quest="<%= quest.id %>"><h3 class="strip-title"><%= quest.name %><span>Level <%= quest.level %></span></h3>
  <div class="quest-card-body"><div><strong class="gold">● <%= quest.goldMin %>–<%= quest.goldMax %></strong><span class="reward-line">+<%= quest.xp %> Experience</span><% if (quest.loot) { %><span class="reward-line gold">Chance of loot<%= quest.loot.firstGuaranteed&&!quest.completions?' · first discovery guaranteed':'' %></span><% } %><span class="muted">Required:</span><div class="quest-requirements"><span class="mana">● <%= quest.mana %> Mana</span>
  <% for (const [id,quantity] of Object.entries(quest.items)) { const item=alpha.items.find(i=>i.id===id); %><span class="<%= quest.missing[id]?'missing':'' %>"><%- include('partials/catalog-art',{entry:item,small:true}) %><%= item.name %> ×<%= quantity %></span><% } %>
  <% if (quest.army>1) { %><span class="<%= state.army.participants<quest.army?'missing':'' %>">Army <%= quest.army %></span><% } %><% if (quest.requiresLoot) { %><span><%= quest.requiresLootName??'Story discovery' %></span><% } %></div></div>
  <form method="post" action="/game/quests/<%= quest.id %>/run"><%- include('partials/command-fields') %><button class="button button-gold" type="submit" data-quest-run="<%= quest.id %>" aria-label="Do quest <%= quest.name %>"<% if (!quest.ready) { %> disabled<% } %>>Do It</button></form></div>
  <% if (!unlocked) { %><p class="quest-hint warning">Unlock at level <%= quest.level %>.</p><% } else if (Object.keys(quest.missing).length) { %><div class="quest-hint"><span class="missing">Missing equipment · <%= quest.missingCost %> gold</span><form method="post" action="/game/quests/<%= quest.id %>/equipment"><%- include('partials/command-fields') %><button type="submit" class="button button-outline" aria-label="Buy requirements for <%= quest.name %>"<% if (state.gold<quest.missingCost) { %> disabled<% } %>>Buy required</button></form></div><% } else if (quest.lockReason) { %><p class="quest-hint"><%= quest.lockReason %>.</p><% } %>
</article>
<% } %></section><% } %>
<p class="compact-help"><%= state.questsCompleted %> quests completed · <%= state.xpToNext %> XP to next level. <a href="/game/profile#skills">Improve your capacities ›</a></p>
