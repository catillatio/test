<% if(actionResult?.kind==='quest'&&actionResult.data) { const result=actionResult.data; %>
<%- include('partials/celebration',{reward:result,identity:actionResult.commandId}) %>
<section class="panel quest-result reward-celebration" role="status" data-celebration-id="<%= actionResult.commandId %>-quest"><h2>QUEST COMPLETED!</h2><strong><%= result.questName %></strong><div class="reward-treasures"><span class="gold"><strong data-reward-count="<%= result.gold %>" data-prefix="+">+<%= result.gold %></strong><small>gold earned</small></span><span><strong data-reward-count="<%= result.xp %>" data-prefix="+">+<%= result.xp %></strong><small>experience earned</small></span></div><p class="compact-help"><%= result.mana %> Mana used · Current Level <%= state.level %> · <%= state.xpToNext %> XP to your next level</p><progress class="reward-progress" value="<%= state.levelXp %>" max="<%= state.levelRequirement %>" aria-label="Level progress"></progress><% for(const drop of result.equipmentDrops??[]) { %><p class="success">Rare equipment discovered: <strong><%= drop.name %> ×<%= drop.quantity %></strong></p><% } %><% if(result.loot) { %><p class="success">You looted: <%= result.loot %></p><% } %><form method="post" action="/game/quests/<%= result.questId %>/run"><%- include('partials/command-fields') %><button class="button button-gold" type="submit" data-quest-run="<%= result.questId %>"<% if(!state.quests.find(q=>q.id===result.questId)?.ready) { %> disabled<% } %>>Do Again</button></form></section><% } %>
<% const regions=[{id:'all',name:'All Regions',level:0},...alpha.content.areas,{id:'nearby',name:'Nearby Quests',level:0}];const regionIndex=Math.max(0,regions.findIndex(region=>region.id===questArea)); %>
<nav class="region-navigation" aria-label="Region navigation">
<% if(regionIndex>0) { %><a class="region-step" href="/game/quests?area=<%= regions[regionIndex-1].id %>" aria-label="Previous region: <%= regions[regionIndex-1].name %>">‹</a><% } else { %><span class="region-step" aria-label="Previous region unavailable" aria-disabled="true">‹</span><% } %>
<details class="region-picker region-filter"><summary aria-label="Select quest region"><span class="region-selector-label">Region:</span><strong><%= regions[regionIndex].name %></strong><span class="region-position"><%= regionIndex+1 %> of <%= regions.length %></span><span class="region-chevron" aria-hidden="true">▾</span></summary><nav aria-label="Quest regions"><% for(const region of regions) { const locked=state.level<region.level; %><a href="/game/quests?area=<%= region.id %>"<% if(questArea===region.id) { %> aria-current="true"<% } %><% if(locked) { %> class="is-locked"<% } %>><%= region.name %><span><%= locked?'🔒 ':'' %><%= region.level?'Level '+region.level+(locked?' · Locked':''):region.id==='all'?'Every quest':'Near your level' %></span></a><% } %></nav></details>
<% if(regionIndex<regions.length-1) { %><a class="region-step" href="/game/quests?area=<%= regions[regionIndex+1].id %>" aria-label="Next region: <%= regions[regionIndex+1].name %>">›</a><% } else { %><span class="region-step" aria-label="Next region unavailable" aria-disabled="true">›</span><% } %>
</nav>
<% for (const area of alpha.content.areas.filter(area=>questArea==='all'||questArea===area.id||(questArea==='nearby'&&area.level<=state.level+2))) { %><section class="quest-area"><h2 class="area-title"><%= area.name %></h2><p class="region-description"><%= area.description %></p>
<% for (const quest of state.quests.filter(q=>q.area===area.name)) { const unlocked=state.level>=quest.level; %>
<article class="quest-card<%= unlocked?'':' is-locked' %>" id="quest-<%= quest.id %>" data-quest="<%= quest.id %>"><h3 class="strip-title"><%= quest.name %><span>Level <%= quest.level %></span></h3>
  <div class="quest-card-body"><div><strong class="gold">● <%= quest.goldMin %>–<%= quest.goldMax %></strong><span class="reward-line">+<%= quest.xp %> Experience</span><% if (quest.loot) { %><span class="reward-line gold">Chance of loot<%= quest.loot.firstGuaranteed&&!quest.completions?' · first discovery guaranteed':'' %></span><% } %><% if(typeof rareQuestPolicy!=='undefined'&&rareQuestPolicy?.quests[quest.id]) { %><span class="reward-line gold">Extremely rare equipment discovery possible</span><% } %><span class="muted">Required:</span><div class="quest-requirements"><span class="mana">● <%= quest.mana %> Mana</span>
  <% for (const [id,quantity] of Object.entries(quest.items)) { const item=alpha.items.find(i=>i.id===id); %><span class="<%= quest.missing[id]?'missing':'' %>"><%- include('partials/catalog-art',{entry:item,small:true}) %><%= item.name %> ×<%= quantity %></span><% } %>
  <% if (quest.army>1) { %><span class="<%= state.army.participants<quest.army?'missing':'' %>">Army <%= quest.army %></span><% } %><% if (quest.requiresLoot) { %><span><%= quest.requiresLootName??'Story discovery' %></span><% } %></div></div>
  <form method="<%= Object.keys(quest.missing).length?'get':'post' %>" action="/game/quests/<%= quest.id %>/<%= Object.keys(quest.missing).length?'requirements':'run' %>"><% if(!Object.keys(quest.missing).length) { %><%- include('partials/command-fields') %><% } %><button class="button button-gold" type="submit" <% if(Object.keys(quest.missing).length) { %>data-quest-requirements="<%= quest.id %>"<% } else { %>data-quest-run="<%= quest.id %>"<% } %> aria-label="Do quest <%= quest.name %>"<% if (!quest.ready&&!(unlocked&&Object.keys(quest.missing).length)) { %> disabled<% } %>>Do It</button></form></div>
  <% if (!unlocked) { %><p class="quest-hint warning">Unlock at level <%= quest.level %>.</p><% } else if (Object.keys(quest.missing).length) { %><div class="quest-hint"><span class="missing">Missing equipment · <%= quest.missingCost %> gold</span><form method="get" action="/game/quests/<%= quest.id %>/requirements"><button type="submit" class="button button-outline" aria-label="Buy requirements for <%= quest.name %>">Buy required</button></form></div><% } else if (quest.lockReason) { %><p class="quest-hint"><%= quest.lockReason %>.</p><% } %>
</article>
<% } %></section><% } %>
<p class="compact-help"><%= state.questsCompleted %> quests completed · <%= state.xpToNext %> XP to next level. <a href="/game/profile#skills">Improve your capacities ›</a></p>
