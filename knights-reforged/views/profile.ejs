<nav class="category-tabs profile-tabs" aria-label="Character sections"><% for(const tab of [{id:'player',name:'Player'},{id:'skills',name:'Skills ('+state.skillPoints+')'},{id:'battles',name:'Battles'}]) { %><a href="/game/profile?tab=<%= tab.id %>"<% if(profileTab===tab.id) { %> aria-current="page"<% } %>><%= tab.name %></a><% } %></nav>
<section class="profile-identity" aria-labelledby="profile-name"><img src="/assets/art/kingdoms-live/icon.png" width="48" height="48" alt=""><div><h2 id="profile-name"><%= state.name %></h2><p>Level <%= state.level %> <%= state.className %></p><span>Joined <time datetime="<%= state.accountCreatedAt %>"><%= new Date(state.accountCreatedAt).toLocaleDateString('en-GB',{timeZone:'UTC',day:'numeric',month:'short',year:'numeric'}) %></time> · <%= state.accountAgeDays %> days</span></div></section>
<div class="next-level-strip">Experience till next level: <strong><%= state.xpToNext.toLocaleString('en') %></strong></div>
<% if(profileTab==='player') { %>
<section class="panel profile-info" id="player"><h2 class="profile-section-heading">Stats</h2><dl class="profile-stat-grid"><div><dt>Kills</dt><dd><%= state.battleStats.kills %></dd></div><div><dt>Battles won</dt><dd><%= state.battleStats.wins %></dd></div><div><dt>Deaths</dt><dd><%= state.battleStats.deaths %></dd></div><div><dt>Battles lost</dt><dd><%= state.battleStats.losses %></dd></div><div><dt>Quests completed</dt><dd><%= state.questsCompleted %></dd></div><div><dt>Account age</dt><dd><%= state.accountAgeDays %> days</dd></div><div><dt>Attack power</dt><dd><%= state.attack.toLocaleString('en',{maximumFractionDigits:2}) %></dd></div><div><dt>Defense power</dt><dd><%= state.defense.toLocaleString('en',{maximumFractionDigits:2}) %></dd></div><div><dt>Experience</dt><dd><%= state.xp.toLocaleString('en') %></dd></div><div><dt>Army participating</dt><dd><%= state.army.participants %> / <%= state.army.capacity %></dd></div></dl><p class="field-hint">Kills count rivals reduced to zero Health; deaths count your own. Health recovers normally.</p>
<h2 class="profile-section-heading">Income</h2><dl class="profile-gold-flow"><div><dt>Gross hourly income</dt><dd class="gold"><%= state.economy.grossHourlyIncome.toLocaleString('en') %> / hr</dd></div><div><dt>Property upkeep</dt><dd>−<%= state.economy.propertyUpkeep.toLocaleString('en') %> / hr</dd></div><div><dt>Active equipment upkeep</dt><dd>−<%= state.economy.equipmentUpkeep.toLocaleString('en') %> / hr</dd></div><div><dt>Total upkeep</dt><dd>−<%= state.economy.totalUpkeep.toLocaleString('en') %> / hr</dd></div><div><dt>Net hourly income</dt><dd class="hourly-flow" data-flow="<%= state.economy.netHourlyIncome>0?'positive':state.economy.netHourlyIncome<0?'negative':'neutral' %>"><%= state.economy.netHourlyIncome>0?'+':'' %><%= state.economy.netHourlyIncome.toLocaleString('en') %> / hr</dd></div></dl><p class="field-hint">Hourly rates exclude one-time rewards and transactions. <a href="/game/land">Land payment countdowns ›</a></p>
<% if(state.maintenance.paused) { %><p class="field-hint warning">Equipment upkeep is suspended; its <%= state.economy.scheduledEquipmentUpkeep %> gold/hr is not being charged. <a href="/game/armory">Manage funding ›</a></p><% } %></section>
<section class="panel profile-inventory"><h2 class="strip-title">Army and Equipment</h2><p class="compact-help"><%= state.units %> militia · <%= state.army.allies %> allies · <%= state.army.participants %> participating members. <a href="/game/army">My army ›</a></p>
<% for(const category of [{id:'weapon',name:'Weapons'},{id:'armor',name:'Armor'},{id:'spell',name:'Spells'}]) { const owned=state.inventory.filter(item=>item.category===category.id&&item.quantity>0); %><h3 class="profile-section-heading"><%= category.name %> <span><%= owned.reduce((n,item)=>n+item.quantity,0) %> owned</span></h3><div class="profile-inventory-grid" aria-label="Owned <%= category.name %>"><% for(const item of owned) { %><a class="inventory-figure" href="/game/armory?category=<%= category.id %>" aria-label="<%= item.name %>, owned <%= item.quantity %>"><%- include('partials/catalog-art',{entry:item,small:false}) %><strong>×<%= item.quantity %></strong><span><%= item.name %></span></a><% } %><% if(!owned.length) { %><p class="compact-help">None owned. <a href="/game/armory?category=<%= category.id %>">Visit Armory ›</a></p><% } %></div><% } %>
<details class="profile-loadouts"><summary>Automatic attacking and defending loadouts</summary><div class="loadout-grid"><% for(const group of [{name:'Attacking',items:state.attackEquipment.selected},{name:'Defending',items:state.defenseEquipment.selected}]) { %><div><h3><%= group.name %></h3><ul class="plain-list"><% for(const item of group.items) { %><li><%= item.name %> ×<%= item.quantity %></li><% } %><% if(!group.items.length) { %><li>No usable equipment.</li><% } %></ul></div><% } %></div></details></section>
<details class="panel" id="discoveries"><summary>Discoveries and milestones</summary><ul class="plain-list"><% for(const loot of state.loot) { %><li class="gold"><%= loot.name %></li><% } %><% for(const award of state.awards.filter(a=>a.points>0)) { %><li><%= award.id.replaceAll('-',' ') %> · <%= award.points %> points</li><% } %></ul></details>
<% } else if(profileTab==='skills') { %>
<section class="panel" id="skills"><h2 class="strip-title">Spend skill points</h2><p>You have <strong class="gold"><%= state.skillPoints %></strong> remaining skill points.</p>
<% for(const skill of [{id:'mana',name:'Max Mana',value:state.maxMana,cost:1,delta:1,limit:alpha.resources.maxMana,help:'Higher maximum Mana lets you complete more quests.'},{id:'health',name:'Max Health',value:state.maxHealth,cost:1,delta:10,limit:alpha.resources.maxHealth,help:'Higher maximum Health lets you stay in fights longer.'},{id:'spirit',name:'Max Spirit',value:state.maxSpirit,cost:2,delta:1,limit:alpha.resources.maxSpirit,help:'Higher maximum Spirit lets you attack more rivals.'},{id:'attack',name:'Attack',value:state.training.attack,cost:alpha.combatSkills.pointsPerRating,delta:1,limit:alpha.combatSkills.maxRating,help:'Each rating adds 1% to your army attack power, up to 25%.'},{id:'defense',name:'Defense',value:state.training.defense,cost:alpha.combatSkills.pointsPerRating,delta:1,limit:alpha.combatSkills.maxRating,help:'Each rating adds 1% to your army defense power, up to 25%.'}]) { %><div class="skill-row"><div><h3><%= skill.name %> — <strong><%= skill.value %></strong></h3><span>+<%= skill.delta %> for <%= skill.cost %> point<%= skill.cost===1?'':'s' %></span><small><%= skill.help %></small></div><form method="post" action="/game/profile/skills"><%- include('partials/command-fields') %><input type="hidden" name="resource" value="<%= skill.id %>"><button class="button button-gold" type="submit" aria-label="Increase <%= skill.id==='mana'?'Mana':skill.id==='health'?'Health':skill.id==='spirit'?'Spirit':skill.name %>"<% if(state.skillPoints<skill.cost||skill.value+skill.delta>skill.limit) { %> disabled<% } %>>Increase</button></form></div><% } %>
<p class="compact-help">Attack: <%= state.training.untrainedAttack %> → <%= state.attack %> (+<%= state.training.attackBonusPercent %>% training, <%= state.calling.attackPercent %>% Calling). Defense: <%= state.training.untrainedDefense %> → <%= state.defense %> (+<%= state.training.defenseBonusPercent %>% training, <%= state.calling.defensePercent %>% Calling). </p><p class="compact-help">Existing allocations stay unchanged. Resource upgrades add only their gained capacity to the current resource. One level grants one point; milestones can grant more.</p></section>
<% } else { %><section class="panel"><h2 class="profile-section-heading">Battle record</h2><p class="compact-help"><%= state.battleStats.wins %> won · <%= state.battleStats.losses %> lost · <%= state.battleStats.kills %> kills · <%= state.battleStats.deaths %> deaths. Only you and each opponent can open the saved report.</p></section><%- include('partials/history') %><% } %>
<%- include('partials/calling') %>
