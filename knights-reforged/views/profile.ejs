<% const character=publicCharacter??state;const ownsProfile=character.id===state.id;const profileBase=ownsProfile?'/game/profile':'/game/players/'+character.id;const record=typeof competitiveProfile!=='undefined'?competitiveProfile:null;const profileKills=record?.kills??character.battleStats.kills;const profileDeaths=record?.deaths??character.battleStats.deaths; %>
<nav class="category-tabs profile-tabs" aria-label="Character sections"><% for(const tab of [{id:'player',name:'Player'},...(ownsProfile?[{id:'skills',name:'Skills ('+character.skillPoints+')'}]:[]),{id:'comments',name:'Comments'},{id:'battles',name:'Battles'}]) { %><a href="<%= profileBase %>?tab=<%= tab.id %>"<% if(profileTab===tab.id) { %> aria-current="page"<% } %>><%= tab.name %></a><% } %></nav>
<section class="profile-identity" aria-labelledby="profile-name"><img src="/assets/art/remaster-ui/crest.svg?v=phase48-mockup2" width="48" height="48" alt=""><div><h2 id="profile-name"><%= character.name %></h2><p>Level <%= character.level %> <%= callingName(character.className) %></p><% if(ownsProfile) { %><div class="profile-collection-actions"><a class="button button-outline" href="/game/achievements">♛ Achievements</a><a class="button button-outline" href="/game/tutorial">Tutorial</a></div><% } %>
<% if(!ownsProfile&&character.temporaryRival) { %><span>Temporary computer-controlled rival</span><% } %></div></section>
<% if(!ownsProfile) { %><%- include('partials/profile-actions',{character}) %><% } %>
<% if(profileTab!=='player') { %><div class="next-level-strip">Experience till next level: <strong><%= character.xpToNext.toLocaleString('en') %></strong></div><% } %>
<% if(profileTab==='comments') { %>
<section class="panel"><h2 class="profile-section-heading">Profile Comments</h2><% if(!character.temporaryRival) { %><%- include('partials/message-form',{channel:'comment',profileId:character.id}) %><% } else { %><p class="compact-help">Temporary rivals do not post or receive social messages.</p><% } %></section>
<%- include('partials/activity-feed',{pageBase:profileBase+'?tab=comments'}) %>
<% } else if(profileTab==='player'||(!ownsProfile&&profileTab==='skills')) { %>

<section class="panel profile-info" id="player">
<section class="classic-profile-section" data-profile-stats aria-labelledby="profile-stats-title"><h2 class="profile-section-heading" id="profile-stats-title">Stats</h2>
<dl class="classic-profile-stats"><div><dt>Kills</dt><dd><%= BigInt(profileKills).toLocaleString('en') %></dd></div><div><dt>Battles Won</dt><dd><%= character.battleStats.wins.toLocaleString('en') %></dd></div><div><dt>Deaths</dt><dd><%= BigInt(profileDeaths).toLocaleString('en') %></dd></div><div><dt>Battles Lost</dt><dd><%= character.battleStats.losses.toLocaleString('en') %></dd></div><div><dt>Quests</dt><dd><%= character.questsCompleted.toLocaleString('en') %></dd></div><div><dt>Initiated for</dt><dd><%= character.accountAgeDays.toLocaleString('en') %> days</dd></div></dl></section>
<section class="classic-profile-section" data-profile-income aria-labelledby="profile-income-title"><h2 class="profile-section-heading" id="profile-income-title">Income</h2>
<dl class="classic-profile-income"><div><dt>Total Income</dt><dd class="gold"><%= character.economy.grossHourlyIncome.toLocaleString('en') %> / hr</dd></div><div><dt>Upkeep</dt><dd class="upkeep-cost"><%= character.economy.totalUpkeep.toLocaleString('en') %> / hr</dd></div><div><dt>Net Income</dt><dd class="hourly-flow" data-flow="<%= character.economy.netHourlyIncome>0?'positive':character.economy.netHourlyIncome<0?'negative':'neutral' %>"><%= character.economy.netHourlyIncome.toLocaleString('en') %> / hr</dd></div></dl></section>
</section>
<section class="panel profile-inventory" aria-label="Equipment">
<% for(const category of [{id:'weapon',name:'Weapons'},{id:'armor',name:'Armor'},{id:'spell',name:'Spells'}]) { const owned=character.inventory.filter(item=>item.category===category.id&&item.quantity>0); %><h2 class="profile-section-heading"><%= category.name %> <span><%= owned.reduce((n,item)=>n+item.quantity,0) %> owned</span></h2><div class="profile-inventory-grid" aria-label="Owned <%= category.name %>"><% for(const item of owned) { %><%- include('partials/equipment-preview',{item,category}) %><% } %><% if(!owned.length) { %><p class="compact-help">None owned. <a href="/game/armory?category=<%= category.id %>">Visit Armory ›</a></p><% } %></div><% } %>
<% if(ownsProfile) { %><details class="profile-loadouts"><summary>Automatic attacking and defending loadouts</summary><div class="loadout-grid"><% for(const group of [{name:'Attacking',items:character.attackEquipment.selected},{name:'Defending',items:character.defenseEquipment.selected}]) { %><div><h3><%= group.name %></h3><ul class="plain-list"><% for(const item of group.items) { %><li><%= item.name %> ×<%= item.quantity %></li><% } %><% if(!group.items.length) { %><li>No usable equipment.</li><% } %></ul></div><% } %></div></details><% } %></section>
<%- include('partials/profile-land',{ownsProfile}) %>
<% if(ownsProfile) { %><details class="panel" id="discoveries"><summary>Discoveries and milestones</summary><ul class="plain-list"><% for(const drop of character.equipmentDiscoveries??[]) { %><li><strong><%= drop.name %> ×<%= drop.quantity %></strong> · Quest discovery <time datetime="<%= drop.createdAt %>"><%= drop.createdAt.slice(0,10) %></time></li><% } %><% for(const loot of character.loot) { %><li class="gold"><%= loot.name %></li><% } %><% for(const award of character.awards.filter(a=>a.points>0)) { %><li><%= award.id.replaceAll('-',' ') %> · <%= award.points %> points</li><% } %></ul></details><% } %>
<% } else if(profileTab==='skills') { %>
<section class="panel" id="skills"><h2 class="strip-title">Spend skill points</h2><p>You have <strong class="gold"><%= character.skillPoints %></strong> remaining skill points.</p>
<% for(const skill of [{id:'mana',name:'Max Mana',value:character.maxMana,cost:1,delta:1,limit:alpha.resources.maxMana,help:'Higher maximum Mana lets you complete more quests.'},{id:'health',name:'Max Health',value:character.maxHealth,cost:1,delta:10,limit:alpha.resources.maxHealth,help:'Higher maximum Health lets you stay in fights longer.'},{id:'spirit',name:'Max Stamina',value:character.maxSpirit,cost:2,delta:1,limit:alpha.resources.maxSpirit,help:'Higher maximum Stamina lets you attack more rivals.'},{id:'attack',name:'Attack',value:character.training.attack,cost:alpha.combatSkills.pointsPerRating,delta:1,limit:alpha.combatSkills.maxRating,help:'Each rating adds 1% to your army attack power, up to 25%.'},{id:'defense',name:'Defense',value:character.training.defense,cost:alpha.combatSkills.pointsPerRating,delta:1,limit:alpha.combatSkills.maxRating,help:'Each rating adds 1% to your army defense power, up to 25%.'}]) { %><div class="skill-row"><div><h3><%= skill.name %> — <strong><%= skill.value %></strong></h3><span>+<%= skill.delta %> for <%= skill.cost %> point<%= skill.cost===1?'':'s' %></span><small><%= skill.help %></small></div><form method="post" action="/game/profile/skills"><%- include('partials/command-fields') %><input type="hidden" name="resource" value="<%= skill.id %>"><button class="button button-gold" type="submit" aria-label="Increase <%= skill.id==='mana'?'Mana':skill.id==='health'?'Health':skill.id==='spirit'?'Stamina':skill.name %>"<% if(character.skillPoints<skill.cost||skill.value+skill.delta>skill.limit) { %> disabled<% } %>>Increase</button></form></div><% } %>
<p class="compact-help">Training adds +<%= character.training.attackBonusPercent %>% attack and +<%= character.training.defenseBonusPercent %>% defense. Calling modifiers: <%= character.calling.attackPercent %>% attack, <%= character.calling.defensePercent %>% defense.</p><p class="compact-help">Existing allocations stay unchanged. Resource upgrades add only their gained capacity to the current resource. One level grants one point; milestones can grant more.</p></section>
<% } else { %><% if(!ownsProfile) { %><%- include('partials/rivalry',{character}) %><% } %><%- include('partials/tales',{character,profileBase}) %><% } %>
<% if(ownsProfile) { %><%- include('partials/account') %><% } else { %><p class="compact-help"><%= callingName(character.className) %>: <%= character.calling.description %></p><% } %>
