<nav class="category-tabs profile-tabs" aria-label="Character sections"><a href="#info">Info</a><a href="#skills">Skills (<%= state.skillPoints %>)</a><a href="#discoveries">Loot</a><a href="#account">Account</a></nav>
<section class="profile-identity" aria-labelledby="profile-name"><img src="/assets/art/kingdoms-live/icon.png" width="56" height="56" alt=""><div><h2 id="profile-name"><%= state.name %></h2><p>Level <%= state.level %> <%= state.className %></p><span>Army <%= state.army.participants %> · Attack <%= state.attack %> · Defense <%= state.defense %></span></div></section>
<section class="panel profile-info" id="info"><div class="next-level-strip">Exp to Next Level: <strong><%= state.xpToNext.toLocaleString('en') %></strong></div>
<h2 class="profile-section-heading">Stats</h2><dl class="profile-stat-grid"><div><dt>Quests completed</dt><dd><%= state.questsCompleted %></dd></div><div><dt>Battles won</dt><dd><%= state.battleStats.wins %></dd></div><div><dt>Experience</dt><dd><%= state.xp.toLocaleString('en') %></dd></div><div><dt>Battles lost</dt><dd><%= state.battleStats.losses %></dd></div><div><dt>Army participating</dt><dd><%= state.army.participants %> / <%= state.army.capacity %></dd></div><div><dt>Equipment owned</dt><dd><%= state.inventory.reduce((n,item)=>n+item.quantity,0) %></dd></div></dl>
<h2 class="profile-section-heading">Gold Flow</h2><dl class="profile-gold-flow"><div><dt>Income</dt><dd class="gold"><%= state.economy.grossHourlyIncome.toLocaleString('en') %> / hr</dd></div><div><dt>Property upkeep</dt><dd>−<%= state.economy.propertyUpkeep.toLocaleString('en') %> / hr</dd></div><div><dt>Equipment upkeep</dt><dd>−<%= state.economy.equipmentUpkeep.toLocaleString('en') %> / hr</dd></div><div><dt>Net Income</dt><dd class="hourly-flow" data-flow="<%= state.economy.netHourlyIncome>0?'positive':state.economy.netHourlyIncome<0?'negative':'neutral' %>"><%= state.economy.netHourlyIncome>0?'+':'' %><%= state.economy.netHourlyIncome.toLocaleString('en') %> / hr</dd></div></dl>
<% if (state.maintenance.paused) { %><p class="field-hint warning">Upkeep gear is suspended; its <%= state.maintenance.hourlyRate %> gold/hr is not being charged. <a href="/game/armory">Manage funding ›</a></p><% } %>
</section>
<section class="panel"><h2 class="strip-title">Army and Equipment</h2><p><%= state.units %> militia · <%= state.army.allies %> player allies · <%= state.army.total %> available members</p><div class="loadout-grid"><% for (const group of [{name:'Attacking',items:state.attackEquipment.selected},{name:'Defending',items:state.defenseEquipment.selected}]) { %><div><h3><%= group.name %></h3><ul class="plain-list"><% for (const item of group.items) { %><li><%= item.name %> ×<%= item.quantity %></li><% } %><% if (!group.items.length) { %><li>No usable equipment.</li><% } %></ul></div><% } %></div><p class="compact-help"><a href="/game/armory">Manage equipment ›</a> · <a href="/game/army">My army ›</a> · <a href="/game/land">My kingdom ›</a></p></section>
<section class="panel" id="skills"><h2 class="strip-title">Spend skill points</h2><p>You have <strong class="gold"><%= state.skillPoints %></strong> remaining points.</p>
<% for (const skill of [{id:'mana',name:'Mana',max:state.maxMana,cost:1,delta:1,limit:alpha.resources.maxMana,help:'Higher maximum Mana lets you complete more quests.'},{id:'health',name:'Health',max:state.maxHealth,cost:1,delta:10,limit:alpha.resources.maxHealth,help:'Higher maximum Health lets you stay in fights longer.'},{id:'spirit',name:'Spirit',max:state.maxSpirit,cost:2,delta:1,limit:alpha.resources.maxSpirit,help:'Higher maximum Spirit lets you challenge more rivals.'}]) { %><div class="skill-row"><div><h3>Max <%= skill.name %> <strong><%= skill.max %></strong></h3><span>+<%= skill.delta %> for <%= skill.cost %> point<%= skill.cost===1?'':'s' %></span><small><%= skill.help %></small></div><form method="post" action="/game/profile/skills"><%- include('partials/command-fields') %><input type="hidden" name="resource" value="<%= skill.id %>"><button class="button button-gold" type="submit" aria-label="Increase <%= skill.name %>"<% if (state.skillPoints<skill.cost||skill.max+skill.delta>skill.limit) { %> disabled<% } %>>Increase</button></form></div><% } %>
<p class="compact-help">Capacity upgrades add only the gained capacity to your current resource. A level grants one point; milestones can grant more.</p></section>
<section class="panel" id="discoveries"><h2 class="strip-title">Loot and milestones</h2><ul class="plain-list"><% for (const loot of state.loot) { %><li class="gold"><%= loot.name %></li><% } %><% for (const award of state.awards.filter(a=>a.points>0)) { %><li><%= award.id.replaceAll('-',' ') %> · <%= award.points %> point<%= award.points===1?'':'s' %></li><% } %><% if (!state.loot.length&&!state.awards.some(a=>a.points>0)) { %><li>Complete quests, gain levels and win a rival battle to earn your first milestones.</li><% } %></ul></section>
<section class="panel" id="account"><h2 class="strip-title">Account and Calling</h2><p>Signed in as <strong><%= accountName %></strong>. Your calling is an identity; skills and equipment determine combat strength.</p><form method="post" action="/game/profile/calling" class="inline-form"><%- include('partials/command-fields') %><label for="calling-choice">Calling</label><select id="calling-choice" name="className"><% for (const name of ['Freeblade','Warden','Spellward']) { %><option<% if (state.className===name) { %> selected<% } %>><%= name %></option><% } %></select><button class="button button-outline" type="submit">Choose calling</button></form>
<form method="post" action="/logout" class="profile-logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="button button-outline" type="submit">Sign out</button></form></section>
