<section class="panel profile-banner"><h2><%= state.name %></h2><p>Level <%= state.level %> <%= state.className %></p><strong><%= state.xpToNext %> XP to next level</strong><p class="field-hint">Lifetime experience <%= state.xp %> · Quests completed <%= state.questsCompleted %></p></section>
<nav class="category-tabs" aria-label="Character sections"><a href="#skills">Skills (<%= state.skillPoints %>)</a><a href="#discoveries">Discoveries</a><a href="#calling">Calling</a></nav>
<section class="panel" id="skills"><h2 class="strip-title">Spend skill points</h2><p>You have <strong class="gold"><%= state.skillPoints %></strong> remaining points. A level grants one point; milestones can grant more.</p>
<% for (const skill of [{id:'mana',name:'Mana',max:state.maxMana,cost:1,delta:1,limit:alpha.resources.maxMana},{id:'health',name:'Health',max:state.maxHealth,cost:1,delta:10,limit:alpha.resources.maxHealth},{id:'spirit',name:'Spirit',max:state.maxSpirit,cost:2,delta:1,limit:alpha.resources.maxSpirit}]) { %><div class="skill-row"><div><h3>Max <%= skill.name %> <strong><%= skill.max %></strong></h3><span>+<%= skill.delta %> for <%= skill.cost %> point<%= skill.cost===1?'':'s' %></span></div><form method="post" action="/game/profile/skills"><%- include('partials/command-fields') %><input type="hidden" name="resource" value="<%= skill.id %>"><button class="button button-gold" type="submit" aria-label="Increase <%= skill.name %>"<% if (state.skillPoints<skill.cost||skill.max+skill.delta>skill.limit) { %> disabled<% } %>>Increase</button></form></div><% } %>
<p class="compact-help">Mana completes quests. Health keeps you in fights. Spirit attacks rivals. Capacity upgrades add only the gained capacity to your current resource.</p></section>
<section class="panel" id="discoveries"><h2 class="strip-title">Loot and milestones</h2><ul class="plain-list"><% for (const loot of state.loot) { %><li class="gold"><%= loot.name %></li><% } %><% for (const award of state.awards.filter(a=>a.points>0)) { %><li><%= award.id.replaceAll('-',' ') %> · <%= award.points %> point<%= award.points===1?'':'s' %></li><% } %><% if (!state.loot.length&&!state.awards.some(a=>a.points>0)) { %><li>Complete quests, gain levels and win a rival battle to earn your first milestones.</li><% } %></ul></section>
<section class="panel" id="calling"><h2 class="strip-title">Your calling</h2><p>Choose your place in the realm. Callings are identities during alpha; skills and equipment determine combat strength.</p><form method="post" action="/game/profile/calling" class="inline-form"><%- include('partials/command-fields') %><label for="calling-choice">Calling</label><select id="calling-choice" name="className"><% for (const name of ['Freeblade','Warden','Spellward']) { %><option<% if (state.className===name) { %> selected<% } %>><%= name %></option><% } %></select><button class="button button-outline" type="submit">Choose calling</button></form></section>
