<% const victory=battle.winnerId===state.id;const modern=typeof battle.spiritSpent==='number'&&Array.isArray(battle.attackEquipment); %>
<section class="panel battle-result"><h2 class="<%= victory?'success':'warning' %>"><%= victory?'Victory!':'Defeat' %></h2><p><strong><%= battle.winnerName %></strong> won the battle and took <strong class="gold"><%= battle.loot %> gold</strong>.</p><p><%= battle.attackerName %> took <strong><%= battle.attackerDamage %> damage</strong> while dealing <strong><%= battle.defenderDamage %></strong> to <%= battle.defenderName %>.</p><% if (modern) { %><p><%= battle.spiritSpent %> Spirit spent · <%= battle.attackerXp %> attacker XP<%= battle.rewarded?'':' · Repeat encounter: no gold or XP' %></p><% if (battle.levelGained) { %><p class="success">Attacker reached level <%= battle.attackerLevelAfter %>. Resources were restored after combat.</p><% } %><% } %><time datetime="<%= battle.createdAt %>"><%= new Date(battle.createdAt).toLocaleString('en-GB',{timeZone:'UTC'}) %> UTC</time></section>
<div class="report-grid"><% for (const side of ['attacker','defender']) { const attacking=side==='attacker';const equipment=attacking?battle.attackEquipment:battle.defenseEquipment; %><section class="panel"><h2 class="strip-title"><%= attacking?'Attacker':'Defender' %> · <%= battle[side+'Name'] %></h2><dl class="flow-grid"><div><dt>Resolved power</dt><dd><%= modern?(battle[attacking?'attackPower':'defensePower']/100).toFixed(1):battle[attacking?'attackPower':'defensePower'] %></dd></div><div><dt>Health after</dt><dd><%= battle[side+'HealthAfter'] %> / <%= battle[side+'MaxHealth']??100 %></dd></div><% if (modern) { %><div><dt>Army participating</dt><dd><%= battle[side+'Army'] %></dd></div><% } %></dl><% if (equipment) { %><ul class="plain-list"><% for (const item of equipment) { %><li><%= item.name %> ×<%= item.quantity %></li><% } %><% if (!equipment.length) { %><li>No equipment contributed.</li><% } %></ul><% } %></section><% } %></div>
<div class="report-actions"><a href="/game/battle" class="button button-gold">Return to rivals</a><a href="/game/home" class="button button-outline">Home</a></div><p class="compact-help">This saved result uses <%= battle.rulesetId??'recreation-0.1' %>. Your current resources appear above.</p>
