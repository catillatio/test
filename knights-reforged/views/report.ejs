<% const victory=battle.winnerId===state.id;const viewerAttacking=battle.attackerId===state.id;const modern=typeof battle.spiritSpent==='number'&&Array.isArray(battle.attackEquipment);const received=viewerAttacking?battle.attackerDamage:battle.defenderDamage;const dealt=viewerAttacking?battle.defenderDamage:battle.attackerDamage;const xp=viewerAttacking?(battle.attackerXp??null):modern?0:null; %>
<section class="panel battle-result"><h2 class="<%= victory?'success':'warning' %>"><%= victory?'Victory!':'Defeat' %></h2><p>You <%= victory?'won':'lost' %> the battle against <a class="player-link" href="/game/players/<%= viewerAttacking?battle.defenderId:battle.attackerId %>"><%= viewerAttacking?battle.defenderName:battle.attackerName %></a>.</p><dl class="report-outcome"><div><dt>Damage dealt</dt><dd><%= dealt??'Not recorded' %></dd></div><div><dt>Damage received</dt><dd><%= received??'Not recorded' %></dd></div><div><dt><%= battle.pvpRulesetId?(viewerAttacking?'Gold stolen':'Gold stolen from you'):'Gold '+(victory?'gained':'lost') %></dt><dd class="gold"><%= typeof battle.loot==='number'?(victory?'+':battle.loot?'-':'')+battle.loot.toLocaleString('en'):'Not recorded' %></dd></div><div><dt>XP gained</dt><dd><%= xp===null?'Not recorded':'+'+xp %></dd></div></dl><% if(modern) { %><p class="compact-help"><%= viewerAttacking?battle.spiritSpent+' Spirit spent':'Defending costs no Spirit' %><%= battle.rewarded?'':battle.pvpRulesetId?(battle.temporaryRival?' · Gold/full-XP budget reached; victory XP +1':' · Repeat victory: reduced XP'):' · Repeat encounter: no gold or XP' %></p><% if(battle.levelGained) { %><p class="success">Attacker reached level <%= battle.attackerLevelAfter %>. Resources were restored after combat.</p><% } %><% } %><time datetime="<%= battle.createdAt %>"><%= new Date(battle.createdAt).toLocaleString('en-GB',{timeZone:'UTC'}) %> UTC</time></section>
<% if(battle.lootDetails) { %><p class="compact-help loot-detail">Victory <%= battle.lootDetails.victory %> in this pair's fixed 24-hour sequence · <%= battle.lootDetails.multiplier %>% loot<%= battle.lootDetails.multiplier<100?' (reduced for repeated victories)':'' %>. Base: <%= battle.lootDetails.base.toLocaleString('en') %> gold.<% if(battle.temporaryRival) { %> Temporary-rival loot is additionally capped at 50 gold, once per rival and six rewarded encounters per rolling day. Bounty escrow does not refill that allowance.<% } %></p><% } %>
<%- include('partials/attack-again') %>
<% if(battle.bountyClaim) { %><section class="panel bounty-reward"><h2 class="success">Bounty claimed!</h2><p><%= viewerAttacking?'You received':battle.attackerName+' received' %> <strong class="gold"><%= battle.bountyClaim.reward.toLocaleString('en') %> bounty gold</strong> from escrow. This is separate from the ordinary battle loot above.</p></section><% } %><% if(battle.temporaryRival) { %><p class="compact-help bot-label">Temporary computer-controlled rival · passive development encounter</p><% } %>
<div class="report-grid"><% for(const side of ['attacker','defender']) { const attacking=side==='attacker';const equipment=attacking?battle.attackEquipment:battle.defenseEquipment;const own=(attacking&&viewerAttacking)||(!attacking&&!viewerAttacking);const training=battle[side+'Training']; %><section class="panel report-army"><h2 class="strip-title"><%= own?'Your army':'Their army' %> · <%= attacking?'Attacker':'Defender' %></h2><h3><a class="player-link" href="/game/players/<%= battle[side+'Id'] %>"><%= battle[side+'Name'] %></a></h3><dl class="flow-grid"><div><dt>Resolved power</dt><dd><%= modern?(battle[attacking?'attackPower':'defensePower']/100).toFixed(1):battle[attacking?'attackPower':'defensePower'] %></dd></div><div><dt>Health after</dt><dd><%= battle[side+'HealthAfter']??'Not recorded' %> / <%= battle[side+'MaxHealth']??100 %></dd></div><% if(typeof battle[side+'Army']==='number') { %><div><dt>Army participating</dt><dd><%= battle[side+'Army'] %></dd></div><% } %><% if(training) { %><div><dt><%= attacking?'Attack':'Defense' %> training</dt><dd>+<%= attacking?training.attackBonusPercent:training.defenseBonusPercent %>%</dd></div><% } %></dl>
<% const calling=battle[side+'Calling'];if(calling) { %><p class="compact-help"><%= calling.name %> · <%= attacking?calling.attackPercent:calling.defensePercent %>% Calling power modifier</p><% } %>
<% if(Array.isArray(equipment)) { %><div class="report-equipment" aria-label="<%= attacking?'Attacker':'Defender' %> equipment used"><% for(const used of equipment) { const art=alpha.items.find(item=>item.id===used.itemId); %><figure class="inventory-figure"><% if(art) { %><%- include('partials/catalog-art',{entry:art,small:false}) %><% } else { %><span class="unknown-equipment" aria-hidden="true">⚔</span><% } %><strong>×<%= used.quantity %></strong><figcaption><%= used.name %></figcaption><span><%= used.category??'Equipment' %></span></figure><% } %></div><% if(!equipment.length) { %><p class="compact-help">No equipment contributed.</p><% } %><% } else { %><p class="compact-help">Equipment quantities were not recorded in this historical battle.</p><% } %></section><% } %></div>
<div class="report-actions"><a href="/game/battle" class="button button-gold">Return to rivals</a><a href="/game/profile?tab=battles" class="button button-outline">My battles</a></div><p class="compact-help">This private report preserves the equipment quantities and training used in this battle. Current resources appear above.</p>
