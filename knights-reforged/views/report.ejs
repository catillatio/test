<% const victory = battle.winnerId === state.id; %>
<section class="panel battle-result"><p class="eyebrow">THE FIELD FALLS QUIET</p><span class="result-seal<%= victory ? ' result-seal-win' : '' %>" aria-hidden="true">⚔</span><h2><%= victory ? 'Victory is yours.' : 'A battle lost. A story unfinished.' %></h2><p><strong><%= battle.winnerName %></strong> won the challenge and claimed <strong class="gold"><%= battle.loot %> gold</strong>.</p><span class="small-tag"><time datetime="<%= battle.createdAt %>"><%= new Date(battle.createdAt).toLocaleString('en-GB', {timeZone: 'UTC'}) %> UTC</time></span></section>
<div class="content-grid report-grid"><section class="panel combatant-card"><p class="eyebrow">ATTACKER</p><h2><%= battle.attackerName %></h2><dl class="summary-list"><div><dt>Attack strength + roll</dt><dd><%= battle.attackPower - battle.attackRoll %> + <%= battle.attackRoll %></dd></div><div><dt>Total attack power</dt><dd><%= battle.attackPower %></dd></div><div><dt>Damage received</dt><dd><%= battle.attackerDamage %></dd></div><div><dt>Health after battle</dt><dd><%= battle.attackerHealthAfter %> / <%= rules.maxHealth %></dd></div><div><dt>Experience gained</dt><dd>+<%= battle.attackerXp %> XP</dd></div></dl></section><section class="panel combatant-card"><p class="eyebrow">DEFENDER</p><h2><%= battle.defenderName %></h2><dl class="summary-list"><div><dt>Defense strength + roll</dt><dd><%= battle.defensePower - battle.defenseRoll %> + <%= battle.defenseRoll %></dd></div><div><dt>Total defense power</dt><dd><%= battle.defensePower %></dd></div><div><dt>Damage received</dt><dd><%= battle.defenderDamage %></dd></div><div><dt>Health after battle</dt><dd><%= battle.defenderHealthAfter %> / <%= rules.maxHealth %></dd></div></dl></section></div>
<div class="report-actions"><a class="button button-gold" href="/game/battle">Return to the field</a><a class="button button-outline" href="/game/home">Back to your company</a></div><p class="field-hint centered">This report records the completed battle. Your current resources are shown above.</p>
