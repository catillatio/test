<section class="panel purchase-receipt" aria-labelledby="purchase-title">
<h2 class="strip-title" id="purchase-title">Purchase complete</h2>
<div class="receipt-item"><%- include('partials/catalog-art',{entry:purchase.entry,small:false}) %><div><h3><%= purchase.entry.name %></h3><p>Purchased <strong><%= actionResult.data.quantity %></strong> for <strong class="gold"><%= Number(actionResult.data.goldSpent).toLocaleString('en') %> gold</strong>.</p><p>Owned: <strong><%= purchase.owned %></strong> · Gold remaining: <strong class="gold" data-wallet-gold><%= state.gold.toLocaleString('en') %></strong></p></div></div>
<% if(purchase.type==='land') { %><p class="field-hint">Income joins your existing hourly cycle. New purchases earn only their actual time; the first partial period is prorated. Next payment: <time datetime="<%= state.land.nextPaymentAt %>"><%= state.land.nextPaymentAt %></time>.</p><% } else { %><p class="field-hint">Your army automatically chooses equipment. Active upkeep: <%= state.economy.equipmentUpkeep %> gold/hour.</p><% } %>
<details class="buy-more" id="buy-more"><summary class="button button-gold">Buy More</summary>
<form method="post" action="<%= purchase.type==='land'?'/game/land/buy':'/game/armory/buy' %>" class="buy-more-form"><%- include('partials/command-fields') %><input type="hidden" name="<%= purchase.type==='land'?'propertyId':'itemId' %>" value="<%= purchase.entry.id %>">
<%- include('partials/quantity-control',{purchaseType:purchase.type,entry:purchase.entry,available:purchase.available,controlId:'more-'+purchase.entry.id,costSteps:purchase.costSteps}) %>
<button class="button button-gold" type="submit" aria-label="Buy more <%= purchase.entry.name %>"<% if(!purchase.available) { %> disabled<% } %>>Confirm purchase</button><% if(!purchase.available) { %><p class="field-hint">Not enough gold, an ownership limit, or a level requirement prevents another purchase.</p><% } %></form></details>
<p><a href="<%= purchase.type==='land'?'/game/home':'/game/armory?category='+purchase.entry.category %>">Continue your adventure ›</a></p>
<p class="field-hint">This receipt is saved. Refreshing it never repeats the purchase. Each confirmation uses a fresh action ID.</p>
</section>