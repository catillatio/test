<section class="panel purchase-receipt" aria-labelledby="purchase-title">
<h2 class="strip-title" id="purchase-title">Purchase complete</h2>
<% if(purchase.entry) { %>
<div class="receipt-item"><%- include('partials/catalog-art',{entry:purchase.entry,small:false}) %><div><h3><%= purchase.receiptName??purchase.entry.name %></h3><% if(Number.isSafeInteger(actionResult.data?.quantity)&&Number.isSafeInteger(actionResult.data?.goldSpent)) { %><p>Purchased <strong><%= actionResult.data.quantity %></strong> for <strong class="gold"><%= Number(actionResult.data.goldSpent).toLocaleString('en') %> gold</strong>.</p><% } else { %><p><%= actionResult.message??'Your purchase was recorded.' %></p><% } %><p>Owned: <strong><%= purchase.owned %></strong> · Gold remaining: <strong class="gold" data-wallet-gold><%= state.gold.toLocaleString('en') %></strong></p></div></div>
<% if(purchase.type==='land') { %><p class="field-hint">Income joins your existing hourly cycle. New purchases earn only their actual time; the first partial period is prorated. Next payment: <time datetime="<%= state.land.nextPaymentAt %>"><%= new Date(state.land.nextPaymentAt).toLocaleTimeString('en-GB',{timeZone:'UTC',hour:'2-digit',minute:'2-digit'}) %> UTC</time>.</p><% } else { %><p class="field-hint">Your army automatically chooses equipment. Active upkeep: <%= state.economy.equipmentUpkeep %> gold/hour.</p><% } %>
<p><a class="button button-outline return-to-market" href="<%= purchase.type==='land'?'/game/land':'/game/armory?category='+purchase.entry.category %>"><%= purchase.type==='land'?'Return to Land':'Return to Armory' %></a></p>
<section class="buy-more" id="buy-more" aria-labelledby="more-title"><h3 class="strip-title" id="more-title">Continue buying</h3>
<form method="post" action="<%= purchase.type==='land'?'/game/land/buy':'/game/armory/buy' %>" class="buy-more-form"><%- include('partials/command-fields') %><input type="hidden" name="<%= purchase.type==='land'?'propertyId':'itemId' %>" value="<%= purchase.entry.id %>">
<%- include('partials/quantity-control',{purchaseType:purchase.type,entry:purchase.entry,available:purchase.available,controlId:'more-'+purchase.entry.id,costSteps:purchase.costSteps,incomeSteps:purchase.type==='land'?purchase.entry.projectedBuyNetSteps:[]}) %>
<button class="button button-gold" type="submit" aria-label="Buy more <%= purchase.entry.name %>"<% if(!purchase.available) { %> disabled<% } %>>Buy More</button><% if(!purchase.available) { %><p class="field-hint">Not enough gold, an ownership limit, or a level requirement prevents another purchase.</p><% } %></form></section>
<% } else { %><p><%= actionResult.message??'This historical purchase is recorded. Item details are unavailable.' %></p><p class="compact-help">Its saved transaction is unchanged. This item cannot be purchased again from this receipt.</p><a class="button button-outline return-to-market" href="<%= purchase.type==='land'?'/game/land':'/game/armory?category='+purchase.category %>">Return to <%= purchase.type==='land'?'Land':'Armory' %></a><% } %>
<p class="field-hint">This receipt is saved. Refreshing it never repeats the purchase.</p>
</section>
