<p class="compact-help">Your unread personal events. An event is marked read when its heading is viewed. Pending army invitations stay separate.</p>
<div class="activity-feed"><% for(const event of unread.entries) { %><article class="activity-entry" data-notification-event="<%= JSON.stringify({id:event.id,kind:event.kind}) %>"><h3><%= ({attack:'Your kingdom was attacked',comment:'A message on your profile',army_accepted:'An army invitation was accepted',bounty_placed:'A bounty was placed on your kingdom',bounty_claimed:'A bounty was claimed'})[event.kind] %></h3><% if(event.message_body) { %><p class="message-text"><%= event.message_body %></p><% } %><% if(event.battle_result) { const b=event.battle_result; %><p><%= b.attackerName??'A rival' %> attacked. <strong><%= b.outcome==='attacker_win'?'Defeat':'Victory' %></strong> · <span class="gold"><%= b.loot??0 %> Gold</span> · <%= b.defenderDamage??0 %> damage received.</p><% } %><% if(event.event_detail&&event.kind==='army_accepted') { %><p><%= event.event_detail.actorName %> accepted your invitation. This acknowledgment leaves pending invitations unchanged.</p><% } else if(event.event_detail) { %><p><%= event.event_detail.targetName %> · <span class="gold"><%= Number(event.event_detail.amount).toLocaleString('en') %> bounty Gold</span> · escrow is separate from ordinary battle loot.</p><% } %><a class="text-link" href="<%= event.kind==='attack'?'/game/battles/'+event.id:event.kind==='comment'?'/game/profile?tab=comments#activity-'+event.id:event.kind==='army_accepted'?'/game/army?tab=dashboard':'/game/bounties' %>">View event ›</a><time class="relative-time" datetime="<%= event.created_at %>"><%= relativeTime(event.created_at,state.serverTime) %></time></article><% } %><% if(!unread.entries.length) { %><p class="feed-empty">You are caught up. New events will appear here.</p><% } %><% if(unread.nextCursor) { %><a class="button button-outline" href="/game/notifications?after=<%= encodeURIComponent(unread.nextCursor) %>">More unread events</a><% } %></div><%- include('partials/notification-read') %>
