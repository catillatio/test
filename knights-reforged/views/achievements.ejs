<header class="milestone-intro"><p>Deeds worthy of remembrance. Each milestone carries a single Gold reward.</p><a class="text-link" href="/game/profile">Back to Profile ›</a></header>
<p class="achievement-count"><strong class="gold"><%= experience.achievements.filter(a=>a.earnedAt).length %></strong> of <%= experience.achievements.length %> milestones earned<% if(experience.rewardSummary) { %><span><strong class="gold"><%= experience.rewardSummary.paid.toLocaleString('en') %> Gold</strong> awarded once</span><% } %></p>
<% for(const category of ['Character','Combat','Quests','Economy','Social']) { const entries=experience.achievements.filter(a=>a.category===category); %>
<section class="achievement-category" aria-label="<%= category %> milestones"><h2 class="profile-section-heading"><%= category %><small><%= entries.filter(a=>a.earnedAt).length %> / <%= entries.length %></small></h2>
<% for(const definition of entries) { %><article class="achievement-row <%= definition.earnedAt?'is-earned':'is-locked' %>" data-achievement="<%= definition.id %>">
<%- include('partials/achievement-emblem',{definition}) %><div><div class="milestone-title"><span class="milestone-rank">Rank <%= ['I','II','III','IV','V','VI'][definition.rank-1] %></span><span class="milestone-state"><%= definition.earnedAt?'Earned':'To be earned' %></span></div>
<h3><%= definition.name %></h3><p><%= definition.description %></p>
<div class="milestone-reward"><strong class="gold">+<%= (definition.rewardGold??0).toLocaleString('en') %> Gold</strong><span><%= definition.rewardPaid?'Paid once':definition.earnedAt?'Reward awaits activation':'One-time reward' %></span></div>
<% if(definition.earnedAt) { %><span class="achievement-earned">Earned <time datetime="<%= definition.earnedAt %>"><%= new Date(definition.earnedAt).toLocaleDateString('en-GB',{timeZone:'UTC'}) %></time></span><% } else { %><progress value="<%= definition.progress %>" max="<%= definition.threshold %>" aria-label="<%= definition.name %> progress"></progress><small><%= definition.progress.toLocaleString('en') %> / <%= definition.threshold.toLocaleString('en') %></small><% } %>
</div></article><% } %></section><% } %>
