<p class="compact-help">Deeds worthy of remembrance. These emblems are cosmetic: no gold, XP or power is created. <a href="/game/profile">Back to Profile ›</a></p>
<p class="achievement-count"><strong class="gold"><%= experience.achievements.filter(a=>a.earnedAt).length %></strong> / <%= experience.achievements.length %> achievements earned</p>
<% for(const category of ['Character','Combat','Quests','Economy','Social']) { %><section class="achievement-category"><h2 class="profile-section-heading"><%= category %></h2><% for(const definition of experience.achievements.filter(a=>a.category===category)) { %><article class="achievement-row <%= definition.earnedAt?'is-earned':'is-locked' %>" data-achievement="<%= definition.id %>"><%- include('partials/achievement-emblem',{definition}) %><div><h3><%= definition.name %></h3><p><%= definition.description %></p><% if(definition.earnedAt) { %><span class="achievement-earned">Earned <time datetime="<%= definition.earnedAt %>"><%= new Date(definition.earnedAt).toLocaleDateString('en-GB',{timeZone:'UTC'}) %></time></span><% if(definition.evidence==='retroactive') { %><small>Verified from saved progress; award recorded on this date.</small><% } %><% } else { %><progress value="<%= definition.progress %>" max="<%= definition.threshold %>" aria-label="<%= definition.name %> progress"></progress><small><%= definition.progress.toLocaleString('en') %> / <%= definition.threshold.toLocaleString('en') %></small><% } %></div></article><% } %></section><% } %>
